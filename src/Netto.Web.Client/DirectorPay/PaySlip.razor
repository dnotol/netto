@using Netto.Core.DirectorPay
@using Netto.Web.Client.Steps
@inject IStringLocalizer<PaySlip> L

@* Director pay's detail view: the pay through what is paid out to the net, beside what lowers the
   tax base to the taxable income, on one shared scale; the pay month by month as the company pays
   it, with the key formula's withholding as a step behind it; the balance the assessment leaves,
   with the article it follows behind it; and where the next €1,000 would go. Every figure is
   GrossToNet's; GrossToNetView only places them. *@
<div class="pay-slip">
    <div class="funnel">
        @foreach (var track in _view.Tracks)
        {
            <article class="funnel__track">
                <h3 class="funnel__track-title">@L[PaySlipText.Track(track.Key)]</h3>
                <p class="funnel__track-hint">@L[PaySlipText.TrackHint(track.Key)]</p>
                <ol class="funnel__rows">
                    @foreach (var row in track.Rows)
                    {
                        <li class="funnel-row funnel-row--@Modifier(row.Kind)">
                            <span class="funnel-row__label">@L[PaySlipText.Row(row.Key)]</span>
                            <span class="funnel-row__amount">@Amount(row)</span>
                            <span class="funnel-row__track" aria-hidden="true">
                                <span class="funnel-row__bar" style="@BarStyle(row)"></span>
                            </span>
                            @if (row.Kind == RowKind.TaxBaseOnly)
                            {
                                <span class="funnel-row__note">@L["TaxBaseOnlyNote"]</span>
                            }
                        </li>
                    }
                </ol>
            </article>
        }
    </div>

    <section class="statement" aria-labelledby="statement-title">
        <h3 id="statement-title" class="slip-section__title">@L["StatementTitle"]</h3>
        <p class="slip-section__hint">@L["StatementHint"]</p>
        <div class="statement__scroll">
            <table class="statement__table">
                <thead>
                    <tr>
                        <th scope="col" class="statement__month">@L["ColumnMonth"]</th>
                        <th scope="col">@L["ColumnGross"]</th>
                        @if (_view.Statement.CompanyPaysContributions)
                        {
                            <th scope="col">@L["ColumnCompanyPaid"]</th>
                        }
                        <th scope="col">@L["ColumnTaxablePay"]</th>
                        <th scope="col">@L["ColumnWithholding"]</th>
                        <th scope="col">@L["ColumnNetPaid"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var month in _view.Statement.Months)
                    {
                        <tr class="@(month.UnmodelledRules ? "statement__row--unmodelled" : null)">
                            <th scope="row" class="statement__month">
                                @Formats.Month(Pay.IncomeYear, month.Month)
                                @if (month.UnmodelledRules)
                                {
                                    <abbr class="statement__mark" title="@L["UnmodelledMark", Formats.Day(_view.Statement.UnmodelledRulesFrom)]">*</abbr>
                                }
                            </th>
                            <td data-label="@L["ColumnGross"]">@Formats.Euros(month.GrossPay)</td>
                            @if (_view.Statement.CompanyPaysContributions)
                            {
                                <td data-label="@L["ColumnCompanyPaid"]">@Formats.Euros(month.ContributionsPaidByCompany)</td>
                            }
                            <td data-label="@L["ColumnTaxablePay"]">@Formats.Euros(month.TaxablePay)</td>
                            <td data-label="@L["ColumnWithholding"]">@Formats.Deduction(month.Withholding)</td>
                            <td data-label="@L["ColumnNetPaid"]" class="statement__net">@Formats.Euros(month.NetPaid)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_view.Statement.SomeUnmodelled)
        {
            <p class="statement__note">* @L["UnmodelledNote", Formats.Day(_view.Statement.UnmodelledRulesFrom)]</p>
        }
        <StepDetails Details="_withholding" />
    </section>

    <section class="balance" aria-labelledby="balance-title">
        <h3 id="balance-title" class="slip-section__title">@L["BalanceTitle"]</h3>
        <p class="slip-section__hint">@L["BalanceHint"]</p>
        <dl class="balance__lines">
            <div class="balance__line">
                <dt>@L["FinalTax"]</dt>
                <dd>@Formats.Euros(_view.Balance.FinalTax)</dd>
            </div>
            <div class="balance__line">
                <dt>@L[PaySlipText.Withheld(_view.Balance.WithheldGiven)]</dt>
                <dd>@Formats.Deduction(_view.Balance.Withheld)</dd>
            </div>
            <div class="balance__line">
                <dt>@L["AdvancePayments"]</dt>
                <dd>@Formats.Deduction(_view.Balance.AdvancePayments)</dd>
            </div>
            <div class="balance__line balance__line--result">
                <dt>@L[PaySlipText.Balance(_view.Balance.Kind)]</dt>
                <dd>@Formats.Euros(_view.Balance.Amount)</dd>
            </div>
        </dl>
        <StepDetails Details="_balance" />
    </section>

    <section class="next" aria-labelledby="next-title">
        <h3 id="next-title" class="slip-section__title">@L["NextTitle"]</h3>
        <div class="next__bar" aria-hidden="true">
            @foreach (var part in _view.NextThousandBar)
            {
                <span class="next__segment next__segment--@part.Key" style="@SegmentStyle(part)"></span>
            }
        </div>
        <dl class="next__parts">
            @foreach (var part in _view.NextThousand)
            {
                <div class="next__part next__part--@part.Key">
                    <dt><span class="next__swatch" aria-hidden="true"></span>@L[PaySlipText.Row(part.Key)]</dt>
                    <dd>@Formats.Euros(part.Amount)<span class="next__share">@Formats.Share(part.Share)</span></dd>
                </div>
            }
        </dl>
        @if (_view.CompanyPaysContributions)
        {
            <p class="next__note">@L["NextCompanyPaysNote"]</p>
        }
    </section>
</div>

@code {
    // The engine's result rather than its view: a component's parameters are public types, and
    // GrossToNetView is internal.
    [Parameter, EditorRequired]
    public GrossToNetResult Pay { get; set; } = default!;

    private GrossToNetView _view = default!;
    private IReadOnlyList<StepDetail> _withholding = [];
    private IReadOnlyList<StepDetail> _balance = [];

    protected override void OnParametersSet()
    {
        _view = GrossToNetView.From(Pay);
        _withholding = [_view.WithholdingDetail];
        _balance = [_view.Balance.Detail];
    }

    private static string Modifier(RowKind kind) => kind switch
    {
        RowKind.Gross => "gross",
        RowKind.PaidOut => "paid-out",
        RowKind.Back => "back",
        RowKind.TaxBaseOnly => "tax-base-only",
        RowKind.TaxableIncome => "taxable-income",
        RowKind.NetInPocket => "net",
        _ => throw new ArgumentOutOfRangeException(nameof(kind), kind, null),
    };

    private static string Amount(FunnelRow row) => row.Kind switch
    {
        RowKind.Back => Formats.Addition(row.Amount),
        _ when row.IsDeduction => Formats.Deduction(row.Amount),
        _ => Formats.Euros(row.Amount),
    };

    // CSS wants a dot as decimal separator whatever the culture.
    private static string BarStyle(FunnelRow row) =>
        FormattableString.Invariant($"left: {row.BarStart:0.###}%; width: {row.BarEnd - row.BarStart:0.###}%");

    private static string SegmentStyle(NextThousandPart part) =>
        FormattableString.Invariant($"flex-basis: {part.Width * 100m:0.###}%");
}
