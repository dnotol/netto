@using Netto.Core.DirectorPay
@using Netto.Core.PersonalTax
@using Netto.Web.Client.River
@inject IStringLocalizer<MunicipalityField> L

@* The municipality picker, the surcharge rate beside it and the note under both. It only edits a
   MunicipalityChoice; the page that holds it recomputes on ChoiceChanged. *@
<div class="municipality-field">
    <div class="municipality-field__inputs">
        @* Strict off, so reopening the list after a pick shows every municipality again. *@
        <MudAutocomplete T="Municipality" Value="Choice.Municipality" ValueChanged="OnMunicipalityChanged"
                         SearchFunc="Search" ToStringFunc="@(municipality => municipality?.Name)"
                         Label="@L["MunicipalityLabel", Formats.Day(Choice.Rates.ResidenceDate)]" Variant="Variant.Outlined"
                         MaxItems="null" Strict="false" Clearable="true" ResetValueOnEmptyText="true">
            <ItemTemplate Context="municipality">
                <span class="municipality-option">
                    <span>@municipality.Name</span>
                    <span class="municipality-option__rate">@Formats.MunicipalRate(municipality.Rate.Value)</span>
                </span>
            </ItemTemplate>
            <NoItemsTemplate>
                <p class="municipality-none">@L["MunicipalityNoMatch"]</p>
            </NoItemsTemplate>
        </MudAutocomplete>
        @* No Min or Max: MudBlazor would clamp a rate out of range silently, and the engine's
           refusal, with its message, is what the user has to see. The rate steps by 0.1 from the arrow keys, with no
           margin, and takes each key at once, unlike the river's other fields; like them it has no spin buttons. *@
        <RiverNumericField T="decimal" Value="RatePercent" ValueChanged="OnRateChanged" Label="@L["RateLabel"]"
                           Step="0.1m" Format="0.0" Adornment="Adornment.End" AdornmentText="%"
                           Margin="Margin.None" DebounceInterval="0"
                           Error="Refused" Refusal="@GrossToNet.MunicipalRateOutOfRange" />
    </div>
    <p class="municipality-field__note">
        @L[Choice.Note.Key, Choice.Note.Args.ToArray<object>()]
        @if (Choice.IsOverridden)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="UseOfficialRate"
                       Class="municipality-field__official">@L["UseOfficialRate"]</MudButton>
        }
    </p>
</div>

@code {
    [Parameter, EditorRequired]
    public MunicipalityChoice Choice { get; set; } = default!;

    [Parameter]
    public EventCallback<MunicipalityChoice> ChoiceChanged { get; set; }

    // The engine refused the rate: the field shows as in error, carrying the card's message on why.
    [Parameter]
    public bool Refused { get; set; }

    private decimal RatePercent => Choice.Rate * 100m;

    // One decimal, as municipalities set their rates: what the field shows is what is computed.
    private Task OnRateChanged(decimal ratePercent) =>
        ChoiceChanged.InvokeAsync(Choice.Enter(Math.Round(ratePercent, 1, MidpointRounding.AwayFromZero) / 100m));

    private Task OnMunicipalityChanged(Municipality? municipality) => ChoiceChanged.InvokeAsync(Choice.Pick(municipality));

    private Task UseOfficialRate() => ChoiceChanged.InvokeAsync(Choice.UseOfficialRate());

    private Task<IEnumerable<Municipality>> Search(string? text, CancellationToken cancellationToken) =>
        Task.FromResult<IEnumerable<Municipality>>(Choice.Search(text));
}
