@implements IAsyncDisposable
@inject IStringLocalizer<TabHead> L
@inject IJSRuntime JS

@* The head every tab of the plan page opens on: an eyebrow with the planner's « In development » chip,
   the tab's title, the page's one h1, and a lede. The title takes the focus when the head is first
   drawn, which is when the viewer arrives at its tab, so a screen reader says where they are. On the
   page's first draw Blazor does the same (Routes, FocusOnNavigate), but not on a switch of tab: the tabs
   are one page, and FocusOnNavigate moves the focus only when the page changes. So a tab draws its head
   once, at its top, never inside a branch its own state can draw again, or the focus would leave what
   the viewer is on. The title is focused letting the browser scroll it into view, which keeps it below
   the sticky bar and its tabs (app.css's scroll-padding-top, --netto-under-bar), so it is never focused
   out of sight (WCAG 2.4.11); a link to a tab lands at the top, where the title already shows below the
   bar and nothing scrolls. Back and forward would have the browser restore the scroll the tab had,
   later than the focus and again as the river grows, carrying the page away from the title: while a tab
   is shown the plan's history entries keep no scroll of their own (plan-scroll.js), and leaving the plan
   page gives the browser its restoration back. *@
<header class="tab-head">
    <div class="tab-head__eyebrow-row">
        <p class="tab-head__eyebrow">@Eyebrow</p>
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">@L["InDevelopment"]</MudChip>
    </div>
    @* MudText draws no element the focus can be put on, so the h1 is drawn here, in its classes. *@
    <h1 class="mud-typography mud-typography-h2 tab-head__title" tabindex="-1" @ref="_title">@Title</h1>
    <p class="tab-head__lede">@Lede</p>
</header>

@code {
    // A line above the title saying what the tab is about.
    [Parameter, EditorRequired]
    public string Eyebrow { get; set; } = "";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    // What the tab holds, in a sentence or two.
    [Parameter, EditorRequired]
    public string Lede { get; set; } = "";

    private ElementReference _title;

    // Whether this head took the scroll restoration from the browser, to give it back as it goes.
    private bool _holdsScroll;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await JS.InvokeVoidAsync("nettoPlanScroll.hold");
        _holdsScroll = true;
        await _title.FocusAsync();
    }

    // Gone with its tab: to another tab, which holds the scroll again, or off the plan page, whose entry
    // the browser restores again.
    public async ValueTask DisposeAsync()
    {
        if (_holdsScroll)
            await JS.InvokeVoidAsync("nettoPlanScroll.release");
    }
}
