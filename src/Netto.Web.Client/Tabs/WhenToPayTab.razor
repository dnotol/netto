@using Netto.Web.Client.River
@inject IStringLocalizer<WhenToPayTab> L

@* The When to pay tab: when the plan's payments fall, a lens over the whole river, not a module in it, so
   a tab of its own beside it rather than a card in it, with no rate and no « Remove ». It reads the
   river's one run and the date (CalendarView over the engine's PaymentCalendar): first who pays what
   next, by which day, with one sentence per tax saying what its payments leave and what more cancels
   the surcharge, as its card says it (the Next panel); then the year on a timeline (CalendarTimeline),
   drawn from the same calendar; then the company's and the director's advance payments by each
   deadline as the plan holds them, the past ones marked, and at the first deadline still open what more
   cancels each surcharge; the pay each month, as the pay slip gives it; and after the year, what each
   assessment leaves. The timeline is a picture and the tables are its text equivalent. It applies
   nothing: the Optimisation tab is where a payment is applied. Its one input, what the fund bills, shows
   the engine's refusal beside its field. *@
<TabHead Eyebrow="@L["Eyebrow"]" Title="@L["Title"]" Lede="@L["Lede"]" />
<div class="calendar">
    @if (_view is null)
    {
        <p class="calendar__note">@L["Refused"]</p>
    }
    else
    {
        <section class="calendar__panel" aria-labelledby="calendar-next">
            <h2 id="calendar-next" class="calendar__heading">@L["NextHeading"]</h2>
            <p class="calendar__next">@NextLine</p>
            @if (_view.Company is { } company)
            {
                <p class="calendar__tax">@L[WhenToPayTabText.Company(company), Formats.Euros(company.Surcharge), Formats.Euros(company.More), Day(company.OpenDeadline), _view.IncomeYear]</p>
            }
            <p class="calendar__tax">@L[WhenToPayTabText.Director(_view.Director), Formats.Euros(_view.Director.Surcharge), Formats.Euros(_view.Director.More), Day(_view.Director.OpenDeadline), _view.IncomeYear]</p>
        </section>

        <CalendarTimeline Calendar="_view.Calendar" NextDate="_view.Next?.Date" />

        <h2 id="calendar-advance-payments" class="calendar__heading">@L["AdvancePayments"]</h2>
        @if (_view.Rows.Count == 0)
        {
            <p class="calendar__note">@L["NoRows", _view.IncomeYear]</p>
        }
        else
        {
            <table class="calendar__table" aria-labelledby="calendar-advance-payments">
                <thead>
                    <tr>
                        <th scope="col">@L["Deadline"]</th>
                        @if (_view.Company is not null)
                        {
                            <th scope="col">@L["TheCompany"]</th>
                        }
                        <th scope="col">@L["You"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _view.Rows)
                    {
                        <tr class="@(row.Past ? "calendar__row--past" : null)">
                            <th scope="row" class="calendar__date">
                                <span>@Formats.Day(row.Date)</span>
                                @if (row.Past)
                                {
                                    <span class="calendar__past">@L["Past"]</span>
                                }
                            </th>
                            @if (_view.Company is not null)
                            {
                                @Cell(row.CompanyPlanned, row.CompanyMore, "CompanyMore")
                            }
                            @Cell(row.DirectorPlanned, row.DirectorMore, "DirectorMore")
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h2 class="calendar__heading">@L["PayHeading"]</h2>
        <p class="calendar__line">@L["PayLine", Formats.Euros(_view.Pay.GrossPay), Formats.Euros(_view.Pay.Withholding), Formats.Euros(_view.Pay.NetPaid)]</p>
        @if (_view.Pay.Left is { } left)
        {
            <p class="calendar__note">@(left.First == left.Last ? L["PayLeftOne", Month(left.First), _view.IncomeYear] : L["PayLeft", Month(left.First), Month(left.Last), _view.IncomeYear])</p>
        }
        @if (_view.Pay.UnmodelledFrom is { } unmodelled)
        {
            <p class="calendar__note">@L["PayUnmodelled", Formats.Day(unmodelled)]</p>
        }
        @if (_view.Pay.WithheldGiven is { } given)
        {
            <p class="calendar__note">@L["PayWithheldGiven", Formats.Euros(given)]</p>
        }

        <h2 class="calendar__heading">@L["ContributionsHeading"]</h2>
        <p class="calendar__line">@L[_view.Contributions.PaidByCompany ? "ContributionsLine_Company" : "ContributionsLine", Formats.Euros(_view.Contributions.EachQuarter)]</p>
        @if (_view.QuartersLeft > 0)
        {
            <p class="calendar__note">@L["QuartersLeft", _view.QuartersLeft, _view.IncomeYear]</p>
        }
        <RiverField Label="@L["BilledLabel", _view.IncomeYear]" For="river-billed-contributions"
                    Origin="@(Inputs.BilledContributions.Value is null ? null : Inputs.BilledContributions.Origin)" Help="@L["BilledHint"]">
            <RiverNumericField T="decimal?" InputId="river-billed-contributions" Value="Inputs.BilledContributions.Value" ValueChanged="OnBilledChanged"
                               Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="400"
                               Error="@(_view.BilledRefused is not null)" Refusal="@_view.BilledRefused" />
        </RiverField>
        <RefusedMessage Error="@_view.BilledRefused" />
        @if (_view.Contributions.Regularisation is { } regularisation)
        {
            <p class="calendar__line">@L[WhenToPayTabText.Regularisation(regularisation), Formats.Euros(Math.Abs(regularisation))]</p>
        }

        <h2 class="calendar__heading">@L["AfterHeading"]</h2>
        @if (_view.CompanyBalance is { } companyBalance)
        {
            <p class="calendar__line">@L[WhenToPayTabText.CompanyBalance(companyBalance.Balance), companyBalance.TaxYear, Formats.Euros(Math.Abs(companyBalance.Balance))]</p>
        }
        <p class="calendar__line">@L[WhenToPayTabText.DirectorBalance(_view.DirectorBalance.Balance), _view.DirectorBalance.TaxYear, Formats.Euros(Math.Abs(_view.DirectorBalance.Balance))]</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // Today's date, which decides which deadlines are past.
    [Parameter]
    public DateOnly Date { get; set; }

    // The river with what the fund bills each quarter, the calendar's one input.
    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    private Task OnBilledChanged(decimal? billed) => InputsChanged.InvokeAsync(Inputs.WithBilledContributions(billed));

    private CalendarView? _view;

    protected override void OnParametersSet() => _view = CalendarView.From(Inputs, Run, Date);

    // The day of the next deadline still open with something to pay, and who pays what by it; or that
    // nothing is left to pay in advance.
    private string? NextLine => _view is null
        ? null
        : L[WhenToPayTabText.Next(_view.Next), Day(_view.Next?.Date), Formats.Euros(_view.Next?.Company ?? 0m), Formats.Euros(_view.Next?.Director ?? 0m), _view.IncomeYear].Value;

    private static string Day(DateOnly? date) => date is { } day ? Formats.Day(day) : "";

    private static string Month(DateOnly month) => Formats.Month(month.Year, month.Month);

    // What one payer pays by the deadline as the plan stands, and what more by it cancels its
    // surcharge; « nothing » when neither.
    private RenderFragment Cell(decimal planned, decimal more, string moreKey) =>
        @<td class="calendar__cell">
            @if (planned == 0m && more == 0m)
            {
                <span class="calendar__nothing">@L["Nothing"]</span>
            }
            @if (planned > 0m)
            {
                <span class="calendar__amount">@Formats.Euros(planned)</span>
            }
            @if (more > 0m)
            {
                <span class="calendar__more">@L[moreKey, Formats.Euros(more)]</span>
            }
        </td>;
}
