@using System.Globalization
@using Netto.Core.Rules
@using Netto.Core.Simulation
@using Netto.Web.Client.River
@inject IStringLocalizer<MapTab> L
@inject IStringLocalizer<BucketBar> BucketTexts
@inject IStringLocalizerFactory Localizers
@inject MapLinkFilter Filter

@* The Map tab: the plan's modules from above, as the river shows them, and the money between them, every
   line the links of the river's one run between the same two ends, whose amount is a figure its card
   draws or the sum of its card's lines between those two ends (MapView, MapLinks, MapBundle): the sum is
   the map's arithmetic of display, and no tax figure is computed here. The modules sit in fixed slots in
   the river's shape (MapLayout), Company year, the levers in the plan and the split down the middle, the
   director's stream left and the company's right, over the bar's five buckets; a lever out of the plan is
   not on it, and with the company skipped
   the map starts at Director pay, over which Company year stays, drawn dashed as the river draws its
   skipped card and said skipped in words, with no link, so that it can be chosen and its year entered
   again beside the map; the cards that only wait for it are left out. Each link is a line of its kind
   (MapLinkStyle: passed on, into a bucket, a tax base, a condition), its dash, width and ink set on the line
   itself, a line of money as thick as its amount beside the run's largest (MapLineWidths), with an
   arrowhead in the same ink, sized by the line, where it reaches a module or leaves the river, and none
   into a bucket, under which it runs on to the bucket's middle, the bucket being where its money stops:
   money passed on and money into a bucket are told apart by their ends, not by a colour. Each line is drawn
   over a halo of the map's ground so that a line crossing another leaves a gap each side of it. The links
   of one card between the same two ends and of one kind are one line (MapBundle), which says one amount and
   no words, on a stretch of its own or right beside it, where MapAmounts places it from every link of the
   run: the sum of the card's lines it holds, each a figure the card draws; a condition says in a word or two
   whether it holds, placed the same way, its sentence left to the neighbourhood. An amount hangs from its
   point of its line by its pixels, so it keeps to its line however large the map is drawn, and its ground
   hides the lines crossing it, square. A line to the pocket and its amount are gold, the one gold of the
   map, since that is what reaches the director.

   The rules are marks on the module they act on: each condition another module sets on it, but the
   office rule, which always holds, is a badge in its box saying which rule and whether it holds, and what
   its tax base gains is one badge with its amount (MapBadges), read before the filter, so hiding a kind of
   line hides no badge, and the box is a line taller for each (MapLayout). A rule lost is said in its
   words, an icon and an outline in the error colour, never the colour alone; the royalty lowering no pay has
   no effect. The badges are the button's content, so a screen reader hears them with the module's name.

   A lever that moves no money of its own in this plan, one added with nothing in it yet, is quiet
   (MapQuiet): no box, its name muted in a dashed row it shares with the quiet levers it follows down the
   chain, each name saying in its button, out of sight, that it holds nothing in this plan; the royalty that
   comes to nothing is quiet in its own place. The row is kept as tall as its names one per line on the
   narrowest map. The chain's line runs on under the row, from the box above to the box below, its amount
   said once, on the line above or under the row. A quiet name is a button like a box, so
   that choosing it opens its card beside the map, where its amounts are entered; once it moves money it
   has its box back, in its place.

   A module is a button: chosen, by a click or Enter or Space, it is marked (aria-pressed) and its own
   lines stay with their amounts where they were, while the others fade with no amount, the map showing no
   words, and its neighbourhood is beside the map (MapNeighbourhood), saying what each line carries, the
   drawing's equivalent for a screen reader, which hears the buttons and the neighbourhood and nothing of the
   drawing itself. Choosing it again lets it go. The choice is the page's (Chosen, ChosenChanged), so it
   stays from one tab to the next; the map takes no focus for it, the card it opens beside the map does
   (MapPanel). Nothing here is a live region: the bar's is the river's only announcement. While the engine
   refuses an amount the map draws no line and no amount, as the bar draws no figure, the module holding
   the refused field is marked, in words too, the refusal is said above the map, unless the card of the
   module chosen, beside it, holds the refused field and says it there, so that it is said once, and the
   neighbourhood of a module chosen says there is no figure.

   The map is as tall as the window leaves under the bar, and stays there while the column beside it
   holds two regions that scroll apart: the neighbourhood of the chosen module (MapNeighbourhoodView: what
   comes into it, what goes out, the rules it sets or is under, each line of money on its own with its
   amount and a bar, the other end of each a button that chooses that module), kept in sight whatever the
   length of the card under it, the card of that module (MapPanel, pinned open), whose
   edits go to the page's one river. Under the head is the filter of the kinds of link (MapFilter), the
   legend of the lines in one row, whose boxes the viewer ticks: a kind unticked is left out of the lines,
   their arrowheads and their amounts, and only of those: the neighbourhood is made from every link of the
   run, so the rules of a module are listed whether or not their lines are drawn. The kinds that are a tax
   base and a condition start unticked, hidden by default, since their badges say them on the modules
   they reach, and ticking them draws their lines. The filter shows the map without those links
   (MapLinkFilter.Showing) and leaves everything else where it is: the modules, the buckets, the route of
   every line left and its amount are the run's, and the choice of a module is the page's. The lines are an
   SVG stretched to the map's box (preserveAspectRatio="none"), kept to their width by vector-effect; what
   must keep its shape, the boxes, the amounts and the arrowheads, is HTML placed over it in percentages. *@
<TabHead Eyebrow="@L["Eyebrow"]" Title="@L["Title"]" Lede="@L["Lede"]" />

<div class="map-tab__filter">
    <MapFilter Counts="_counts" OnChanged="Refilter" />
</div>

<RefusedMessage Error="@(ChosenRefusal is null ? _view.Refusal : null)" />

<div class="map-tab">
    <div class="map-tab__map">
        <div class="map" style="--map-units: @Number(_view.Units)" role="group" aria-label="@L["MapLabel"]">
            <svg class="map__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                @foreach (var (bundle, faded) in _drawn)
                {
                    <polyline class="@HaloClass(faded)" points="@Points(bundle.Route.Drawn)" stroke-width="@MapLinkStyle.Halo(bundle.Route.Width)" />
                    <polyline class="@LineClass(faded)" points="@Points(bundle.Route.Drawn)" stroke-dasharray="@MapLinkStyle.Dash(bundle.Kind)"
                              stroke-width="@MapLinkStyle.Width(bundle.Route.Width)" data-link-kind="@bundle.Kind" style="stroke: @Ink(bundle)" />
                }
            </svg>
            @foreach (var (bundle, faded) in _drawn.Where(line => line.Bundle.Arrowhead))
            {
                <span class="@ArrowClass(bundle, faded)" style="left: @Percent(bundle.Route.End.X); top: @Percent(bundle.Route.End.Y); @ArrowSize(bundle) --map-arrow: @Ink(bundle)" aria-hidden="true"></span>
            }
            @foreach (var amount in _amounts)
            {
                <span class="@AmountClass(amount.Bundle)" data-link-kind="@amount.Bundle.Kind" style="@AmountStyle(amount)" aria-hidden="true">@amount.Text</span>
            }
            @foreach (var bucket in _view.Buckets)
            {
                <div class="map-bucket map-bucket--@bucket.End.Id" data-bucket="@bucket.End.Id" style="@Box(bucket.Slot)">@EndName(bucket.End)</div>
            }
            @foreach (var place in _view.Places())
            {
                if (place.Quiet)
                {
                    <div class="map-quiet" style="@Pill(place.Slot)">
                        @foreach (var node in place.Nodes)
                        {
                            @ModuleButton(node)
                        }
                    </div>
                }
                else
                {
                    @ModuleButton(place.Nodes[0])
                }
            }
        </div>
    </div>
    <div class="map-tab__side">
        <div class="map-tab__hood" @key="@(_chosen?.ToString() ?? "none")">
            <MapNeighbourhood Hood="_hood" OnChoose="ChooseAsync" />
        </div>
        <div class="map-tab__panel">
            <MapPanel Module="_chosen" ViewerChose="ViewerChose" Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Search="Search" Refused="ChosenRefusal" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    // The river with an edit made on the chosen module's card beside the map.
    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The split's search, which the split's card beside the map draws.
    [Parameter]
    public SplitSearchResult? Search { get; set; }

    // The engine's refusal a module's card holds, as the Plan page hands it to that card.
    [Parameter]
    public Func<RiverModule, Refusal?> RefusedBy { get; set; } = _ => null;

    // The module chosen on the map, the page's, so it stays from one tab to the next; none once it has
    // left the map.
    [Parameter]
    public RiverModule? Chosen { get; set; }

    [Parameter]
    public EventCallback<RiverModule?> ChosenChanged { get; set; }

    // Whether the module chosen is the viewer's choice (ChosenChanged), rather than one the page chose
    // itself, Company year on arriving or a lever just added: only the viewer's takes the focus to its card.
    [Parameter]
    public bool ViewerChose { get; set; }

    // The engine's refusal the chosen module's card holds, as the Plan page hands it to that card.
    private Refusal? ChosenRefusal => _chosen is { } module ? RefusedBy(module) : null;

    // The map of the run, and the same without the links of the kinds the viewer hid (MapLinkFilter): the
    // second is what is drawn, the first what the legend counts and the neighbourhood lists, and what every
    // line's amount is placed on (MapAmounts), once a run, so a tick or a choice moves none.
    private MapView _full = default!;
    private MapView _view = default!;
    private IReadOnlyDictionary<MapLinkKind, int> _counts = default!;
    private IReadOnlyList<MapAmount> _placed = [];
    private (RiverInputs Inputs, RiverRun Run)? _mapped;
    private RiverModule? _chosen;
    private MapNeighbourhoodView? _hood;
    private IReadOnlyList<(MapBundle Bundle, bool Faded)> _drawn = [];
    private IReadOnlyList<MapAmount> _amounts = [];
    private readonly Dictionary<MapText, IStringLocalizer> _texts = [];

    // What the tab draws, for the page's tests to read as they read Chosen (a render of the page writes no
    // HTML): the map without the links of the kinds hidden, its lines and the amounts on them.
    internal MapView ShownMap => _view;

    internal IReadOnlyList<(MapBundle Bundle, bool Faded)> DrawnLines => _drawn;

    internal IReadOnlyList<MapAmount> DrawnAmounts => _amounts;

    // The neighbourhood of the module chosen, which the column beside the map lists, none while none is.
    internal MapNeighbourhoodView? Neighbourhood => _hood;

    protected override void OnParametersSet()
    {
        // The map and its amounts are the run's: worked out again for another run, not for another choice.
        if (_mapped is not var (inputs, run) || !ReferenceEquals(inputs, Inputs) || !ReferenceEquals(run, Run))
        {
            _full = MapView.From(Inputs, Run);
            _counts = MapLinkFilter.Counts(_full);
            _placed = MapAmounts.Of(_full, Carries);
            _mapped = (Inputs, Run);
        }

        _chosen = _full.Choice(Chosen);
        Refilter();

        // Made from every link of the run, so the legend, which says which lines are drawn, changes nothing of
        // it: it is not made again at a tick.
        _hood = _chosen is { } chosen ? MapNeighbourhoodView.Of(_full, chosen, Carries, EndName) : null;
    }

    // The viewer ticked or unticked a kind: the lines and their amounts are the shown kinds' again, each
    // amount where it was placed.
    private void Refilter()
    {
        _view = Filter.Showing(_full);
        _drawn = _view.Drawn(_chosen);
        _amounts = _view.Amounts(_placed, _chosen);
    }

    // A module chosen again lets it go.
    private Task ChooseAsync(RiverModule module) => ChosenChanged.InvokeAsync(_chosen == module ? null : module);

    private static string LineClass(bool faded) => $"map-line{(faded ? " map-line--faded" : "")}";

    private static string ArrowClass(MapBundle bundle, bool faded) =>
        $"map-arrow map-arrow--{bundle.Route.Arrow.ToString().ToLowerInvariant()}{(faded ? " map-arrow--faded" : "")}";

    private static string HaloClass(bool faded) => $"map-halo{(faded ? " map-halo--faded" : "")}";

    // An arrowhead's size, its line's (MapLineWidths): half its base and its length, in pixels.
    private static string ArrowSize(MapBundle bundle) =>
        $"--map-arrow-half: {MapLinkStyle.Width(MapLineWidths.ArrowHalf(bundle.Route.Width))}px; --map-arrow-length: {MapLinkStyle.Width(MapLineWidths.ArrowLength(bundle.Route.Width))}px;";

    // A line's ink and its arrowhead's, its kind's (MapLinkStyle), or the gold of what reaches the pocket.
    private static string Ink(MapBundle bundle) => ToPocket(bundle) ? MapLinkStyle.PocketInk : MapLinkStyle.Ink(bundle.Kind);

    // What reaches the pocket is said in the gold of its line, a condition's word or two muted.
    private static string AmountClass(MapBundle bundle) =>
        $"map-amount{(ToPocket(bundle) ? " map-amount--pocket" : bundle.Kind == MapLinkKind.Condition ? " map-amount--state" : "")}";

    // Where an amount is drawn: at its point of its line, in percent of the map, as wide as MapAmounts
    // reckons it, its box moved from that point by its pixels (MapAmount.Left, Top).
    private static string AmountStyle(MapAmount amount) =>
        $"left: {Percent(amount.At.X)}; top: {Percent(amount.At.Y)}; width: {Pixels(amount.Width)}; transform: translate({Pixels(amount.Left)}, {Pixels(amount.Top)})";

    // A module's button: a box in its slot, or a name in its quiet row, which places it, saying its state in
    // a word: refused, skipped, or, out of sight, since its row's dashes show it, that a quiet lever holds
    // nothing in this plan. A box holds its badges under its title, a line each (MapLayout keeps them the
    // room), each its tone's icon, out of a screen reader's hearing, and its words, which are part of the
    // button's name.
    private RenderFragment ModuleButton(MapNode node) =>
        @<button type="button" class="@ModuleClass(node)" style="@(node.Quiet ? null : Box(node.Slot))" aria-pressed="@(_chosen == node.End.Module ? "true" : "false")"
                 data-module="@node.End.Id" @onclick="() => ChooseAsync(node.End.Module!.Value)">
            <span class="map-module__title">@L[MapTabText.Module(node.End.Module!.Value)]</span>
            @if (node.Refused)
            {
                <span class="map-module__state">@L["Refused"]</span>
            }
            @if (node.Skipped)
            {
                <span class="map-module__state">@L["Skipped"]</span>
            }
            @if (node.Quiet)
            {
                <span class="map-module__quiet">@(" ")@L["Quiet"]</span>
            }
            @if (node.Badges.Count > 0)
            {
                <span class="map-module__badges">
                    @foreach (var badge in node.Badges)
                    {
                        <span class="map-badge map-badge--@MapBadgeStyle.Class(badge.Tone)" data-badge-kind="@badge.Kind">
                            @if (MapBadgeStyle.Icon(badge.Tone) is { } icon)
                            {
                                <MudIcon Icon="@icon" Size="Size.Small" aria-hidden="true" />
                            }
                            <span class="map-badge__words">@Carries(badge.Words)</span>
                        </span>
                    }
                </span>
            }
        </button>;

    private string ModuleClass(MapNode node) =>
        $"map-module{(_chosen == node.End.Module ? " map-module--chosen" : "")}{(node.Refused ? " map-module--refused" : "")}{(node.Skipped ? " map-module--skipped" : "")}{(node.Quiet ? " map-module--quiet" : "")}";

    private static bool ToPocket(MapBundle bundle) => bundle.To.Bucket == "pocket";

    // What a link carries, in the words of the texts that word its line on its card (MapTabText.Texts), or a
    // condition's word or two, in the map's.
    private string Carries(MapLabel label)
    {
        if (!_texts.TryGetValue(label.Text, out var texts))
            _texts[label.Text] = texts = Localizers.Create(MapTabText.Texts(label.Text));

        return texts[label.Key, [.. label.Args]].Value;
    }

    // A module by its card's title, a bucket by the bar's name for it, the river's edge as such.
    private string EndName(MapEnd end) => end switch
    {
        { Module: { } module } => L[MapTabText.Module(module)],
        { Bucket: { } bucket } => BucketTexts[BucketBarText.Bucket(bucket, _view.TaxesOnPayIncludeRent)],
        _ => L[MapTabText.OutOfRiver],
    };

    private static string Points(IReadOnlyList<MapPoint> points) => string.Join(' ', points.Select(point => $"{Number(point.X)},{Number(point.Y)}"));

    private static string Box(MapSlot slot) =>
        $"left: {Percent(slot.Left)}; top: {Percent(slot.Top)}; width: {Percent(slot.Width)}; height: {Percent(slot.Height)}";

    // A quiet row: as wide as its slot and as tall as its names, placed by its slot's middle, its slot being
    // the height its names take one per line on the narrowest map (MapLayout).
    private static string Pill(MapSlot slot) =>
        $"left: {Percent(slot.Left)}; top: {Percent(slot.CenterY)}; width: {Percent(slot.Width)}";

    private static string Percent(decimal value) => $"{Number(value)}%";

    private static string Pixels(decimal value) => $"{value.ToString("0.##", CultureInfo.InvariantCulture)}px";

    private static string Number(decimal value) => Math.Round(value, 3).ToString("0.###", CultureInfo.InvariantCulture);
}
