@using System.Globalization
@using Netto.Core.Rules
@using Netto.Core.Simulation
@using Netto.Web.Client.River
@inject IStringLocalizer<MapTab> L
@inject IStringLocalizer<BucketBar> BucketTexts
@inject IStringLocalizerFactory Localizers
@inject PicturePreference Pictures

@* The map of My plan: the plan's modules from above, as the river shows them, and the money between them, every
   line the links of the river's one run between the same two ends, whose amount is a figure its card
   draws or the sum of its card's lines between those two ends (MapView, MapLinks, MapBundle): the sum is
   the map's arithmetic of display, and no tax figure is computed here. The modules sit in fixed slots by
   whose money they move (MapLayout), in three columns framed and labelled over their top, out of a screen
   reader's hearing, the buttons saying the modules in the river's order: the director's and the household's
   on the left, Household over Director pay; the ways across in the middle, each lever, the royalty and the
   dividend a dashed gate whose box says what crosses and what reaches the director (MapGates, a line each);
   the company's on the right, Company year, the split and Corporate tax, what the company has left running
   down its own line from Company year into the split, each lever taking its share across to its gate; all
   over the bar's five buckets, rows in the river's order. The pay crosses straight from the split into
   Director pay under its pill, which says it. A lever out of the plan is not on it, and with the company
   skipped the map starts at Director pay, over which Company year stays, drawn dashed as the river draws its
   skipped card and said skipped in words, with no link, so that it can be chosen and its year entered
   again beside the map; the cards that only wait for it are left out. Each link is a line of its kind
   (MapLinkStyle: passed on, into a bucket, a tax base, a condition), its dash, width and ink set on the line
   itself, a line of money as thick as its amount beside the run's largest (MapLineWidths), with an
   arrowhead in the same ink, sized by the line, where it reaches a module, and none
   into a bucket, under which it runs on to the bucket's middle, the bucket being where its money stops:
   money passed on and money into a bucket are told apart by their ends, not by a colour. Each line is a path
   through its route's points, its corners turned on arcs (MapPath, MapView.PathOf), the route itself staying
   the layout's orthogonal points, drawn over a halo of the map's ground on the same path so that a line
   crossing another leaves a gap each side of it. The links
   of one card between the same two ends and of one kind are one line (MapBundle), which says one amount and
   no words, on a stretch of its own or right beside it, where MapAmounts places it from every link of the
   run: the sum of the card's lines it holds, each a figure the card draws; a condition's line says no word, its
   rule and state being the Effects list's, a badge on the module it reaches saying only what is lost; its sentence,
   with its figures, is not on the tab (operator, 2026-10-28) but the cards' (MapConditions). An amount hangs from its
   point of its line by its pixels, so it keeps to its line however large the map is drawn, and its ground
   hides the lines crossing it, square. What reaches the director runs into one gold line down the left of
   their column, the pocket line (MapPocketLine), the one gold of the map, each stretch of it saying what has
   reached them so far, right of it just under the join it follows, its last the pocket the bar says. It is
   drawn as one shape under every other line, a square-ended step for each stretch as wide as what has reached
   them so far (MapView.PocketLine), never faded a stretch alone; a line joining it turns down into it on an
   arc and a line leaving it curves out of it the same way, in the flow's direction, neither with a halo where
   they meet it (MapView.HaloPathOf), so nothing cuts the gold line; a line joining it says no amount, its gate's box or
   the total under it saying it, nor does the pay, its pill saying it, or a gate's share of the company's line its
   box already says (MapLink.Unsaid).

   The rules are marks on the module they act on only where they are lost: a condition another module sets on it
   that costs the plan its rate or its reserve is a badge in its box saying what is lost, in words that read alone
   (the pay's and the benefits' loss of the rate being one), each reading whole on the narrowest map
   (MapLayout.BadgeRoom), read from every link, so a line left undrawn hides no badge, and the box is a line
   taller for each (MapLayout). What a tax base adds is no badge: its dotted line says its amount while the module
   is chosen, and the Effects list says it in words. What is lost is in an icon and an outline in the error colour, never the
   colour alone; a rule that holds, the office rule and a royalty lowering no pay or lowering the pay keeping the
   rate leave none, the Effects list beside the card saying every rule and its state. The badges are the
   button's content, so a screen reader hears them with the module's name.

   A lever that moves no money of its own in this plan, one added with nothing in it yet, is quiet
   (MapQuiet): no box, its name muted in a dashed pill among the gates it shares with the quiet levers it
   follows down the company's line, each name saying in its button, out of sight, that it holds nothing in
   this plan; the royalty that comes to nothing is quiet in its own place. The pill is kept as tall as its
   names one per line on the narrowest map. The company's line runs on past them in its own column, its
   amount said once. A quiet name is a button like a box, so
   that choosing it opens its card beside the map, where its amounts are entered; once it moves money it
   has its box back, in its place.

   A module is a button: chosen, by a click or Enter or Space, it is marked (aria-pressed) and its own
   lines stay with their amounts where they were, while the others fade with no amount, but the pocket line,
   which stays whole at full ink, the module's share of it showing by its own line into it, the map showing no
   words, and beside the map is its card (MapPanel, pinned open), whose edits go to the page's one river,
   under one line saying what it receives and from where (MapReceivedView), each amount the one the map says
   on that line, an end that is a module a button that chooses it as its box does, so a keyboard walks the
   money upstream; where its money goes is its card's drain list. A screen reader hears the buttons, the
   line and the card, and nothing of the drawing itself. Choosing it again lets it go.

   A bucket is a button too, named as the bar names it, after every module, as the river ends in them, so a
   keyboard reaches them last: chosen, on the map or in the bar, it is marked as a module is and keeps the
   lines at either end of it, into it and back out of it, the pocket every line into or out of the pocket
   line, while the others fade, the pocket line whole with them unless the pocket is chosen (MapBundle.Shows,
   MapView.PocketLine); beside the map is its read-only card (BucketCard), with no line over it, the card
   saying what fills it, and no rule's line, none reaching a bucket. The choice, a module or a bucket
   (MapChoice), is the page's (Chosen, ChosenChanged), so it stays from one tab to the next; the map takes no
   focus for it, the card it opens beside the map does (MapPanel). Nothing here is a live region: the bar's is the river's
   only announcement. While the engine refuses an amount the map draws no line and no amount, as the bar
   draws no figure, the module holding the refused field is marked, in words too, the refusal is said above
   the map, unless the card of the module chosen, beside it, holds the refused field and says it there, so
   that it is said once, and nothing is said received; a bucket's card holds no field, so with a bucket
   chosen it is said above the map.

   The map is as tall as the window leaves under the band, and stays there while the page scrolls the card
   beside it, which has no scroll area of its own. Over the map are its tools: the switch of its picture and what
   the page puts there (AddToPlan); under it, while it is the map, the key to its lines (MapKey), one muted line
   saying what each style of line is, whose height the map gives up. Every line of money is drawn;
   a tax base's and a condition's line only for the module chosen, with its arrowhead and its amount or words,
   none while nothing is chosen, their badges saying them on the modules they reach (MapView.ShowingFor). The
   choice leaves everything else where it is: the modules, the buckets, the route of every line and its amount
   are the run's, placed once from every link of it, and the choice of a module is the page's. The lines are an
   SVG stretched to the map's box (preserveAspectRatio="none"), kept to their width by vector-effect; what
   must keep its shape, the boxes, the amounts and the arrowheads, is HTML placed over it in percentages. *@
<RefusedMessage Error="@(ChosenRefusal is null ? _view.Refusal : null)" />

<div class="map-tab">
    <div class="map-tab__map">
        <div class="map-tab__tools">
            <MapPictureSwitch Current="Pictures.Current" Chosen="OnPictureChosen" />
            @if (AddToPlan is not null)
            {
                <div class="map-tab__add">@AddToPlan</div>
            }
        </div>
        @* The map alone, or the Sankey in its place with its own key (SankeyDrawing), the viewer's pick on the switch
           (PicturePreference), which scrolls sideways in it where the column is narrower than the picture. *@
        <div class="map-tab__frame">
            @if (Pictures.Current == PlanPicture.Sankey)
            {
                <SankeyDrawing Inputs="Inputs" Run="Run" Chosen="_chosen" Choose="choice => ChooseAsync(choice)" />
            }
            else
            {
            <div class="map" style="--map-units: @Number(_view.Units)" role="group" aria-label="@L["MapLabel"]">
                @foreach (var (owner, slot) in _view.Columns)
                {
                    <div class="map-column map-column--@owner.ToString().ToLowerInvariant()" style="@Box(slot)" aria-hidden="true"><span class="map-column__label">@L[MapTabText.Column(owner)]</span></div>
                }
                <svg class="map__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                    @if (_pocket.Steps.Count > 0)
                    {
                        <g class="@PocketClass(_pocket)">
                            @foreach (var step in _pocket.Steps)
                            {
                                <path class="map-pocket-line__halo" d="@StepPath(step)" stroke-width="@MapLinkStyle.Halo(step.Width)" />
                            }
                            @foreach (var step in _pocket.Steps)
                            {
                                <path class="map-pocket-line__step" d="@StepPath(step)" stroke-width="@MapLinkStyle.Width(step.Width)" style="stroke: @MapLinkStyle.PocketInk" />
                            }
                        </g>
                    }
                    @foreach (var (bundle, faded) in _drawn)
                    {
                        if (EffectOf(bundle) is { } effect)
                        {
                            <g class="map-effect" data-effect="@effect.Index" @onmouseenter="() => Mark(bundle.Route)" @onmouseleave="() => Mark(null)"><title>@EffectSentence(effect.Item)</title>@Line(bundle, faded)</g>
                        }
                        else
                        {
                            @Line(bundle, faded)
                        }
                    }
                </svg>
                @foreach (var (bundle, faded) in _drawn.Where(line => line.Bundle.Arrowhead))
                {
                    <span class="@ArrowClass(bundle, faded)" style="left: @Percent(bundle.Route.End.X); top: @Percent(bundle.Route.End.Y); @ArrowSize(bundle) --map-arrow: @Ink(bundle)" aria-hidden="true"></span>
                }
                @foreach (var amount in _amounts)
                {
                    <span class="@AmountClass(amount.Bundle)" data-link-kind="@amount.Bundle.Kind" style="@AmountStyle(amount)" aria-hidden="true">@amount.Text</span>
                }
                @if (_view.ShownPill is { } pill)
                {
                    <div class="@PillClass(pill)" style="@Box(pill.Slot)" aria-hidden="true"><MapGateWords Line="pill.Words" /></div>
                }
                @foreach (var place in _view.Places())
                {
                    if (place.Quiet)
                    {
                        <div class="map-quiet" style="@Pill(place.Slot)">
                            @foreach (var node in place.Nodes)
                            {
                                @ModuleButton(node)
                            }
                        </div>
                    }
                    else
                    {
                        @ModuleButton(place.Nodes[0])
                    }
                }
                @* After the modules, as the river ends in them, so a keyboard reaches them last. *@
                @foreach (var bucket in _view.Buckets)
                {
                    @BucketButton(bucket)
                }
            </div>
            }
        </div>
        @* The key to the map's lines, one muted line under it, only while the picture is the map (the Sankey
           keeps its own key), among what the sticky map holds so that the map gives it its room. *@
        @if (Pictures.Current == PlanPicture.Map)
        {
            <div class="map-tab__key">
                <MapKey />
            </div>
        }
    </div>
    <div class="map-tab__side">
        @if (_received is { Lines.Count: > 0 } received)
        {
            <p class="map-tab__receives">
                <span class="map-tab__receives-label">@L["Receives"]</span>
                @foreach (var line in received.Lines)
                {
                    if (!line.First)
                    {
                        <span class="map-tab__receives-gap" aria-hidden="true">@L["ReceivedBetween"]</span>
                    }
                    <span class="map-tab__received">@L["ReceivedFrom", line.Amount] @ReceivedEnd(line)</span>
                }
            </p>
        }
        @if (_effects is { Items.Count: > 0 } effects)
        {
            <ul class="map-tab__effects" aria-label="@L[MapEffectText.Effects]">
                @foreach (var (effect, index) in effects.Items.Select((item, index) => (item, index)))
                {
                    <li class="@EffectClass(effect)" data-effect="@index">@EffectWords(effect) <button type="button" class="map-tab__go" data-effect-on="@MapModules.Name(effect.Other)" @onclick="() => ChooseAsync(effect.Other)">@L[MapTabText.Module(effect.Other)]</button></li>
                }
            </ul>
        }
        <div class="map-tab__panel">
            <MapPanel Chosen="_chosen" ViewerChose="ViewerChose" Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="ChosenRefusal" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    // The river with an edit made on the chosen module's card beside the map.
    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's refusal a module's card holds, as the Plan page hands it to that card.
    [Parameter]
    public Func<RiverModule, Refusal?> RefusedBy { get; set; } = _ => null;

    // The module or the bucket chosen on the map, the page's, so it stays from one tab to the next; a module
    // none once it has left the map.
    [Parameter]
    public MapChoice? Chosen { get; set; }

    [Parameter]
    public EventCallback<MapChoice?> ChosenChanged { get; set; }

    // Whether the choice is the viewer's (ChosenChanged, or a bucket of the bar), rather than one the page made
    // itself, Company year on arriving or a lever just added: only the viewer's takes the focus to its card.
    [Parameter]
    public bool ViewerChose { get; set; }

    // What the page puts among the map's tools, after the switch: « Edit plan » (CompositionMenu).
    [Parameter]
    public RenderFragment? AddToPlan { get; set; }

    // The engine's refusal the chosen module's card holds, as the Plan page hands it to that card; none for a
    // bucket, whose card holds no field, so the refusal is said above the map.
    private Refusal? ChosenRefusal => _chosen?.Module is { } module ? RefusedBy(module) : null;

    // The map of the run, and what the choice draws of it (MapView.ShowingFor): the second is what is drawn, the
    // first what the chosen module receives is read from, and what every line's amount is placed on
    // (MapAmounts), once a run, so a choice moves none.
    private MapView _full = default!;
    private MapView _view = default!;
    private IReadOnlyList<MapAmount> _placed = [];
    private (RiverInputs Inputs, RiverRun Run)? _mapped;
    private MapChoice? _chosen;
    private MapReceivedView? _received;

    // What the module chosen does to another's tax base or under another's condition, and what is done to it so,
    // a line each (MapEffectsView), the one under the viewer's pointer marked; none while none is chosen.
    private MapEffectsView? _allEffects;
    private MapEffectsView? _effects;
    private IReadOnlyList<(MapBundle Bundle, bool Faded)> _drawn = [];
    private MapPocketShape _pocket = new([]);
    private IReadOnlyList<MapAmount> _amounts = [];
    private readonly Dictionary<MapText, IStringLocalizer> _texts = [];

    // What the tab draws, for the page's tests to read as they read Chosen (a render of the page writes no
    // HTML): the map as the choice draws it, its lines and the amounts on them.
    internal MapView ShownMap => _view;

    internal IReadOnlyList<(MapBundle Bundle, bool Faded)> DrawnLines => _drawn;

    internal MapPocketShape DrawnPocketLine => _pocket;

    internal IReadOnlyList<MapAmount> DrawnAmounts => _amounts;

    // What the module chosen receives, which the line over its card says, none while none is chosen.
    internal MapReceivedView? Received => _received;

    // What the module chosen does to another's tax base or under another's condition, the list beside its card,
    // the item of the line under the pointer marked; none while none is chosen.
    internal MapEffectsView? Effects => _effects;

    protected override void OnParametersSet()
    {
        // The map and its amounts are the run's: worked out again for another run, not for another choice.
        if (_mapped is not var (inputs, run) || !ReferenceEquals(inputs, Inputs) || !ReferenceEquals(run, Run))
        {
            _full = MapView.From(Inputs, Run, module => L[MapTabText.Module(module)].Value);
            _placed = MapAmounts.Of(_full);
            _mapped = (Inputs, Run);
        }

        // The lines the choice draws, and their amounts, each where it was placed.
        _chosen = _full.Choice(Chosen);
        _view = _full.ShowingFor(_chosen);
        _drawn = _view.Drawn(_chosen);
        _pocket = _view.PocketLine(_chosen);
        _amounts = _view.Amounts(_placed, _chosen);

        // Made from every link of the run, whatever the choice draws; a module's alone: a bucket's card says what
        // fills it, so nothing over it says it again, and no rule reaches a bucket.
        _received = _chosen?.Module is { } chosen ? MapReceivedView.Of(_full, chosen, EndName) : null;
        _allEffects = _chosen?.Module is { } module ? MapEffectsView.Of(_full, module) : null;
        _effects = _allEffects;
    }

    // The pointer over a line of the list's, or off it: its item marked, or none.
    private void Mark(MapRoute? route) => _effects = _allEffects?.Marking(route);

    // The item of the list a line drawn is, and its number, none for a line the list does not hold.
    private (int Index, MapEffect Item)? EffectOf(MapBundle bundle)
    {
        if (_effects is not { } effects)
            return null;
        for (var index = 0; index < effects.Items.Count; index++)
        {
            if (ReferenceEquals(effects.Items[index].Route, bundle.Route))
                return (index, effects.Items[index]);
        }

        return null;
    }

    // An item's words, up to the other module, which its button names: a condition's rule and its word, a tax
    // base's card lines and its amount.
    private string EffectWords(MapEffect effect) => effect.Rule is { } rule
        ? L[effect.Key, Carries(rule), effect.State is { } state ? Carries(state) : ""].Value
        : L[effect.Key, string.Join(", ", effect.What.Select(Carries)), effect.Amount ?? ""].Value;

    // An item's whole sentence, the other module named last, as the title of its line on the map.
    private string EffectSentence(MapEffect effect) => $"{EffectWords(effect)} {L[MapTabText.Module(effect.Other)].Value}";

    private static string EffectClass(MapEffect effect) => $"map-tab__effect{(effect.Marked ? " map-tab__effect--marked" : "")}";

    // A line drawn: its halo of the map's ground, on its own path but where it stops short of the pocket line
    // (MapView.HaloPathOf), none where nothing of it is left, then the line itself in its kind's ink, its corners
    // turned on arcs (MapView.PathOf).
    private RenderFragment Line(MapBundle bundle, bool faded) =>
        @<text>@if (_view.HaloPathOf(bundle) is { Length: > 0 } halo)
        {<path class="@HaloClass(faded)" d="@halo" stroke-width="@MapLinkStyle.Halo(bundle.Route.Width)" />}<path class="@LineClass(faded)" d="@_view.PathOf(bundle)" stroke-dasharray="@MapLinkStyle.Dash(bundle.Kind)" stroke-width="@MapLinkStyle.Width(bundle.Route.Width)" data-link-kind="@bundle.Kind" style="stroke: @Ink(bundle)" /></text>;

    // A step of the pocket line: straight down its line from its top to its bottom.
    private string StepPath(MapPocketStep step) => MapPath.Of([new MapPoint(step.X, step.Top), new MapPoint(step.X, step.Bottom)], _view.Scale);

    private static string PocketClass(MapPocketShape line) => $"map-pocket-line{(line.Faded ? " map-pocket-line--faded" : "")}";


    // A picture pressed on the switch: kept as the viewer's, and drawn.
    private void OnPictureChosen(PlanPicture picture) => Pictures.Set(picture);

    // A module or a bucket chosen again lets it go.
    private Task ChooseAsync(MapChoice choice) => ChosenChanged.InvokeAsync(_chosen == choice ? null : choice);

    private Task ChooseAsync(RiverModule module) => ChooseAsync(MapChoice.Of(module));

    // Whether a box of the map is the module or the bucket chosen.
    private bool IsChosen(MapNode node) => _chosen is not null && _chosen.End == node.End;

    // A bucket's button: its name, as the bar names it, marked while chosen.
    private RenderFragment BucketButton(MapNode bucket) =>
        @<button type="button" class="@BucketClass(bucket)" aria-pressed="@(IsChosen(bucket) ? "true" : "false")" data-bucket="@bucket.End.Id" style="@Box(bucket.Slot)"
                 @onclick="() => ChooseAsync(MapChoice.InBucket(bucket.End.Id))">@EndName(bucket.End)</button>;

    private string BucketClass(MapNode bucket) => $"map-bucket map-bucket--{bucket.End.Id}{(IsChosen(bucket) ? " map-bucket--chosen" : "")}";

    // An end of the line over the card: a module on the map is a button that chooses it, a bucket a name.
    private RenderFragment ReceivedEnd(MapReceived line) => line.Module is { } module
        ? @<button type="button" class="map-tab__go" data-received-from="@MapModules.Name(module)" @onclick="() => ChooseAsync(module)">@line.From</button>
        : @<span class="map-tab__place">@line.From</span>;

    // The pay's pill, its amount under its words where it says two lines (MapGateText.PillLines).
    private static string PillClass(MapPill pill) => MapGateText.PillLines(pill.Words.Key) == 1 ? "map-pill" : "map-pill map-pill--two";

    private static string LineClass(bool faded) => $"map-line{(faded ? " map-line--faded" : "")}";

    private static string ArrowClass(MapBundle bundle, bool faded) =>
        $"map-arrow map-arrow--{bundle.Route.Arrow.ToString().ToLowerInvariant()}{(faded ? " map-arrow--faded" : "")}";

    private static string HaloClass(bool faded) => $"map-halo{(faded ? " map-halo--faded" : "")}";

    // An arrowhead's size, its line's (MapLineWidths): half its base and its length, in pixels.
    private static string ArrowSize(MapBundle bundle) =>
        $"--map-arrow-half: {MapLinkStyle.Width(MapLineWidths.ArrowHalf(bundle.Route.Width))}px; --map-arrow-length: {MapLinkStyle.Width(MapLineWidths.ArrowLength(bundle.Route.Width))}px;";

    // A line's ink and its arrowhead's, its kind's (MapLinkStyle), or the gold of what reaches the pocket.
    private static string Ink(MapBundle bundle) => ToPocket(bundle) ? MapLinkStyle.PocketInk : MapLinkStyle.Ink(bundle.Kind);

    // What reaches the pocket is said in the gold of its line.
    private static string AmountClass(MapBundle bundle) => $"map-amount{(ToPocket(bundle) ? " map-amount--pocket" : "")}";

    // Where an amount is drawn: at its point of its line, in percent of the map, as wide as MapAmounts
    // reckons it, its box moved from that point by its pixels (MapAmount.Left, Top).
    private static string AmountStyle(MapAmount amount) =>
        $"left: {Percent(amount.At.X)}; top: {Percent(amount.At.Y)}; width: {Pixels(amount.Width)}; transform: translate({Pixels(amount.Left)}, {Pixels(amount.Top)})";

    // A module's button: a box in its slot, or a name in its quiet row, which places it, saying its state in
    // a word: refused, skipped, or, out of sight, since its row's dashes show it, that a quiet lever holds
    // nothing in this plan. A box holds its badges under its title, a line each (MapLayout keeps them the
    // room), each its tone's icon, out of a screen reader's hearing, and its words, which are part of the
    // button's name.
    private RenderFragment ModuleButton(MapNode node) =>
        @<button type="button" class="@ModuleClass(node)" style="@(node.Quiet ? null : Box(node.Slot))" aria-pressed="@(IsChosen(node) ? "true" : "false")"
                 data-module="@node.End.Id" @onclick="() => ChooseAsync(node.End.Module!.Value)">
            <span class="map-module__title">@L[MapTabText.Module(node.End.Module!.Value)]</span>
            @if (!node.Quiet)
            {
                foreach (var line in node.Lines)
                {
                    <MapGateWords Line="line" />
                }
            }
            @if (node.Refused)
            {
                <span class="map-module__state">@L["Refused"]</span>
            }
            @if (node.Skipped)
            {
                <span class="map-module__state">@L["Skipped"]</span>
            }
            @if (node.Quiet)
            {
                <span class="map-module__quiet">@(" ")@L["Quiet"]</span>
            }
            @if (node.Badges.Count > 0)
            {
                <span class="map-module__badges">
                    @foreach (var badge in node.Badges)
                    {
                        <span class="map-badge map-badge--@MapBadgeStyle.Class(badge.Tone)" data-badge-kind="@badge.Kind">
                            @if (MapBadgeStyle.Icon(badge.Tone) is { } icon)
                            {
                                <MudIcon Icon="@icon" Size="Size.Small" aria-hidden="true" />
                            }
                            <span class="map-badge__words">@Carries(badge.Words)</span>
                        </span>
                    }
                </span>
            }
        </button>;

    private string ModuleClass(MapNode node) =>
        $"map-module{(node.Gate && !node.Quiet ? " map-module--gate" : "")}{(IsChosen(node) ? " map-module--chosen" : "")}{(node.Refused ? " map-module--refused" : "")}{(node.Skipped ? " map-module--skipped" : "")}{(node.Quiet ? " map-module--quiet" : "")}";

    // What runs into the pocket, gold: a line joining the pocket line and every stretch of it.
    private static bool ToPocket(MapBundle bundle) => bundle.To.InPocket;

    // What a link carries, in the words of the texts that word its line on its card (MapTabText.Texts), or a
    // condition's state, in the map's, for the Effects list.
    private string Carries(MapLabel label) => TextsOf(label)[label.Key, [.. label.Args]].Value;

    private IStringLocalizer TextsOf(MapLabel label)
    {
        if (!_texts.TryGetValue(label.Text, out var texts))
            _texts[label.Text] = texts = Localizers.Create(MapTabText.Texts(label.Text));

        return texts;
    }

    // A module by its card's title, a bucket by the bar's name for it.
    private string EndName(MapEnd end) => end switch
    {
        { Module: { } module } => L[MapTabText.Module(module)],
        { Bucket: { } bucket } => BucketTexts[BucketBarText.Bucket(bucket)],
        _ => throw new ArgumentOutOfRangeException(nameof(end), "An end with neither a module nor a bucket."),
    };

    private static string Box(MapSlot slot) =>
        $"left: {Percent(slot.Left)}; top: {Percent(slot.Top)}; width: {Percent(slot.Width)}; height: {Percent(slot.Height)}";

    // A quiet row: as wide as its slot and as tall as its names, placed by its slot's middle, its slot being
    // the height its names take one per line on the narrowest map (MapLayout).
    private static string Pill(MapSlot slot) =>
        $"left: {Percent(slot.Left)}; top: {Percent(slot.CenterY)}; width: {Percent(slot.Width)}";

    private static string Percent(decimal value) => $"{Number(value)}%";

    private static string Pixels(decimal value) => $"{value.ToString("0.##", CultureInfo.InvariantCulture)}px";

    private static string Number(decimal value) => Math.Round(value, 3).ToString("0.###", CultureInfo.InvariantCulture);
}
