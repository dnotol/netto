@using Netto.Core.Rules
@using Netto.Core.Simulation
@using Netto.Web.Client.River
@inject IStringLocalizer<OptimisationTab> L

@* The Optimise view: what Netto would retune in the plan on screen to leave more in the pocket, a tab of
   its own beside the river rather than a card in it, since it is no module of the river. The moves are
   measured from the plan on screen, the river the band runs, and retune only the levers already in it, with
   the facts it holds: none adds a lever or asks a question (MoveSearch, RiverInputs.FindMoves). One page of
   moves: first what the plan leaves in the pocket, what it leaves with every move and the difference, with
   « Apply all »; then the engine's moves, in the order it took them, each numbered for the eye (the list says
   its place to a screen reader), with why it helps (MoveReasons, the engine's figures before and after it),
   what it adds on top of the ones above it, what the pocket holds after it, and a link to the card or the tab
   where it acts (MoveLinks), while that card is on the map; their total is the gain above the list, said
   once. « Apply » sets the river's values to the move's, « Apply all » every move's: nothing is applied
   unasked. Under the moves, « Tune your pay » draws the curve of the pocket at every pay (PayCurve): a click on it
   or « move to the best pay » sets the plan's own pay, said as such, and is no move applied. Applied, the river is a plan
   the moves were not searched for, so the tab says it looks for them again, and the focus goes to that line;
   no live region says it, nor that they are found. Under the pay's move a note names the river's own best
   pay, the curve's below, whenever the river at that pay is not at its best (PayNote), from the search the
   page hands the tab. The page finds the moves, once per plan and date (MovesSource), after it has painted;
   until then the tab says it is looking for them, and nothing else. While Netto cannot run the plan, the tab
   says why, and nothing else. *@
<TabHead Title="@L["Title"]" />
<div class="moves">
    @if (_view.State is MovesState.Moves or MovesState.AlreadyBest)
    {
        <dl class="moves__figures">
            <div class="moves__pair">
                <dt class="moves__term">@L[OptimisationTabText.FromInPocket]</dt>
                <dd class="moves__figure">@Formats.Euros(_view.FromInPocket)</dd>
            </div>
            @if (_view.State == MovesState.Moves)
            {
                <div class="moves__pair">
                    <dt class="moves__term">@L[OptimisationTabText.PlanInPocket]</dt>
                    <dd class="moves__figure">@Formats.Euros(_view.PlanInPocket)</dd>
                </div>
                <div class="moves__pair">
                    <dt class="moves__term">@L[OptimisationTabText.MoreThanFrom]</dt>
                    <dd class="moves__figure moves__figure--gain">@Formats.Addition(_view.Total)</dd>
                </div>
            }
        </dl>
        @if (_view.State == MovesState.Moves)
        {
            <div class="moves__all">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="moves__apply" OnClick="ApplyAll">@L[OptimisationTabText.ApplyAll]</MudButton>
            </div>
        }
        @* What the figures are measured by and what they leave out, beside them and in sight: a visitor needs
           it to read the first recommendation (ObjectiveNote, which the bar's gain says in a bubble). *@
        <p class="moves__objective"><ObjectiveNote /></p>
    }
    @* Where the focus goes once a move is applied: the line that then says the moves are looked for again. *@
    <p class="moves__state" tabindex="-1" @ref="_state">@L[OptimisationTabText.State(_view.State)]</p>
    @if (_view.State == MovesState.Moves)
    {
        @* A list styled without its markers loses its role in some browsers: it is said again. *@
        <ol class="moves__list" role="list">
            @foreach (var (move, index) in _view.Moves.Select((move, index) => (move, index)))
            {
                var link = MoveLinks.To(move.Move, Inputs);
                var bestPay = PayNote.RiversBestPay(move.Move, Inputs, Search);
                <li class="moves__move">
                    <span class="moves__number" aria-hidden="true">@(index + 1)</span>
                    <div class="moves__body">
                        <p class="moves__what">@What(move)</p>
                        <p class="moves__why">@Why(move)</p>
                        @if (bestPay is { } best)
                        {
                            <p class="moves__note" id="moves-pay-note">@L["BestPay", Formats.Euros(best)]</p>
                        }
                        @if (link is not null)
                        {
                            <a class="moves__link" href="@link.Href" aria-label="@L[OptimisationTabText.LinkLabel, L[OptimisationTabText.Link(link)], What(move)]">@L[OptimisationTabText.Link(link)]</a>
                        }
                    </div>
                    <div class="moves__amounts">
                        <span class="moves__gain">@L["Gain", Formats.Euros(move.Gain)]</span>
                        <span class="moves__after">@L[OptimisationTabText.After, Formats.Euros(_view.InPocketAfter(index))]</span>
                    </div>
                    <div class="moves__action">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="moves__apply" OnClick="@(() => Apply(move))"
                                   aria-label="@L["ApplyLabel", What(move)]">@L["Apply"]</MudButton>
                    </div>
                </li>
            }
        </ol>
    }
</div>
<PayCurve Inputs="Inputs" InputsChanged="InputsChanged" Search="Search" />

@code {
    // Whether the page is still to search the moves from the plan on screen, which it does once it has
    // painted (MovesSource): Found is then nothing yet.
    [Parameter]
    public bool Searching { get; set; }

    // What the page's search found for the plan on screen on its date (MovesSource), none for a plan that
    // starts at the pay.
    [Parameter]
    public (MovePlan? Value, Refusal? Error)? Found { get; set; }

    // The plan on screen, the moves are measured from and applied to.
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    // The river with a move applied, or every move.
    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    // The engine's search across every pay for the river as it is, which the page runs again only when an
    // input other than the pay changes (Plan, RiverInputs.SearchSplit): the tab names the best pay it
    // finds under the pay's move (PayNote), running none of its own. None while the company's year is
    // skipped or an amount is refused.
    [Parameter]
    public SplitSearchResult? Search { get; set; }

    private MovesView _view = default!;
    private ElementReference _state;
    private bool _focusState;

    // The view of what was found, or that the moves are being looked for, which searches nothing.
    protected override void OnParametersSet() =>
        _view = Searching ? MovesView.Searching(Inputs) : MovesView.Of(Inputs, Found);

    // What the move changes, in words (OptimisationTabText); a move it has none for is refused.
    private string What(PlannedMove move) =>
        L[OptimisationTabText.Move(move.Move),
            OptimisationTabText.MoveArguments(move.Move, _view.FromPay, _view.From.Copyright.CreativeShare.Value ?? 0m)];

    // Why the move helps, its sentences one after the other, every amount in euros.
    private string Why(PlannedMove move) =>
        string.Join(" ", MoveReasons.Of(move).Select(reason =>
            L[OptimisationTabText.Why(reason.Kind), [.. reason.Amounts.Select(amount => (object)Formats.Euros(amount))]].Value));

    // Applied, the list goes until the moves are found for the plan it leaves, so the focus goes to the line
    // saying they are looked for.
    private async Task Apply(PlannedMove move)
    {
        _focusState = true;
        await InputsChanged.InvokeAsync(_view.Apply(move, Inputs));
    }

    private async Task ApplyAll()
    {
        _focusState = true;
        await InputsChanged.InvokeAsync(_view.ApplyAll(Inputs));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusState)
        {
            _focusState = false;
            await _state.FocusAsync();
        }
    }
}
