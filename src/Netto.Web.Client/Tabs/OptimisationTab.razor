@using Netto.Core.Simulation
@using Netto.Web.Client.River
@inject IStringLocalizer<OptimisationTab> L
@inject Folds Folds

@* The Optimisation tab: what Netto would change in the plan starred « Today », the user's current setup,
   to leave more in the pocket, a tab of its own beside the river rather than a card in it, since it is
   no module of the river. One page of moves from Today: first what Today leaves in the pocket, what it
   leaves with every move and the difference; then the engine's moves (MoveSearch, through MovesView), in
   the order it took them, each numbered for the eye (the list says its place to a screen reader), with
   why it helps (MoveReasons, the engine's figures before and after it), what it adds on top of the ones
   above it, what the pocket holds after it, and a link to the card or the tab where it acts (MoveLinks),
   while that card is on the Plan tab; and their total. « Apply » sets the river's values to the move's;
   Today stays as it was saved, and the moves are applied from here only: the split's curve shows the best
   pay, but moves no pay by itself. A lever a move adds to the plan opens its card in the river
   (ModuleFolds), for when the viewer goes back to it, and its link appears. The page finds the moves,
   once per Today and date, the search running the split at every move, and the tab draws what it found;
   which ones the river holds is read at each change. Without a Today, or while Netto cannot run it, the
   tab says why, and nothing else. *@
<TabHead Eyebrow="@L["Eyebrow"]" Title="@L["Title"]" Lede="@L["Lede"]" />
<div class="moves">
    @if (_view.State is MovesState.Moves or MovesState.AlreadyBest)
    {
        <dl class="moves__figures">
            <div class="moves__pair">
                @* The star the Plans panel marks Today with, drawn for the eye: the words say it. *@
                <dt class="moves__term"><MudIcon Icon="@Icons.Material.Rounded.Star" Size="Size.Small" Class="moves__star" aria-hidden="true" /> @L[OptimisationTabText.TodayInPocket]</dt>
                <dd class="moves__figure">@Formats.Euros(_view.FromInPocket)</dd>
            </div>
            @if (_view.State == MovesState.Moves)
            {
                <div class="moves__pair">
                    <dt class="moves__term">@L[OptimisationTabText.PlanInPocket]</dt>
                    <dd class="moves__figure">@Formats.Euros(_view.PlanInPocket)</dd>
                </div>
                <div class="moves__pair">
                    <dt class="moves__term">@L[OptimisationTabText.MoreThanToday]</dt>
                    <dd class="moves__figure moves__figure--gain">@Formats.Addition(_view.Total)</dd>
                </div>
            }
        </dl>
    }
    <p class="moves__state">@L[OptimisationTabText.State(_view.State)]</p>
    @if (_view.State == MovesState.Moves)
    {
        @* A list styled without its markers loses its role in some browsers: it is said again. *@
        <ol class="moves__list" role="list">
            @foreach (var (move, index) in _view.Moves.Select((move, index) => (move, index)))
            {
                var link = MoveLinks.To(move.Move, Inputs);
                <li class="moves__move">
                    <span class="moves__number" aria-hidden="true">@(index + 1)</span>
                    <div class="moves__body">
                        <p class="moves__what">@What(move)</p>
                        <p class="moves__why">@Why(move)</p>
                        @if (link is not null)
                        {
                            <a class="moves__link" href="@link.Href" aria-label="@L[OptimisationTabText.LinkLabel, L[OptimisationTabText.Link(link)], What(move)]">@L[OptimisationTabText.Link(link)]</a>
                        }
                    </div>
                    <div class="moves__amounts">
                        <span class="moves__gain">@L["Gain", Formats.Euros(move.Gain)]</span>
                        <span class="moves__after">@L[OptimisationTabText.After, Formats.Euros(_view.InPocketAfter(index))]</span>
                    </div>
                    <div class="moves__action">
                        @if (_view.Applied(move, Inputs))
                        {
                            <span class="moves__applied" tabindex="-1" @ref="_applied[index]">@L["Applied"]</span>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="moves__apply" OnClick="@(() => Apply(move, index))"
                                       aria-label="@L["ApplyLabel", What(move)]">@L["Apply"]</MudButton>
                        }
                    </div>
                </li>
            }
        </ol>
        <p class="moves__total">@L["Total", Formats.Euros(_view.Total)]</p>
    }
</div>

@code {
    // The plan starred « Today », or null while none is.
    [Parameter]
    public RiverInputs? Today { get; set; }

    // What the page's search found for Today on its date (RiverInputs.FindMoves), none without a Today or
    // for one that starts at the pay.
    [Parameter]
    public (MovePlan? Value, string? Error)? Found { get; set; }

    // The river as it is, to tell the moves it holds and the cards on its tab.
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    // The river with a move applied.
    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    private MovesView _view = default!;
    private readonly Dictionary<int, ElementReference> _applied = [];
    private int? _focusApplied;

    // The view of what was found, which searches nothing.
    protected override void OnParametersSet() => _view = MovesView.Of(Today, Found);

    private string What(PlannedMove move) => move.Move switch
    {
        PayMove pay => L[OptimisationTabText.Move(pay), Formats.Euros(pay.Pay), Formats.Euros(_view.FromPay)],
        CompanyAdvancePaymentMove payment => L[OptimisationTabText.Move(payment), Formats.Euros(payment.Amount), Formats.Day(payment.Date)],
        DirectorAdvancePaymentMove payment => L[OptimisationTabText.Move(payment), Formats.Euros(payment.Amount), Formats.Day(payment.Date)],
        EcoVouchersMove eco => L[OptimisationTabText.Move(eco), Formats.Euros(eco.Amount)],
        SportCultureVouchersMove sport => L[OptimisationTabText.Move(sport), Formats.Euros(sport.Amount)],
        RentMove rent => L[OptimisationTabText.Move(rent), Formats.Euros(rent.Rent)],
        CopyrightFollowsPayMove following => L[OptimisationTabText.Move(following), Formats.Percentage(_view.From?.Plan.Copyright.CreativeShare.Value ?? 0m)],
        _ => "",
    };

    // Why the move helps, its sentences one after the other, every amount in euros.
    private string Why(PlannedMove move) =>
        string.Join(" ", MoveReasons.Of(move).Select(reason =>
            L[OptimisationTabText.Why(reason.Kind), [.. reason.Amounts.Select(amount => (object)Formats.Euros(amount))]].Value));

    // Apply goes with the move applied, so the focus goes to what replaces it, « In the river ». A lever
    // the move adds to the plan opens its card in the river (ModuleFolds), so the viewer sees what the
    // move put there once back on the Plan tab.
    private async Task Apply(PlannedMove move, int index)
    {
        _focusApplied = index;
        await InputsChanged.InvokeAsync(ModuleFolds.Applied(Folds, _view, move, Inputs));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusApplied is { } index && _applied.TryGetValue(index, out var applied))
        {
            _focusApplied = null;
            await applied.FocusAsync();
        }
    }
}
