@using Netto.Web.Client.River
@inject IStringLocalizer<CompareTab> L

@* The Compare plans tab: the saved plans side by side, layer by layer, each measured against the one
   starred « Today ». It holds only its head until the comparison is built; the page hands it what it
   already holds about the river and Today, and the saved plans are SavedPlans'. *@
<TabHead Eyebrow="@L["Eyebrow"]" Title="@L["Title"]" Lede="@L["Lede"]" />

@code {
    // The river as it is.
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    // The river with a plan opened from the comparison.
    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    // The river's one run.
    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The run of the plan starred « Today », which every plan is measured against, or null while none is.
    [Parameter]
    public RiverRun? TodayRun { get; set; }

    // A saved plan changed from here, its star moved or the plan removed: the page reads the plans again.
    [Parameter]
    public EventCallback PlansChanged { get; set; }
}
