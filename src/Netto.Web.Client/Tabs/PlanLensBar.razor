@inject IStringLocalizer<PlanLensBar> L

@* How My plan is read, « by bucket · by date »: the plan by where the money goes, the map and the card of
   what is chosen, or by when it is paid (WhenToPayTab). Time is a lens, not a module
   (docs/architecture/decisions/2026-10-19-time-is-a-lens.md), and a lens is a state of My plan, not a
   view of its own, so it is two links, each with its own address (PlanTabRoutes.Href): Back, a
   bookmark, a new browser tab and a move's link to the calendar all work, as they do on the tabs. The
   current one says so (aria-current="true", not "page": the page is the tab's) and is marked in gold
   and set heavier, so colour is not its only sign. Following a link keeps this nav where it is, so the
   focus stays on the link pressed; the content below changes, and says nothing aloud: the band's live
   region is the river's one announcement. *@
<nav class="plan-lens" aria-label="@L[PlanLensBarText.Label]">
    <ul class="plan-lens__list">
        @foreach (var lens in Enum.GetValues<PlanLens>())
        {
            <li>
                <a href="@PlanTabRoutes.Href(PlanTab.Plan, lens)" class="plan-lens__link" aria-current="@(lens == Current ? "true" : null)">@L[PlanLensBarText.Name(lens)]</a>
            </li>
        }
    </ul>
</nav>

@code {
    // The lens My plan is read through.
    [Parameter, EditorRequired]
    public PlanLens Current { get; set; }
}
