@inject IStringLocalizer<PlanNudges> L

@* The one line in My plan that points at the other two views, only as counts: what Optimise can add to the
   plan on screen without changing anything else, and how many ideas are priced and how many questions
   wait. My plan suggests nothing inside the plan (docs/architecture/decisions/2026-11-11-three-views-one-question-each.md):
   this line says that something is there and leaves the proposing to the view it links to. A nudge says
   nothing it has nothing to say: no gain, no line; no ideas supplied, none; and with neither, nothing
   is drawn at all. The same counts are the tabs' badges. A nudge is a plain link, announced by no live
   region. *@
@if (Items().ToList() is { Count: > 0 } items)
{
    <ul class="plan-nudges">
        @foreach (var (href, text) in items)
        {
            <li><a class="plan-nudges__link" href="@href">@text</a></li>
        }
    </ul>
}

@code {
    // What the moves add to the plan on screen, none while there are none to say (the Optimisation badge's
    // amount): only a gain above nothing is a nudge.
    [Parameter]
    public decimal? Gain { get; set; }

    // The ideas found for the plan on screen, none while nothing supplies them.
    [Parameter]
    public PistesCount? Pistes { get; set; }

    private IEnumerable<(string Href, string Text)> Items()
    {
        if (Gain is > 0m and var gain)
            yield return (PlanTabRoutes.Href(PlanTab.Optimisation), L[PlanNudgesText.Optimise, Formats.Addition(gain)]);

        if (Pistes is { IsEmpty: false } pistes)
            yield return (PlanTabRoutes.Href(PlanTab.Pistes), L[PlanNudgesText.Pistes, PistesCountText.Words(L, pistes.Priced, pistes.Questions)]);
    }
}
