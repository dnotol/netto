@using Netto.Web.Client.River
@inject IStringLocalizer<WhenToPaySection> L

@* When to pay, the last sub-tab of the Optimise view (OptimisationTab, ?show=when): when the
   plan's payments fall, a view over the whole river, not a module in it, so no card, no rate and no « Remove ».
   It was the When to pay tab, then the by-date lens of My plan; its old addresses lead here (PlanMoved).
   Its heading is the section's h2, which takes the focus when the page arrives at the sub-tab other than by
   its link in the row (OptimisationTab.FocusSectionAsync), and its parts and the timeline's heading are h3. It reads the river's one
   calendar, built once per draw by the page for the tab's badge too (CalendarView over the engine's
   PaymentCalendar): first who pays what next, by which day, with one sentence per tax saying what its
   payments leave and what more cancels the surcharge, as its card says it (the Next panel); then the year
   on a timeline (CalendarTimeline), drawn from the same calendar; then the company's and the director's
   advance payments by each deadline as the plan holds them, the past ones marked, and at the first deadline
   still open what more cancels each surcharge; the pay each month, as the pay slip gives it; and after the
   year, what each assessment leaves. The timeline is a picture and the tables are its text equivalent. It
   applies nothing: the Adjustments sub-tab is where a payment is applied. Its heading and the note under it
   say it is for the plan on screen as it stands, not with the moves applied: a move's payment is found on top
   of the moves before it, so the two can differ. Its one input, what the fund bills, sits
   in a field sized to an amount and shows the engine's refusal beside it. The one sentence the section needs
   to be read right, which date it reads, ends the Next panel, where the deadlines are dated. *@
<section class="calendar" aria-labelledby="when-to-pay-title">
    <h2 id="when-to-pay-title" class="calendar__title" tabindex="-1" @ref="_title">@L["Title"]</h2>
    <p class="calendar__note">@L["ForPlan"]</p>
    @if (_view is null)
    {
        <p class="calendar__note">@L["Refused"]</p>
    }
    else
    {
        <section class="calendar__panel" aria-labelledby="calendar-next">
            <h3 id="calendar-next" class="calendar__heading">@L["NextHeading"]</h3>
            <p class="calendar__next">@NextLine</p>
            @if (_view.Company is { } company)
            {
                <p class="calendar__tax">@L[WhenToPaySectionText.Company(company), Formats.Euros(company.Surcharge), Formats.Euros(company.More), Day(company.OpenDeadline), _view.IncomeYear]</p>
            }
            <p class="calendar__tax">@L[WhenToPaySectionText.Director(_view.Director), Formats.Euros(_view.Director.Surcharge), Formats.Euros(_view.Director.More), Day(_view.Director.OpenDeadline), _view.IncomeYear]</p>
            <p class="calendar__note">@L["DateNote"]</p>
        </section>

        <CalendarTimeline Calendar="_view.Calendar" NextDate="_view.Next?.Date" />

        <h3 id="calendar-advance-payments" class="calendar__heading">@L["AdvancePayments"]</h3>
        @if (_view.Rows.Count == 0)
        {
            <p class="calendar__note">@L["NoRows", _view.IncomeYear]</p>
        }
        else
        {
            <table class="calendar__table" aria-labelledby="calendar-advance-payments">
                <thead>
                    <tr>
                        <th scope="col">@L["Deadline"]</th>
                        @if (_view.Company is not null)
                        {
                            <th scope="col">@L["TheCompany"]</th>
                        }
                        <th scope="col">@L["You"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _view.Rows)
                    {
                        <tr class="@(row.Past ? "calendar__row--past" : null)">
                            <th scope="row" class="calendar__date">
                                <span>@Formats.Day(row.Date)</span>
                                @if (row.Past)
                                {
                                    <span class="calendar__past">@L["Past"]</span>
                                }
                            </th>
                            @if (_view.Company is not null)
                            {
                                @Cell(row.CompanyPlanned, row.CompanyMore, "CompanyMore")
                            }
                            @Cell(row.DirectorPlanned, row.DirectorMore, "DirectorMore")
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h3 class="calendar__heading">@L["PayHeading"]</h3>
        @foreach (var run in _view.Pay.Runs)
        {
            <p class="calendar__line">@L[WhenToPaySectionText.PayLine(run, _view.Pay.Runs.Count), Formats.Euros(run.GrossPay), Formats.Euros(run.Withholding), Formats.Euros(run.NetPaid), Month(run.First), Month(run.Last)]</p>
        }
        @if (_view.Pay.Left is { } left)
        {
            <p class="calendar__note">@(left.First == left.Last ? L["PayLeftOne", Month(left.First), _view.IncomeYear] : L["PayLeft", Month(left.First), Month(left.Last), _view.IncomeYear])</p>
        }
        @if (_view.Pay.WithheldGiven is { } given)
        {
            <p class="calendar__note">@L["PayWithheldGiven", Formats.Euros(given)]</p>
        }

        <h3 class="calendar__heading">@L["ContributionsHeading"]</h3>
        <p class="calendar__line">@L[WhenToPaySectionText.Contributions(_view.Contributions), Formats.Euros(_view.Contributions.EachQuarter)]</p>
        @if (_view.QuartersLeft > 0)
        {
            <p class="calendar__note">@L["QuartersLeft", _view.QuartersLeft, _view.IncomeYear]</p>
        }
        <div class="calendar__billed">
            <RiverField Label="@L["BilledLabel", _view.IncomeYear]" For="river-billed-contributions"
                        Origin="@(Inputs.BilledContributions.Value is null ? null : Inputs.BilledContributions.Origin)" Help="@L["BilledHint"]">
                <RiverNumericField T="decimal?" InputId="river-billed-contributions" Value="Inputs.BilledContributions.Value" ValueChanged="OnBilledChanged"
                                   Euros="true"
                                   Error="@(_view.BilledRefused is not null)" Refusal="@_view.BilledRefused" />
            </RiverField>
        </div>
        <RefusedMessage Error="@_view.BilledRefused" />
        @if (_view.Contributions.Regularisation is { } regularisation)
        {
            <p class="calendar__line">@L[WhenToPaySectionText.Regularisation(regularisation), Formats.Euros(Math.Abs(regularisation))]</p>
        }

        <h3 class="calendar__heading">@L["AfterHeading"]</h3>
        @if (_view.CompanyBalance is { } companyBalance)
        {
            <p class="calendar__line">@L[WhenToPaySectionText.CompanyBalance(companyBalance.Balance), companyBalance.TaxYear, Formats.Euros(Math.Abs(companyBalance.Balance))]</p>
        }
        <p class="calendar__line">@L[WhenToPaySectionText.DirectorBalance(_view.DirectorBalance.Balance), _view.DirectorBalance.TaxYear, Formats.Euros(Math.Abs(_view.DirectorBalance.Balance))]</p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    // The calendar the page built for this draw (CalendarView.From), none while Netto cannot run the plan or
    // what the fund bills is refused: the section then says so.
    [Parameter]
    public CalendarView? Calendar { get; set; }

    // The river with what the fund bills each quarter, the calendar's one input.
    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    private Task OnBilledChanged(decimal? billed) => InputsChanged.InvokeAsync(Inputs.WithBilledContributions(billed));

    private CalendarView? _view;

    private ElementReference _title;

    protected override void OnParametersSet() => _view = Calendar;

    // Where the focus goes when a link names the section: its heading, which the browser scrolls into view
    // below the band (app.css's scroll-padding-top), as a view's title is.
    public ValueTask FocusAsync() => _title.FocusAsync();

    // The day of the next deadline still open with something to pay, and who pays what by it; or that
    // nothing is left to pay in advance.
    private string? NextLine => _view is null
        ? null
        : L[WhenToPaySectionText.Next(_view.Next), Day(_view.Next?.Date), Formats.Euros(_view.Next?.Company ?? 0m), Formats.Euros(_view.Next?.Director ?? 0m), _view.IncomeYear].Value;

    private static string Day(DateOnly? date) => date is { } day ? Formats.Day(day) : "";

    private static string Month(DateOnly month) => Formats.Month(month.Year, month.Month);

    // What one payer pays by the deadline as the plan stands, and what more by it cancels its
    // surcharge; « nothing » when neither.
    private RenderFragment Cell(decimal planned, decimal more, string moreKey) =>
        @<td class="calendar__cell">
            @if (planned == 0m && more == 0m)
            {
                <span class="calendar__nothing">@L["Nothing"]</span>
            }
            @if (planned > 0m)
            {
                <span class="calendar__amount">@Formats.Euros(planned)</span>
            }
            @if (more > 0m)
            {
                <span class="calendar__more">@L[moreKey, Formats.Euros(more)]</span>
            }
        </td>;
}
