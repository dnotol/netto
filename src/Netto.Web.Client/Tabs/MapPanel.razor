@using Netto.Core.Rules
@using Netto.Core.Simulation
@using Netto.Web.Client.River
@using Netto.Web.Client.River.CompanyCar
@using Netto.Web.Client.River.Copyright
@inject IStringLocalizer<MapPanel> L

@* The room beside My plan's map for the card of the module or the bucket chosen on it: a module's the
   same component as in the river, editable, and every edit goes back to the page's one river, so the bar,
   the map and the card say the same figures at once; a bucket's read-only, saying what fills it (BucketCard).
   While nothing is chosen it says whose card goes there. A card is the module's own; the one line over it
   says what it receives (MapTab), none over a bucket's. The card is pinned open
   (PinnedCard): it has no toggle, it does not read the fold the viewer made in the river nor write one,
   and a refusal on it reveals nothing there; the folds inside it are the viewer's, as in the river. A card that is refused shows the
   engine's refusal on its field, as the river does (Refused). When the viewer chooses a module the card
   takes the focus on its heading; on arriving at the tab with a module already chosen, the tab's own title
   keeps it. Nothing here is a live region: the bar's is the river's only announcement. *@
<div class="map-panel">
    @* The card is the one the panel took a seat for (_shown), as this render saw it: the cascading value
       draws its content in a render of its own, which can come after the choice was let go and before the
       panel draws again without the card, so its content never reads Chosen itself. *@
    @if (_seat is { } seat && _shown is { } shown)
    {
        <CascadingValue Value="seat" IsFixed="true" @key="shown">
            @switch (shown.Module)
            {
                case null when shown.Bucket is { } bucket:
                    <BucketCard Inputs="Inputs" Run="Run" Bucket="@bucket" />
                    break;
                case RiverModule.CompanyYear:
                    <CompanyYearCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                case RiverModule.Vouchers:
                    <VoucherCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                case RiverModule.Allowances:
                    <AllowanceCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                case RiverModule.Rent:
                    <RentCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                case RiverModule.Car:
                    <CarCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                case RiverModule.Split:
                    <SharedCard Inputs="Inputs" Run="Run" />
                    break;
                case RiverModule.Copyright:
                    <CopyrightCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                case RiverModule.DirectorPay:
                    <DirectorPayCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                case RiverModule.Household:
                    <HouseholdCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                case RiverModule.CorporateTax:
                    <CorporateTaxCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                case RiverModule.Dividend:
                    <DividendCard Inputs="Inputs" InputsChanged="InputsChanged" Run="Run" Refused="Refused" />
                    break;
                default:
                    throw new ArgumentOutOfRangeException(nameof(Chosen), shown, "A choice the panel has no card for.");
            }
        </CascadingValue>
    }
    else
    {
        <p class="map-panel__hint">@L["Hint"]</p>
    }
</div>

@code {
    // The module or the bucket chosen on the map, none while nothing is: one the map holds, which the tab
    // resolves.
    [Parameter]
    public MapChoice? Chosen { get; set; }

    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    // The river with an edit made on the card.
    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // Whether the module or the bucket is the viewer's choice, on the map or in the bar, rather than one the
    // page made itself: only then does its card take the focus.
    [Parameter]
    public bool ViewerChose { get; set; }

    // The engine's refusal of a field of this module's card, as the Plan page hands it to that card; none for
    // a bucket's.
    [Parameter]
    public Refusal? Refused { get; set; }

    // The seat of the card shown, new for each module or bucket chosen, and whether the panel has drawn
    // before: one the viewer chooses after that takes the focus to its card; the one chosen when the tab opens
    // does not, the tab's title has the focus then, nor one the page chose itself, a lever just added from
    // « Add to plan », whose focus stays in its panel.
    private PinnedCard? _seat;
    private MapChoice? _shown;
    private bool _drawn;

    protected override void OnParametersSet()
    {
        if (Chosen != _shown)
        {
            _seat = Chosen is null ? null : new PinnedCard(TakesFocus: _drawn && ViewerChose);
            _shown = Chosen;
        }

        _drawn = true;
    }
}
