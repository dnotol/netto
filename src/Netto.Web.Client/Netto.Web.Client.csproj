<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- TargetFramework, ImplicitUsings, Nullable, LangVersion come from ..\..\Directory.Build.props -->

  <!-- The site is English only and Formats is built on the invariant culture, so the browser downloads no
       ICU data (about 0.2 MB compressed for each visitor, 0.6 MB for the three files together). A
       translation turns this off (ClientGlobalizationTests). -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="MudBlazor" />
    <ProjectReference Include="..\Netto.Core\Netto.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Netto.Tests.Unit" />
  </ItemGroup>

</Project>
