@page "/plan"
@page "/plan/{Tab}"
@using Netto.Core.Simulation
@using Netto.Web.Client.River
@using Netto.Web.Client.River.CompanyCar
@using Netto.Web.Client.River.Copyright
@using Netto.Web.Client.Tabs
@inject IStringLocalizer<Plan> L
@inject RiverState State
@inject SavedPlans Plans
@inject TimeProvider Clock
@inject Folds Folds
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@L[PlanText.PageTitle(_tab)]</PageTitle>

@* The keyboard's first stop from the top of the page, before the site header (MainLayout): it moves
   the focus to the start of the tab's content, on the river to its first card, past the header's
   links and the bar of buckets with its tabs, which stay in sight above. Blazor would take a link to a
   fragment for a navigation, so the link moves the focus itself. On arriving, Blazor puts the focus on
   the page's title (Routes, FocusOnNavigate), after the link, and so does a switch of tab (TabHead). *@
<SectionContent SectionName="@MainLayout.SkipLinkSection">
    <a href="@SkipHref" class="skip-link" @onclick="SkipAsync" @onclick:preventDefault>@L[PlanText.SkipTo(_tab)]</a>
</SectionContent>

@* The plan page, split by purpose into tabs under the bar of buckets, which sums up the river on every
   one of them: the river itself (Plan), the moves Netto proposes from the plan starred « Today »
   (Optimisation), when the plan's payments fall (When to pay) and the saved plans side by side (Compare
   plans). Each tab has its own URL (PlanTabRoutes) but they are this one page, so the river's inputs,
   its run and what the page found stay as they are from one tab to the next, and Blazor keeps the page
   when the tab changes: the tab is a parameter of the route.

   The river: the year from the company's revenue to the director's pocket, as module cards that each
   edit their part of one scenario and draw their view of one run. Every figure comes from Netto.Core;
   the page only holds the inputs and runs them. The optional modules show only while in the plan,
   which the Composition menu in the bar sets; taking one out, there or from its card, shows a notice
   with Undo, on any tab. The levers run before the split, but the copyright royalty, which the split
   pays beside the pay: its card heads the director's stream. On a wide screen the river's outline
   stands left of the cards (RiverOutline), before them in the page: the cards tell it what they are as
   they are drawn, through the page's OutlineRows handed down to them. The address may name a card
   (CardLinks, plan?card=<name>), from a link of the Optimisation tab's moves or loaded as it is: the river
   opens it as choosing its row in the outline does, and brings it under the bar with its heading focused. *@
<BucketBar Run="_run" Setup="_today?.Run" Unsaved="Plans.HasUnsavedChanges(_inputs)">
    <ChildContent>
        <PlansPanel Inputs="_inputs" CanSave="BaselineGain.CanMark(_run)" OnOpen="OnInputsChanged" OnChanged="OnPlansChanged" />
        <CompositionMenu @ref="_composition" Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" />
    </ChildContent>
    <TabRow>
        <PlanTabBar Current="_tab" Badges="Badges()" />
    </TabRow>
</BucketBar>
<TakenOutNotice @ref="_notice" Module="_takenOut" OnUndo="Undo" OnDismiss="Dismiss" />

@if (_tab != PlanTab.Plan)
{
    <section id="@TabContentId" class="plan-tab" tabindex="-1" @ref="_tabContent">
        <MudContainer MaxWidth="MaxWidth.Large">
            @switch (_tab)
            {
                case PlanTab.Optimisation:
                    <OptimisationTab From="@(Plans.TodayPlan?.Inputs is { } today ? MovesBaseline.Today(today) : null)" Found="FoundMoves()" Inputs="_inputs" InputsChanged="OnInputsChanged" />
                    break;
                case PlanTab.WhenToPay:
                    <WhenToPayTab Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Date="Today" />
                    break;
                case PlanTab.Compare:
                    <CompareTab PlansChanged="OnPlansChanged" />
                    break;
            }
        </MudContainer>
    </section>
}
else
{
    <section class="river">
        <MudContainer MaxWidth="MaxWidth.Large">
            <TabHead Eyebrow="@L["Eyebrow"]" Title="@L["Title"]" Lede="@L["Lede"]" />

            <RefusedMessage Error="@Refused(RiverModule.River)" />

            <CascadingValue Value="_outline" IsFixed="true">
                <div class="river__body">
                    <RiverOutline />
                    <div id="river" class="river__flow" tabindex="-1" @ref="_river">
                        <CompanyYearCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.CompanyYear)" />
                        @if (_inputs.Composition.Count == 0)
                        {
                            <p class="river__add">
                                @L["AddHint"]
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="OpenComposition">@L["AddHintButton"]</MudButton>
                            </p>
                        }
                        @if (_inputs.InPlan(OptionalModule.Vouchers))
                        {
                            <VoucherCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Vouchers)" />
                        }
                        @if (_inputs.InPlan(OptionalModule.Allowances))
                        {
                            <AllowanceCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Allowances)" />
                        }
                        @if (_inputs.InPlan(OptionalModule.Rent))
                        {
                            <RentCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Rent)" />
                        }
                        @if (_inputs.InPlan(OptionalModule.Car))
                        {
                            <CarCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Car)" />
                        }
                        @if (_inputs.Company is not null)
                        {
                            <SplitCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Search="_search" Refused="@Refused(RiverModule.Split)" />
                            <p class="river__fork" aria-hidden="true">@L[PlanText.Fork(_inputs.InPlan(OptionalModule.Copyright))]</p>
                        }
                        <div class="river__streams">
                            <div class="river__stream">
                                @if (_inputs.InPlan(OptionalModule.Copyright))
                                {
                                    <CopyrightCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Copyright)" />
                                }
                                <DirectorPayCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.DirectorPay)" />
                            </div>
                            <div class="river__stream">
                                <CorporateTaxCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.CorporateTax)" />
                                <DividendCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Dividend)" />
                            </div>
                        </div>
                    </div>
                </div>
            </CascadingValue>

            <aside class="assumed" aria-labelledby="assumed-title">
                <Fold Name="@PlanText.AssumedFold" Title="@L[PlanText.AssumedTitle]" TitleId="assumed-title"
                      Summary="@L[PlanText.AssumedSummary, PlanText.Assumptions.Count]">
                    <ul class="assumed__list">
                        @foreach (var key in PlanText.Assumptions)
                        {
                            <li>@L[key]</li>
                        }
                    </ul>
                </Fold>
            </aside>

            <aside class="limits" aria-labelledby="limits-title">
                <Fold Name="@PlanText.LimitsFold" Title="@L[PlanText.LimitsTitle]" TitleId="limits-title"
                      Summary="@L[PlanText.LimitsSummary, PlanText.Limits.Count]">
                    <ul class="limits__list">
                        @foreach (var key in PlanText.Limits)
                        {
                            <li>@L[key]</li>
                        }
                    </ul>
                    <p class="limits__note">@L[PlanText.LimitTaxCalcNote]</p>
                </Fold>
            </aside>
        </MudContainer>
    </section>
}

@code {
    // Where the skip link sends the focus on a tab other than the river.
    private const string TabContentId = "tab-content";

    // The URL's segment after /plan/, naming the tab; none for the river (PlanTabRoutes).
    [Parameter]
    public string? Tab { get; set; }

    // The card a link from another tab names for the river to open on arrival, by its fold's name
    // (CardLinks); none for the river alone.
    [SupplyParameterFromQuery(Name = CardLinks.Query)]
    public string? Card { get; set; }

    private PlanTab _tab;
    private RiverInputs _inputs = default!;
    private OutlineRows _outline = default!;
    private RiverRun _run = default!;
    private SplitSearchResult? _search;
    private (string Id, RiverRun Run)? _today;
    private RiverInputs? _searched;
    private CompositionMenu _composition = default!;
    private TakenOutNotice _notice = default!;
    private ElementReference _river;
    private ElementReference _tabContent;
    private OptionalModule? _takenOut;
    private bool _focusUndo;
    private bool _focusComposition;
    private (MovePlan? Value, string? Error)? _moves;
    private RiverInputs? _movesFor;
    private DateOnly _movesOn;
    private bool _movesFound;
    private readonly CardArrival _arrival = new();
    private string? _arriving;

    protected override void OnInitialized()
    {
        _outline = new OutlineRows(Folds);
        OnPlansChanged();
        Show(State.Inputs);
    }

    // The tab the URL names, on arriving and at each switch of tab, the page staying the same; a segment
    // Netto has no tab for is a page it does not have. On the river, the card the URL names, once per
    // arrival (CardArrival).
    protected override void OnParametersSet()
    {
        if (PlanTabRoutes.From(Tab) is { } tab)
            _tab = tab;
        else
            Navigation.NotFound();

        _arriving = _arrival.Take(_tab, Card);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The river is drawn, and its cards listed in the outline: the card arrived at opens as the
        // viewer's fold, as choosing its row does, and the script brings it under the bar and focuses its
        // heading once Blazor has reset the scroll after the link and the tab's head has taken the focus
        // (river-outline.js, arrive). A card the river does not show, a lever out of the plan, is left
        // alone.
        if (_arriving is { } card)
        {
            _arriving = null;
            if (_outline.Arrive(card))
                await JS.InvokeVoidAsync("nettoOutline.arrive", card);
        }

        if (_focusUndo)
        {
            _focusUndo = false;
            await _notice.FocusUndoAsync();
        }

        if (_focusComposition)
        {
            _focusComposition = false;
            await _composition.FocusButtonAsync();
        }
    }

    // A module taken out shows the notice. Taken out from its card, the word that did it is gone with
    // the card, so the focus goes to Undo; from the open menu, it stays on the menu's checkbox.
    private void OnInputsChanged(RiverInputs inputs)
    {
        var takenOut = inputs.Composition.TakenOutSince(_inputs.Composition);
        _takenOut = RemovalNotice.About(_takenOut, _inputs.Composition, inputs.Composition);
        _focusUndo = takenOut is not null && !_composition.IsOpen;
        State.Inputs = inputs;
        Show(inputs);
    }

    private void OpenComposition() => _composition.Open();

    // The plan starred « Today » runs once, again only when the star moves to another plan.
    private void OnPlansChanged()
    {
        if (_today?.Id != Plans.Today)
            _today = Plans.TodayPlan is { Inputs: { } inputs } today ? (today.Id, inputs.Run()) : null;
    }

    // The next Tab goes on to the first card's heading, or on another tab to the first control of its
    // content.
    private async Task SkipAsync() => await (_tab == PlanTab.Plan ? _river : _tabContent).FocusAsync();

    private string SkipHref => $"{PlanTabRoutes.Href(_tab)}#{(_tab == PlanTab.Plan ? "river" : TabContentId)}";

    // Undo and Dismiss leave with the notice, so the focus goes to the Composition button, just before
    // it, where the plan's modules are set.
    private void Undo()
    {
        if (_takenOut is { } module)
            OnInputsChanged(_inputs.AddToPlan(module));

        _focusComposition = true;
    }

    private void Dismiss()
    {
        _takenOut = null;
        _focusComposition = true;
    }

    // The split's search runs the year at every pay, so it runs again only when an input other than
    // the pay changes: dragging the pay moves its marker along the same curve.
    private void Show(RiverInputs inputs)
    {
        _inputs = inputs;
        _run = inputs.Run();
        if (_searched is null || !inputs.SameBesidesPay(_searched))
        {
            _search = inputs.SearchSplit();
            _searched = inputs;
        }
    }

    // The moves from the plan starred « Today », found once per Today and date, since the search runs the
    // split at every move: the Optimisation tab draws them, and its badge needs them on every tab.
    private (MovePlan? Value, string? Error)? FoundMoves()
    {
        var today = Plans.TodayPlan?.Inputs;
        var date = Today;
        if (_movesFound && today == _movesFor && date == _movesOn)
            return _moves;

        _moves = today?.FindMoves(date);
        _movesFor = today;
        _movesOn = date;
        _movesFound = true;
        return _moves;
    }

    // What each tab says after its name, from what its content draws.
    private IReadOnlyDictionary<PlanTab, TabBadge> Badges() =>
        TabBadges.Of(_run, MovesView.Of(Plans.TodayPlan?.Inputs, FoundMoves()), CalendarView.From(_inputs, _run, Today), Plans.Plans.Count(plan => plan.Readable));

    // The browser's date, which decides which deadlines are past and which one a payment is proposed by.
    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    // The engine's refusal goes to the card holding the refused field, and only there.
    private string? Refused(RiverModule module) =>
        _run.Error is { } error && RiverErrors.Owner(error, _inputs.Company is null) == module ? error : null;
}
