@page "/plan"
@page "/plan/{Tab}"
@using Netto.Core.Rules
@using Netto.Core.Simulation
@using Netto.Web.Client.River
@using Netto.Web.Client.River.CompanyCar
@using Netto.Web.Client.River.Copyright
@using Netto.Web.Client.Tabs
@inject IStringLocalizer<Plan> L
@inject RiverState State
@inject SavedPlans Plans
@inject TimeProvider Clock

@inject NavigationManager Navigation
@inject IJSRuntime JS

@* A bookmark to My plan read by date (/plan?by=date) replaces itself with the When to pay section of Optimise
   (OnParametersSet): until the browser has gone there the page draws nothing, not a map it is leaving. *@
@if (_redirecting)
{
    return;
}

<PageTitle>@L[PlanText.PageTitle(_tab)]</PageTitle>

@* The keyboard's first stop from the top of the page, before the band at its top (BucketBar, in the site
   header's place): it moves the focus to the start of the tab's content, past the band's wordmark, tabs,
   buttons and buckets, which stay in sight above. Blazor would take a link to a fragment for a navigation,
   so the link moves the focus itself. On arriving, Blazor puts the focus on the page's title (Routes,
   FocusOnNavigate), after the link, and so does a switch of view (TabHead). *@
<SectionContent SectionName="@MainLayout.SkipLinkSection">
    <a href="@SkipHref" class="skip-link" @onclick="SkipAsync" @onclick:preventDefault>@L[PlanText.SkipTo(_tab)]</a>
</SectionContent>

@* The plan page, three views each answering one question (docs/architecture/decisions/2026-11-11-three-views-one-question-each.md),
   in the top row of the band (BucketBar), which sums up the river on every one of them: My plan, where I
   stand, the river's modules from above with the money between them and the card of the module chosen
   beside them, where it is edited (MapTab); Optimise, the moves Netto proposes from the plan on screen,
   retuning only the levers it holds, then when the plan's payments fall, a section named by a query,
   ?show=when (OptimisationTab, WhenToPaySection); and Ideas, what could be added (Pistes). My plan
   suggests nothing: the other two appear in it only as the tabs' badges and one line of nudges
   (PlanNudges). Comparing two saved plans is a mode of the Plans panel, in the band. Each view has its own
   URL (PlanTabRoutes) but they are this one page, so the river's inputs, its run, what the page found and
   the module chosen stay as they are from one view to the next, and Blazor keeps the page when the view
   changes: the view is a parameter of the route, the section, the card and the Plans panel's mode queries.
   The old addresses of When to pay (/plan/when-to-pay, /plan?by=date) and Compare plans replace themselves
   with their new place (PlanMoved, OnParametersSet).

   The river: the year from the company's revenue to the director's pocket, as modules that each edit their
   part of one scenario on their card and draw their view of one run. Every figure comes from Netto.Core;
   the page only holds the inputs and runs them. The optional modules are on the map only while in the
   plan, which « Add to plan » sets, among the map's tools (CompositionMenu, which the page hands the map,
   so that it keeps hold of it); taking one out, there or from its card, shows a notice with Undo, which
   outlives a switch of tab, and adding one chooses it, so its card opens beside the map to be filled. The
   choice on the map, a module or a bucket (MapChoice), is Company year on arriving, or the one the address
   names (CardLinks, plan?card=<name>), from a link of the Optimise view's moves or loaded as it is, or the
   bucket the viewer presses in the band, from any view, which brings them to My plan. *@
@* The moves and the ideas found for the plan on screen, each built once per draw, for the badges, My plan's
   nudges and the views alike. *@
@{
    var moves = _moves.View(Today);
    var pistes = _pistes.View(Today);
    var calendar = CalendarView.From(_inputs, _run, Today);
}
<BucketBar Run="_run" Setup="_today?.Run" BucketChosen="OnBucketChosen">
    <ChildContent>
        <PlansPanel Inputs="_inputs" CanSave="BaselineGain.CanMark(_run)" OnOpen="OnPlanOpened" OnChanged="OnPlansChanged" OpenOnCompare="PlanTabRoutes.OpensCompare(PlansMode)" />
    </ChildContent>
    <Tabs>
        <PlanTabBar Current="_tab" Badges="Badges(moves, calendar, pistes)" DeadlineChosen="OnDeadlineChosen" />
    </Tabs>
</BucketBar>
<TakenOutNotice @ref="_notice" Module="_takenOut" OnUndo="Undo" OnDismiss="Dismiss" />

<section id="@TabContentId" class="plan-tab" tabindex="-1" @ref="_tabContent">
    @* The site's column (app.css), as the band above takes it, so the tab and the band share their edges. *@
    <MudContainer MaxWidth="MaxWidth.False" Class="netto-column plan-tab__column">
        @switch (_tab)
        {
            case PlanTab.Plan:
                @* My plan's head, the page's one h1 there, is drawn by the page, so that a change of what its content draws
                   keeps the focus where the viewer is and only arriving at the view moves it to the title (TabHead). *@
                <TabHead Title="@L[PlanText.MyPlanTitle]" Focus="@(!PlanTabRoutes.OpensCompare(PlansMode))" />
                <PlanNudges Gain="NudgeGain(moves)" Pistes="PistesFound(pistes)" />
                <MapTab Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" RefusedBy="Refused" Chosen="_mapChosen" ChosenChanged="OnMapChosen" ViewerChose="_viewerChose">
                    <AddToPlan>
                        <CompositionMenu @ref="_composition" Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" />
                    </AddToPlan>
                </MapTab>

                <aside class="assumed" aria-labelledby="assumed-title">
                    <Fold Name="@PlanText.AssumedFold" Title="@L[PlanText.AssumedTitle]" TitleId="assumed-title"
                          Summary="@L[PlanText.AssumedSummary, PlanText.Assumptions.Count]">
                        <ul class="assumed__list">
                            @foreach (var key in PlanText.Assumptions)
                            {
                                <li>@L[key]</li>
                            }
                        </ul>
                    </Fold>
                </aside>

                <aside class="limits" aria-labelledby="limits-title">
                    <Fold Name="@PlanText.LimitsFold" Title="@L[PlanText.LimitsTitle]" TitleId="limits-title"
                          Summary="@L[PlanText.LimitsSummary, PlanText.Limits.Count]">
                        <ul class="limits__list">
                            @foreach (var key in PlanText.Limits)
                            {
                                <li>@L[key]</li>
                            }
                        </ul>
                        <p class="limits__note">@L[PlanText.LimitTaxCalcNote]</p>
                    </Fold>
                </aside>
                break;
            case PlanTab.Optimisation:
                <OptimisationTab @ref="_optimisation" Searching="_moves.Searching(Today)" Found="_moves.Found(Today)" Inputs="_inputs" InputsChanged="OnInputsChanged" Search="_search"
                                 Calendar="calendar" OpensCalendar="PlanTabRoutes.OpensWhenToPay(ShowSection)" />
                break;
            case PlanTab.Pistes:
                <PistesTab View="pistes" Answered="_pistes.Answer" Tried="OnPisteTried" Dropped="_pistes.Drop" Kept="OnPisteKept" />
                break;
        }
    </MudContainer>
</section>

@code {
    // Where the skip link sends the focus.
    private const string TabContentId = "tab-content";

    // The URL's segment after /plan/, naming the tab; none for My plan (PlanTabRoutes).
    [Parameter]
    public string? Tab { get; set; }

    // The lens My plan was once read through, /plan?by=date, before When to pay became a section of Optimise: a
    // bookmark to it replaces itself with the section (PlanTabRoutes.MovedFromLens).
    [SupplyParameterFromQuery(Name = PlanTabRoutes.LegacyLensQuery)]
    public string? By { get; set; }

    // The section of the Optimise view the address asks for, /plan/optimisation?show=when
    // (PlanTabRoutes.OpensWhenToPay): the page brings it into focus once per arrival (SectionArrival).
    [SupplyParameterFromQuery(Name = PlanTabRoutes.ShowQuery)]
    public string? ShowSection { get; set; }

    // What the address asks the Plans panel to open on, /plan?plans=compare, where Compare plans' old address
    // goes (PlanTabRoutes.Moved).
    [SupplyParameterFromQuery(Name = PlanTabRoutes.PlansQuery)]
    public string? PlansMode { get; set; }

    // The card a link from another tab names, by its fold's name or its bucket's key (CardLinks): its module
    // or its bucket is chosen on the map on arrival. None for the plan alone.
    [SupplyParameterFromQuery(Name = CardLinks.Query)]
    public string? Card { get; set; }

    private PlanTab _tab;
    private bool _redirecting;
    private RiverInputs _inputs = default!;
    private RiverRun _run = default!;
    private SplitSearchResult? _search;
    private (string Id, RiverRun Run)? _today;
    private RiverInputs? _searched;
    // « Add to plan », while My plan draws the map: a reference Blazor keeps once the map has gone, so it is
    // read there alone (AddToPlan).
    private CompositionMenu? _composition;
    // The Optimise view, while it is drawn: a reference Blazor keeps once it has gone, read only on Optimise.
    private OptimisationTab? _optimisation;
    private TakenOutNotice _notice = default!;
    private ElementReference _tabContent;
    private OptionalModule? _takenOut;
    private bool _focusUndo;
    private bool _focusComposition;
    private MovesSource _moves = default!;
    private PistesSource _pistes = default!;
    private readonly CardArrival _arrival = new();
    private readonly SectionArrival _sectionArrival = new();
    // The When to pay section is to take the focus at the next render.
    private bool _focusCalendar;
    private MapChoice? _mapChosen = MapChoice.Of(RiverModule.CompanyYear);
    private bool _viewerChose;

    protected override void OnInitialized()
    {
        _moves = new MovesSource(() => _inputs, () => new ValueTask(Task.Delay(MovesSource.QuietPeriod, Clock)));
        _pistes = new PistesSource(() => _inputs, date => _moves.Found(date));
        OnPlansChanged();
        Show(State.Inputs);
    }

    // The view the URL names, on arriving and at each switch, the page staying the same; a segment Netto has no
    // view for is a page it does not have, and My plan by date, which no longer exists, goes to the section that
    // holds what it showed. On the map, the card the URL names, once per arrival (CardArrival), has its module
    // chosen on the map, or its bucket. On Optimise, the section the URL names, once per arrival
    // (SectionArrival), takes the focus.
    protected override void OnParametersSet()
    {
        if (PlanTabRoutes.From(Tab) is { } tab)
            _tab = tab;
        else
            Navigation.NotFound();

        _redirecting = _tab == PlanTab.Plan && PlanTabRoutes.MovedFromLens(By) is not null;
        if (_redirecting)
        {
            Navigation.NavigateTo(PlanTabRoutes.MovedFromLens(By)!, replace: true);
            return;
        }

        SearchSplitForOptimisation();
        if (_arrival.Take(_tab, Card) is { } card && MapChoice.Named(card, MapView.ModulesOf(_inputs)) is { } named)
            (_mapChosen, _viewerChose) = (named, false);
        if (_sectionArrival.Take(_tab, ShowSection))
            _focusCalendar = true;
        else if (_tab != PlanTab.Optimisation)
            _focusCalendar = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusUndo)
        {
            _focusUndo = false;
            await _notice.FocusUndoAsync();
        }

        if (_focusCalendar)
        {
            _focusCalendar = false;
            if (_tab == PlanTab.Optimisation && _optimisation is { } optimisation)
                await optimisation.FocusCalendarAsync();
        }

        if (_focusComposition)
        {
            _focusComposition = false;
            if (RemovalNoticeFocus.After(_tab) == RemovalFocus.AddToPlan && AddToPlan is { } menu)
                await menu.FocusButtonAsync();
            else
                await _tabContent.FocusAsync();
        }

        // The moves' search runs the year a thousand times or more on the page's one thread, so it waits
        // until the browser has painted what the page drew, the bar, the river and Optimisation saying it
        // looks for them (plan-paint.js), and off Optimisation for the edits to pause, then the page draws
        // what it found for the plan on screen (MovesSource).
        if (await _moves.SearchOncePaintedAsync(Today, _tab == PlanTab.Optimisation, () => JS.InvokeVoidAsync("nettoPaint.after")))
        {
            StateHasChanged();
            return;
        }

        // Then the ideas, measured against what the Optimiser found: each costs about a search of the moves,
        // so one is measured per paint, the page drawing what it found before the next (PistesSource).
        if (await _pistes.SearchNextOncePaintedAsync(Today, () => JS.InvokeVoidAsync("nettoPaint.after")))
            StateHasChanged();
    }

    // « Try » on an idea: measured once the browser has painted, unless found already; the river stays as it is.
    private void OnPisteTried(LeverKind lever) => _pistes.Try(lever);

    // « Keep »: the river with the lever, its answers and its own moves' values, the page's one edit, which
    // chooses the lever added as any lever just added is; nothing while the idea is not measured as it stands.
    private void OnPisteKept(LeverKind lever)
    {
        if (_pistes.Keep(lever, Today) is { } river)
            OnInputsChanged(river);
    }

    // A module taken out shows the notice. Taken out from its card, the word that did it is gone with
    // the card, so the focus goes to Undo; from the open menu, it stays on the menu's checkbox. A lever
    // added, from the menu or by a move applied, is chosen, so its card opens beside the map to be filled;
    // one Undo brings back is as it was, unchosen.
    private void OnInputsChanged(RiverInputs inputs)
    {
        var takenOut = inputs.Composition.TakenOutSince(_inputs.Composition);
        if (ModuleFolds.Added(_inputs.Composition, inputs.Composition) is [.., var added] && added != _takenOut)
            (_mapChosen, _viewerChose) = (MapChoice.Of(MapModules.Of(added)), false);
        _takenOut = RemovalNotice.About(_takenOut, _inputs.Composition, inputs.Composition);
        _focusUndo = takenOut is not null && AddToPlan is not { IsOpen: true };
        State.Inputs = inputs;
        Show(inputs);
    }

    // A plan opened from Plans: the river shows it. It replaces the river and is no edit of it, so no module
    // was taken out: a notice would speak of a river that is gone, its Undo would add the module to the plan
    // just opened and leave it with unsaved changes, and one already showing goes with the river it was
    // about. Nothing takes the focus to Undo, so it stays where Plans left it.
    private void OnPlanOpened(RiverInputs plan)
    {
        _takenOut = null;
        State.Inputs = plan;
        Show(plan);
    }

    // The plan starred « Today » runs once, again only when the star moves to another plan: it feeds the
    // band's gain alone, the moves being measured from the plan on screen.
    private void OnPlansChanged()
    {
        if (_today?.Id != Plans.Today)
            _today = Plans.TodayPlan is { Inputs: { } inputs } today ? (today.Id, inputs.Run()) : null;
    }

    // The next Tab goes on to the first control of the view's content.
    private async Task SkipAsync() => await _tabContent.FocusAsync();

    private string SkipHref => $"{PlanTabRoutes.Href(_tab)}#{TabContentId}";

    // The tab's deadline badge followed: on the section's own address nothing changes under the page, so the
    // focus is asked for here too (the address of another view brings it by arrival).
    private void OnDeadlineChosen() => _focusCalendar = true;

    // Undo and Dismiss leave with the notice, so the focus goes where the plan's modules are set, « Add to
    // plan », or to the start of the view's content where it is not drawn (RemovalNoticeFocus).
    private void Undo()
    {
        if (_takenOut is { } module)
            OnInputsChanged(_inputs.AddToPlan(module));

        _focusComposition = true;
    }

    private void Dismiss()
    {
        _takenOut = null;
        _focusComposition = true;
    }

    // The module or the bucket the viewer chose on the map, kept from one tab to the next, a module let go
    // once it has left the map.
    private void OnMapChosen(MapChoice? choice) => (_mapChosen, _viewerChose) = (choice, true);

    // A bucket the viewer pressed in the band: chosen on the map, as the viewer's choice, whatever was; from
    // another view, which draws no map, the page goes to My plan, where the map's panel draws the bucket's
    // card for the first time (MapPanel), and the title takes the focus. An action, never a toggle: pressed
    // again, it stays.
    private void OnBucketChosen(string bucket)
    {
        (_mapChosen, _viewerChose) = (MapChoice.InBucket(bucket), true);
        if (!OnTheMap)
            Navigation.NavigateTo(PlanTabRoutes.Href(PlanTab.Plan));
    }

    // The split's search runs the year at every pay, so it runs again only when an input other than
    // the pay changes: dragging the pay moves its marker along the same curve. A module chosen on the map
    // that the river no longer draws, a lever taken out of the plan, is chosen no more; a bucket, always on
    // the map, stays chosen.
    private void Show(RiverInputs inputs)
    {
        _inputs = inputs;
        _run = inputs.Run();
        if (_mapChosen?.Module is { } chosen && !MapView.ModulesOf(inputs).Contains(chosen))
            _mapChosen = null;
        SearchSplitForOptimisation();
    }

    // Only the Optimise view reads the split's search (its pay curve and its note on the best pay), so the
    // other views run none: on arriving at Optimise, the search is made if the plan on screen differs besides
    // its pay from the one the search found was made for, which an edit of the pay alone never does.
    private void SearchSplitForOptimisation()
    {
        if (_tab != PlanTab.Optimisation)
            return;

        if (_searched is null || !_inputs.SameBesidesPay(_searched))
        {
            _search = _inputs.SearchSplit();
            _searched = _inputs;
        }
    }

    // What each tab says after its name, from what its content draws: the Optimise view's moves, which
    // its badge and My plan's nudge need on every view, found once per plan on screen and date (MovesSource),
    // since the search runs the split at every move, and only after the page has painted: until then the
    // badge says they are being looked for. My plan's own is the next deadline.
    // The Ideas badge says « … » while an idea is still measured, as Optimise's does for the moves.
    private IReadOnlyDictionary<PlanTab, IReadOnlyList<TabBadge>> Badges(MovesView moves, CalendarView? calendar, PistesView pistes) =>
        TabBadges.Of(_run, moves, calendar, PistesFound(pistes), pistes.Searching);

    // The ideas found for the plan on screen, for the Ideas badge and My plan's nudge: how many are priced and
    // how many still ask, none while one is still measured, so no count changes once it is found.
    private static PistesCount? PistesFound(PistesView view) => view is { Searching: false } ? new PistesCount(view.Priced, view.Questions) : null;

    // What the moves add to the plan on screen, for My plan's nudge: the Optimisation badge's own amount, so
    // none while they are looked for or there are none.
    private static decimal? NudgeGain(MovesView moves) => moves is { State: MovesState.Moves } ? moves.Total : null;

    // Whether the map, and its tools, are what the page draws: My plan.
    private bool OnTheMap => _tab == PlanTab.Plan;

    // « Add to plan » as the map draws it, none anywhere else.
    private CompositionMenu? AddToPlan => OnTheMap ? _composition : null;

    // The browser's date, which decides which deadlines are past and which one a payment is proposed by.
    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    // The engine's refusal goes to the card holding the refused field, and only there.
    private Refusal? Refused(RiverModule module) =>
        _run.Error is { } error && RiverErrors.Owner(error) == module ? error : null;
}
