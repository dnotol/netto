@page "/plan"
@using Netto.Core.Simulation
@using Netto.Web.Client.River
@using Netto.Web.Client.River.CompanyCar
@using Netto.Web.Client.River.Copyright
@inject IStringLocalizer<Plan> L
@inject RiverState State
@inject SavedPlans Plans
@inject TimeProvider Clock

<PageTitle>@L["PageTitle"]</PageTitle>

@* The keyboard's first stop from the top of the page, before the site header (MainLayout): it moves
   the focus to the start of the river, so the next Tab lands on its first card, past the header's
   links and the bar of buckets, which stays in sight above. Blazor would take a link to a fragment
   for a navigation, so the link moves the focus itself. On arriving, Blazor puts the focus on the
   page's title (Routes, FocusOnNavigate), after the link. *@
<SectionContent SectionName="@MainLayout.SkipLinkSection">
    <a href="plan#river" class="skip-link" @onclick="SkipToRiverAsync" @onclick:preventDefault>@L[PlanText.SkipToRiver]</a>
</SectionContent>

@* The river: the year from the company's revenue to the director's pocket, as module cards that each
   edit their part of one scenario and draw their view of one run, under the bar of buckets that sums
   it up. Every figure comes from Netto.Core; the page only holds the inputs and runs them. The
   optional modules show only while in the plan, which the Composition menu in the bar sets; taking
   one out, there or from its card, shows a notice with Undo. The levers run before the split, but the
   copyright royalty, which the split pays beside the pay: its card heads the director's stream. *@
<BucketBar Run="_run" Setup="_today?.Run" Unsaved="Plans.HasUnsavedChanges(_inputs)">
    <PlansPanel Inputs="_inputs" CanSave="BaselineGain.CanMark(_run)" OnOpen="OnInputsChanged" OnChanged="OnPlansChanged" />
    <CompositionMenu @ref="_composition" Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" />
</BucketBar>
<TakenOutNotice @ref="_notice" Module="_takenOut" OnUndo="Undo" OnDismiss="Dismiss" />

<section class="river">
    <MudContainer MaxWidth="MaxWidth.Large">
        <header class="river__head">
            <div class="river__eyebrow-row">
                <p class="river__eyebrow">@L["Eyebrow"]</p>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">@L["Badge"]</MudChip>
            </div>
            <MudText Typo="Typo.h2" HtmlTag="h1" Class="river__title">@L["Title"]</MudText>
            <p class="river__lede">@L["Lede"]</p>
        </header>

        <RefusedMessage Error="@Refused(RiverModule.River)" />

        <div id="river" class="river__flow" tabindex="-1" @ref="_river">
            <MovesCard Today="Plans.TodayPlan?.Inputs" Date="Today" Inputs="_inputs" InputsChanged="OnInputsChanged" />
            <CompanyYearCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.CompanyYear)" />
            @if (_inputs.Composition.Count == 0)
            {
                <p class="river__add">
                    @L["AddHint"]
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="OpenComposition">@L["AddHintButton"]</MudButton>
                </p>
            }
            @if (_inputs.InPlan(OptionalModule.Vouchers))
            {
                <VoucherCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Vouchers)" />
            }
            @if (_inputs.InPlan(OptionalModule.Allowances))
            {
                <AllowanceCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Allowances)" />
            }
            @if (_inputs.InPlan(OptionalModule.Rent))
            {
                <RentCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Rent)" />
            }
            @if (_inputs.InPlan(OptionalModule.Car))
            {
                <CarCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Car)" />
            }
            @if (_inputs.Company is not null)
            {
                <SplitCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Search="_search" Refused="@Refused(RiverModule.Split)" />
                <p class="river__fork" aria-hidden="true">@L[PlanText.Fork(_inputs.InPlan(OptionalModule.Copyright))]</p>
            }
            <div class="river__streams">
                <div class="river__stream">
                    @if (_inputs.InPlan(OptionalModule.Copyright))
                    {
                        <CopyrightCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Copyright)" />
                    }
                    <DirectorPayCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.DirectorPay)" />
                </div>
                <div class="river__stream">
                    <CorporateTaxCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.CorporateTax)" />
                    <DividendCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Refused="@Refused(RiverModule.Dividend)" />
                </div>
            </div>
            <CalendarCard Inputs="_inputs" InputsChanged="OnInputsChanged" Run="_run" Date="Today" />
        </div>

        <aside class="assumed" aria-labelledby="assumed-title">
            <Fold Name="@PlanText.AssumedFold" Title="@L[PlanText.AssumedTitle]" TitleId="assumed-title"
                  Summary="@L[PlanText.AssumedSummary, PlanText.Assumptions.Count]">
                <ul class="assumed__list">
                    @foreach (var key in PlanText.Assumptions)
                    {
                        <li>@L[key]</li>
                    }
                </ul>
            </Fold>
        </aside>

        <aside class="limits" aria-labelledby="limits-title">
            <Fold Name="@PlanText.LimitsFold" Title="@L[PlanText.LimitsTitle]" TitleId="limits-title"
                  Summary="@L[PlanText.LimitsSummary, PlanText.Limits.Count]">
                <ul class="limits__list">
                    @foreach (var key in PlanText.Limits)
                    {
                        <li>@L[key]</li>
                    }
                </ul>
                <p class="limits__note">@L[PlanText.LimitTaxCalcNote]</p>
            </Fold>
        </aside>
    </MudContainer>
</section>

@code {
    private RiverInputs _inputs = default!;
    private RiverRun _run = default!;
    private SplitSearchResult? _search;
    private (string Id, RiverRun Run)? _today;
    private RiverInputs? _searched;
    private CompositionMenu _composition = default!;
    private TakenOutNotice _notice = default!;
    private ElementReference _river;
    private OptionalModule? _takenOut;
    private bool _focusUndo;
    private bool _focusComposition;

    protected override void OnInitialized()
    {
        OnPlansChanged();
        Show(State.Inputs);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusUndo)
        {
            _focusUndo = false;
            await _notice.FocusUndoAsync();
        }

        if (_focusComposition)
        {
            _focusComposition = false;
            await _composition.FocusButtonAsync();
        }
    }

    // A module taken out shows the notice. Taken out from its card, the word that did it is gone with
    // the card, so the focus goes to Undo; from the open menu, it stays on the menu's checkbox.
    private void OnInputsChanged(RiverInputs inputs)
    {
        var takenOut = inputs.Composition.TakenOutSince(_inputs.Composition);
        _takenOut = RemovalNotice.About(_takenOut, _inputs.Composition, inputs.Composition);
        _focusUndo = takenOut is not null && !_composition.IsOpen;
        State.Inputs = inputs;
        Show(inputs);
    }

    private void OpenComposition() => _composition.Open();

    // The plan starred « Today » runs once, again only when the star moves to another plan.
    private void OnPlansChanged()
    {
        if (_today?.Id != Plans.Today)
            _today = Plans.TodayPlan is { Inputs: { } inputs } today ? (today.Id, inputs.Run()) : null;
    }

    // The next Tab goes on to the first card's heading.
    private async Task SkipToRiverAsync() => await _river.FocusAsync();

    // Undo and Dismiss leave with the notice, so the focus goes to the Composition button, just before
    // it, where the plan's modules are set.
    private void Undo()
    {
        if (_takenOut is { } module)
            OnInputsChanged(_inputs.AddToPlan(module));

        _focusComposition = true;
    }

    private void Dismiss()
    {
        _takenOut = null;
        _focusComposition = true;
    }

    // The split's search runs the year at every pay, so it runs again only when an input other than
    // the pay changes: dragging the pay moves its marker along the same curve.
    private void Show(RiverInputs inputs)
    {
        _inputs = inputs;
        _run = inputs.Run();
        if (_searched is null || !inputs.SameBesidesPay(_searched))
        {
            _search = inputs.SearchSplit();
            _searched = inputs;
        }
    }

    // The browser's date, which decides which deadlines are past and which one a payment is proposed by.
    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    // The engine's refusal goes to the card holding the refused field, and only there.
    private string? Refused(RiverModule module) =>
        _run.Error is { } error && RiverErrors.Owner(error, _inputs.Company is null) == module ? error : null;
}
