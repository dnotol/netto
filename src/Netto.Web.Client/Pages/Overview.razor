@page "/overview"
@using Netto.Core.CorporateTax
@using Netto.Core.DirectorPay
@using Netto.Core.Dividends
@using Netto.Core.PersonalTax
@using Netto.Core.Simulation
@using Netto.Web.Client.DirectorPay
@using Netto.Web.Client.Steps
@using Netto.Web.Client.Year
@inject IStringLocalizer<Overview> L

<PageTitle>@L["PageTitle"]</PageTitle>

@* The overview of the year as the user runs it today: the company's year, the director pay and a
   dividend. Every figure comes from YearSimulation in Netto.Core; this page only binds YearView to
   markup. *@
<section class="overview">
    <MudContainer MaxWidth="MaxWidth.Large">
        <header class="overview__head">
            <div class="overview__eyebrow-row">
                <p class="overview__eyebrow">@L["Eyebrow"]</p>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">@L["Badge"]</MudChip>
            </div>
            <MudText Typo="Typo.h2" HtmlTag="h1" Class="overview__title">@L["Title"]</MudText>
            <p class="overview__lede">@L["Lede"]</p>
        </header>

        <p class="overview__example">@L["ExampleNote"]</p>
        @* No Min or Max on the amounts: MudBlazor would clamp a value silently, and the engine's
           refusal, with its message, is what the user has to see. *@
        <div class="setup">
            <fieldset class="setup__group">
                <legend class="setup__title">@L["CompanyTitle"]</legend>
                <MudNumericField T="decimal" Value="_revenue" ValueChanged="OnRevenueChanged" Label="@L["RevenueLabel"]"
                                 Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                                 Variant="Variant.Outlined" Immediate="true" DebounceInterval="400" Error="@(_error == YearSimulation.RevenueNegative)" />
                <MudNumericField T="decimal" Value="_runningCosts" ValueChanged="OnRunningCostsChanged" Label="@L["RunningCostsLabel"]"
                                 Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                                 Variant="Variant.Outlined" Immediate="true" DebounceInterval="400" Error="@(_error == YearSimulation.RunningCostsNegative)" />
                <MudCheckBox T="bool" Value="_smallCompany" ValueChanged="OnSmallCompanyChanged" Color="Color.Primary" Label="@L["SmallCompanyLabel"]" />
                <p class="setup__hint">@L["SmallCompanyHint"]</p>
                <MudCheckBox T="bool" Value="_firstFourTaxPeriods" ValueChanged="OnFirstFourTaxPeriodsChanged" Color="Color.Primary"
                             Label="@L["FirstFourLabel"]" Disabled="!_smallCompany" />
            </fieldset>

            <fieldset class="setup__group">
                <legend class="setup__title">@L["PayTitle"]</legend>
                <MudNumericField T="decimal" Value="_directorPay" ValueChanged="OnDirectorPayChanged" Label="@L["PayLabel"]"
                                 Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                                 Variant="Variant.Outlined" Immediate="true" DebounceInterval="400" Error="@(_error == GrossToNet.GrossPayNegative)" />
                <MunicipalityField Choice="_choice" ChoiceChanged="OnChoiceChanged" Refused="@(_error == GrossToNet.MunicipalRateOutOfRange)" />
            </fieldset>

            <fieldset class="setup__group">
                <legend class="setup__title">@L["DividendTitle"]</legend>
                <MudNumericField T="decimal" Value="_reserve" ValueChanged="OnReserveChanged" Label="@L["ReserveLabel"]"
                                 Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                                 Variant="Variant.Outlined" Immediate="true" DebounceInterval="400"
                                 Error="@(_error == YearSimulation.ReserveNegative)" />
                @if (_maximumDividend is { } maximum)
                {
                    <p class="setup__hint">@L["ReserveHint", Formats.Euros(maximum)]</p>
                }
                <MudSelect T="WithholdingCategory" Value="_category" ValueChanged="OnCategoryChanged" Label="@L["CategoryLabel"]"
                           ToStringFunc="CategoryText"
                           Variant="Variant.Outlined" Class="setup__category">
                    @foreach (var category in Enum.GetValues<WithholdingCategory>())
                    {
                        <MudSelectItem T="WithholdingCategory" Value="category">@CategoryText(category)</MudSelectItem>
                    }
                </MudSelect>
            </fieldset>
        </div>

        <aside class="assumed" aria-labelledby="assumed-title">
            <h2 id="assumed-title" class="assumed__title">@L["AssumedTitle"]</h2>
            <ul class="assumed__list">
                <li>@L["AssumedSingle"]</li>
                <li>@L["AssumedWallonia"]</li>
                <li>@L["AssumedMainOccupation"]</li>
                <li>@L["AssumedCalendarYear"]</li>
                <li>@L["AssumedSteadyState"]</li>
                <li>@L["AssumedFinalContributions"]</li>
            </ul>
        </aside>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="overview__error">
                @L[OverviewText.Error(_error), Formats.Euros(_maximumDividend ?? 0m)]
            </MudAlert>
        }
        else if (_result is not null && _view is not null)
        {
            <div class="net">
                <span class="net__label">@L["NetLabel"]</span>
                <span class="net__amount">@Formats.Euros(_result.NetInPocket)</span>
                <span class="net__from">@L["NetFrom", Formats.Euros(_result.ProfitBeforePay)]</span>
            </div>

            <section class="split" aria-labelledby="split-title">
                <h2 id="split-title" class="overview__section-title">@L["SplitTitle"]</h2>
                <p class="overview__section-intro">@L["SplitIntro"]</p>
                <div class="split__card">
                    @if (_view.Split.All(part => part.Share is not null))
                    {
                        <div class="split__bar" aria-hidden="true">
                            @foreach (var part in _view.Split)
                            {
                                <span class="split__segment split__segment--@part.Key" style="@SegmentStyle(part)"></span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="split__none">@L["SplitNoShares"]</p>
                    }
                    <dl class="split__parts">
                        @foreach (var part in _view.Split)
                        {
                            <div class="split__part split__part--@part.Key">
                                <dt><span class="split__swatch" aria-hidden="true"></span>@L[OverviewText.Split(part.Key)]</dt>
                                <dd>
                                    @Formats.Euros(part.Amount)
                                    @if (part.Share is { } share)
                                    {
                                        <span class="split__share">@Formats.Share(share)</span>
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                </div>
            </section>

            <section aria-labelledby="ledgers-title">
                <h2 id="ledgers-title" class="overview__section-title">@L["LedgersTitle"]</h2>
                <div class="ledgers">
                    @foreach (var ledger in _view.Ledgers)
                    {
                        <article class="ledger">
                            <h3 class="ledger__title">@L[OverviewText.Ledger(ledger.Key)]</h3>
                            <p class="ledger__hint">@L[OverviewText.LedgerHint(ledger.Key)]</p>
                            <ol class="ledger__rows">
                                @foreach (var row in ledger.Rows)
                                {
                                    <li class="ledger-row ledger-row--@Modifier(row.Kind)">
                                        <span class="ledger-row__label">@L[OverviewText.Row(row.Key)]</span>
                                        <span class="ledger-row__amount">@Amount(row)</span>
                                    </li>
                                }
                            </ol>
                            @if (ledger.Key == "company")
                            {
                                <p class="ledger__note">@L[OverviewText.Condition(_view.Condition), Formats.Euros(_result.Company.MinimumDirectorPay)]</p>
                            }
                            else if (ledger.Key == "director_pay")
                            {
                                <a href="/plan" class="ledger__link">@L["PayLink"]</a>
                            }
                        </article>
                    }
                </div>
            </section>

            <section aria-labelledby="details-title">
                <h2 id="details-title" class="overview__section-title">@L["DetailsTitle"]</h2>
                <p class="overview__section-intro">@L["DetailsIntro", _result.Scenario.IncomeYear]</p>
                <StepDetails Details="_view.Details" />
            </section>
        }

        <aside class="limits" aria-labelledby="limits-title">
            <h2 id="limits-title" class="limits__title">@L["LimitsTitle"]</h2>
            <ul class="limits__list">
                <li>@L["LimitReserves"]</li>
                <li>@L["LimitCompanyContribution"]</li>
                <li>@L["LimitDisallowed"]</li>
                <li>@L["LimitAdvanceSurcharge"]</li>
                <li>@L["LimitManagementFee"]</li>
                <li>@L["LimitLowIncomeCredit"]</li>
            </ul>
            <p class="limits__note">@L["LimitTaxCalc"]</p>
        </aside>
    </MudContainer>
</section>

@code {
    // The only year with every layer's amounts; choosing the year is a later item.
    private const int IncomeYear = 2026;

    // An example year, labelled as such, so the page shows figures at once.
    private decimal _revenue = 120_000m;
    private decimal _runningCosts = 20_000m;
    private bool _smallCompany = true;
    private bool _firstFourTaxPeriods;
    private decimal _directorPay = 50_000m;
    private MunicipalityChoice _choice = MunicipalityChoice.Start(MunicipalRates.IncomeYear2026, 0.07m);
    private decimal _reserve;
    private WithholdingCategory _category = WithholdingCategory.VvprbisThirdYearOnwards;

    private YearResult? _result;
    private YearView? _view;
    private string? _error;
    private decimal? _maximumDividend;

    protected override void OnInitialized() => Compute();

    private void OnRevenueChanged(decimal revenue) => Set(() => _revenue = revenue);

    private void OnRunningCostsChanged(decimal runningCosts) => Set(() => _runningCosts = runningCosts);

    private void OnSmallCompanyChanged(bool smallCompany) => Set(() => _smallCompany = smallCompany);

    private void OnFirstFourTaxPeriodsChanged(bool firstFourTaxPeriods) => Set(() => _firstFourTaxPeriods = firstFourTaxPeriods);

    private void OnDirectorPayChanged(decimal directorPay) => Set(() => _directorPay = directorPay);

    private void OnChoiceChanged(MunicipalityChoice choice) => Set(() => _choice = choice);

    private void OnReserveChanged(decimal reserve) => Set(() => _reserve = reserve);

    private void OnCategoryChanged(WithholdingCategory category) => Set(() => _category = category);

    private void Set(Action change)
    {
        change();
        Compute();
    }

    private void Compute()
    {
        var company = new CompanyStatus(_smallCompany, _firstFourTaxPeriods);
        var scenario = new Scenario(IncomeYear, _revenue, _runningCosts, company, _directorPay, _choice.MunicipalRate, _reserve, _category);
        (_result, _error) = YearSimulation.Run(scenario);
        _view = _result is null ? null : YearView.From(_result);

        // The profit after tax does not depend on the reserve, so a refused one can still say it.
        _maximumDividend = (_result ?? YearSimulation.Run(scenario with { Reserve = 0m }).Value)?.MaximumDividend;
    }

    private string CategoryText(WithholdingCategory category) =>
        L[OverviewText.Category(category), Formats.RuleAmount(DividendRules.IncomeYear2026.Rate(category))];

    private static string Amount(LedgerRow row) => row.Kind switch
    {
        LedgerRowKind.Out or LedgerRowKind.PaidOut => Formats.Deduction(row.Amount),
        LedgerRowKind.Back => Formats.Addition(row.Amount),
        _ => Formats.Euros(row.Amount),
    };

    private static string Modifier(LedgerRowKind kind) => kind switch
    {
        LedgerRowKind.Start => "start",
        LedgerRowKind.Out => "out",
        LedgerRowKind.PaidOut => "paid-out",
        LedgerRowKind.Back => "back",
        LedgerRowKind.Subtotal => "subtotal",
        LedgerRowKind.End => "end",
        _ => throw new ArgumentOutOfRangeException(nameof(kind), kind, null),
    };

    // CSS wants a dot as decimal separator whatever the culture.
    private static string SegmentStyle(SplitPart part) =>
        FormattableString.Invariant($"flex-basis: {(part.Share ?? 0m) * 100m:0.###}%");
}
