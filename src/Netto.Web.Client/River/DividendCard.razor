@using Netto.Core.Dividends
@using Netto.Web.Client.Steps
@inject IStringLocalizer<DividendCard> L

@* One slider over the profit after tax: kept in the company on one side, paid out as a dividend on
   the other, so the dividend can never exceed what is there. It is withheld at the rate the user
   declares, and the withholding on the exempt part comes back through the tax return. *@
<ModuleCard Title="@L["Title"]" Summary="@Summary" Skipped="Inputs.Company is null" Details="@Details" DetailsLabel="@L["DetailsLabel"]">
    @if (Inputs.Company is null)
    {
        <p class="dividend__waiting">@L["Waiting"]</p>
    }
    else
    {
        <RiverField Label="@L["KeptLabel"]" For="river-reserve" Origin="Inputs.Reserve.Origin">
            @if (_view is not null)
            {
                <MudSlider T="decimal" Value="_view.Kept" ValueChanged="OnReserveChanged" Min="0m" Max="_view.Maximum" Step="100m"
                           Immediate="true" Color="Color.Primary" Culture="Formats.Culture" Disabled="@(_view.Maximum == 0m)"
                           aria-labelledby="river-reserve-label" />
            }
            <MudNumericField T="decimal" InputId="river-reserve" Value="@(_view?.Kept ?? Inputs.Reserve.Value)" ValueChanged="OnReserveChanged"
                             Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="400" Error="@(Refused is not null)" />
        </RiverField>
        @if (_view is not null)
        {
            <div class="dividend__ends">
                <span>@L["DividendEnd"] <b>@Formats.Euros(_view.Dividend)</b></span>
                <span>@L["KeptEnd"] <b>@Formats.Euros(_view.Kept)</b></span>
            </div>
        }
        <RefusedMessage Error="Refused" />
        <RiverField Label="@L["CategoryLabel"]" Origin="Inputs.DividendCategory.Origin">
            <div class="dividend__categories">
                <MudChipSet T="WithholdingCategory" SelectedValue="Inputs.DividendCategory.Value" SelectedValueChanged="OnCategoryChanged"
                            SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                            Size="Size.Small">
                    @foreach (var category in Enum.GetValues<WithholdingCategory>().Reverse())
                    {
                        <MudChip T="WithholdingCategory" Value="category" Text="@CategoryText(category)" />
                    }
                </MudChipSet>
            </div>
            <p class="dividend__hint">@L["CategoryHint"]</p>
        </RiverField>
        @if (_view is not null)
        {
            <DrainList Drains="_view.Drains" />
        }
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's error key when it refuses what is kept.
    [Parameter]
    public string? Refused { get; set; }

    private DividendView? _view;

    protected override void OnParametersSet() => _view = Run.Year is { } year ? DividendView.From(year) : null;

    private string? Summary => Run.Year is { } year
        ? L["Summary", Formats.Euros(year.MaximumDividend), Formats.Euros(year.Dividend.NetDividend)].Value
        : null;

    private RenderFragment? Details => _view is { } view && Run.Year is { } year
        ? @<text>
              <h3 class="dividend__sources">@L["SourcesTitle", year.Scenario.IncomeYear]</h3>
              <StepDetails Details="view.Details" />
          </text>
        : null;

    // The rate of the year, from its rules, beside what the user declares.
    private string CategoryText(WithholdingCategory category) =>
        L[DividendCardText.Category(category), DividendRules.For(Inputs.IncomeYear)?.Rate(category) is { } rate ? Formats.RuleAmount(rate) : ""];

    private Task OnReserveChanged(decimal reserve) => InputsChanged.InvokeAsync(Inputs.WithReserve(reserve));

    private Task OnCategoryChanged(WithholdingCategory category) => InputsChanged.InvokeAsync(Inputs.WithDividendCategory(category));
}
