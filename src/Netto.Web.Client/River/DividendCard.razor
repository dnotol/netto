@using Netto.Core.Dividends
@using Netto.Core.Rules
@inject IStringLocalizer<DividendCard> L

@* One slider over what the company can pay out, this year's profit after tax and the profits kept
   from earlier years: what is kept in the company at year end, the rest paid out as a dividend, so
   the dividend can never exceed what is there. It is withheld at the rate the user declares, whatever
   year its profits come from, and the withholding on the exempt part comes back through the tax
   return. What the user rarely changes, the earlier profits and the rate they declare, sits behind one
   disclosure, folded to a line that states it, what VVPRbis shares are in the bubble after the rate's
   label; the earlier profits are taken while typing, like revenue, since nothing bounds them. What is
   kept can be typed exactly, taken when the field is left, so the field shows what can be paid out
   (the Director pay card's pay field does the same). Under it, the dividend's figure as lines, this year's profit
   after tax beside earlier profits and the dividend paid out (DividendFigures), then where the
   dividend goes and what is kept. A reserve the company cannot cover, which the field cannot say as it
   shows what is kept, is a note after them, with the reserve typed. *@
<ModuleCard Name="dividend" Title="@L["Title"]" Summary="@Summary" ToYou="@_view?.ToYou" Waiting="Inputs.Company is null" Refused="@Refused"
            Sources="@(_view?.Details ?? [])" IncomeYear="Inputs.IncomeYear">
    <Disclosure Title="@L["SharesTitle"]" Values="@SettingWords.Of(L, _settings.Facts)" Refused="@DividendSettingsView.SharesHold(Refused)">
        <RiverField Label="@L["EarlierLabel"]" For="river-earlier-profits" Origin="Inputs.EarlierProfits.Origin" Help="@L["EarlierHint"]">
            <RiverNumericField T="decimal" InputId="river-earlier-profits" Value="Inputs.EarlierProfits.Value" ValueChanged="OnEarlierProfitsChanged"
                               Euros="true"
                               Error="@(Refused?.Input == RefusedInput.EarlierProfits)" Refusal="@Refused" />
        </RiverField>
        <RiverField Label="@L["CategoryLabel"]" Origin="Inputs.DividendCategory.Origin" Help="@L[DividendCardText.CategoryHelp]">
            <div class="dividend__categories">
                <MudChipSet T="WithholdingCategory" SelectedValue="Inputs.DividendCategory.Value" SelectedValueChanged="OnCategoryChanged"
                            SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                            Size="Size.Small">
                    @foreach (var category in Enum.GetValues<WithholdingCategory>().Reverse())
                    {
                        <MudChip T="WithholdingCategory" Value="category" Text="@CategoryText(category)" />
                    }
                </MudChipSet>
            </div>
        </RiverField>
    </Disclosure>
    <RiverField Label="@L["KeptLabel"]" For="river-reserve" Origin="Inputs.Reserve.Origin">
        @if (_view is not null)
        {
            <MudSlider T="decimal" Value="_view.Kept" ValueChanged="OnReserveChanged" Min="0m" Max="_view.Maximum" Step="100m"
                       Immediate="true" Color="Color.Primary" Culture="Formats.Culture" Disabled="@(_view.Maximum == 0m)"
                       aria-labelledby="river-reserve-label" aria-valuetext="@Formats.Euros(_view.Kept)" />
        }
        <RiverNumericField T="decimal" InputId="river-reserve" Value="@(_view?.Kept ?? Inputs.Reserve.Value)" ValueChanged="OnReserveChanged"
                           Euros="true" TakenOnLeaving="true"
                           Error="@(Refused?.Input == RefusedInput.Reserve)" Refusal="@Refused" />
    </RiverField>
    <RefusedMessage Error="@Refused" />
    @if (_view is not null)
    {
        <FigureList Figures="@FigureWords.Of(L, DividendFigures.From(_view))" />
        <DrainList Drains="_view.Drains" />
        @if (DividendCardText.ReserveNote(_view) is { } note)
        {
            <p class="dividend__reserve">@L[note, Formats.Euros(_view.Reserve)]</p>
        }
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's refusal of what is kept.
    [Parameter]
    public Refusal? Refused { get; set; }

    private DividendView? _view;
    private DividendSettingsView _settings = default!;

    protected override void OnParametersSet()
    {
        _view = Run.Year is { } year ? DividendView.From(year) : null;
        _settings = DividendSettingsView.From(Inputs);
    }

    // All that can be paid out comes in; once the company keeps some, the summary starts from what is
    // paid out, the base of the card's rate.
    private string? Summary => _view is { } view && Run.Year is { } year
        ? L[DividendCardText.Summary(view), Formats.Euros(view.Kept > 0m ? view.Dividend : view.Maximum), Formats.Euros(year.Dividend.NetDividend)].Value
        : null;


    // The rate of the year, from its rules, beside what the user declares.
    private string CategoryText(WithholdingCategory category) =>
        L[DividendCardText.Category(category), DividendRules.For(Inputs.IncomeYear)?.Rate(category) is { } rate ? Formats.RuleAmount(rate) : ""];

    private Task OnReserveChanged(decimal reserve) => InputsChanged.InvokeAsync(Inputs.WithReserve(reserve));

    private Task OnEarlierProfitsChanged(decimal earlierProfits) => InputsChanged.InvokeAsync(Inputs.WithEarlierProfits(earlierProfits));

    private Task OnCategoryChanged(WithholdingCategory category) => InputsChanged.InvokeAsync(Inputs.WithDividendCategory(category));
}
