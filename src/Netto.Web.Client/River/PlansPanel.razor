@using Netto.Web.Client.Tabs
@inject IStringLocalizer<PlansPanel> L
@inject SavedPlans Plans
@inject IJSRuntime JS
@inject TimeProvider Clock
@inject RiverState State
@inject TypedFields Fields

@* The user's saved plans, from the band at the top of the plan page: « Save this plan » keeps the river as
   it is as a new plan, never over another, and says itself whether the river has changes no saved plan
   holds: a gold dot after its name, whose room is kept while there are none so nothing beside it moves, and
   the same in its name for a screen reader, out of sight. « Plans » opens a panel listing them, built like
   the « Add to plan » menu (CompositionMenu, a disclosure, not an ARIA menu): it takes focus when opened and
   closes with Escape, a click outside or Done, each giving focus back to its button. Each row says what
   reaches the pocket and its share, and its difference from the plan starred « Today », the user's current
   setup, with every figure the engine's (PlanRow). A row is renamed in place, starred, opened in the river or
   deleted; opening over unsaved changes and deleting ask first, in the row itself. From two plans on, the
   panel also compares two of them side by side (CompareTab), a mode of the panel, not a view of the plan
   (docs/architecture/decisions/2026-11-11-three-views-one-question-each.md): « Compare plans » takes the
   place of the list, widening the panel, with « Back to plans » to return; Escape, a click outside and Done
   close it whichever it shows. The address /plan?plans=compare, where Compare plans' old address goes,
   opens it on the comparison once (OpenOnCompare). The panel's foot exports
   every plan to a file and imports a file's plans after the ones here (SavedPlans.Export, Import):
   the browser writes and reads the file, which never reaches a server. *@
<div class="plans" @onkeydown="OnKeyDown">
    <MudButton id="plans-save" Variant="Variant.Outlined" Size="Size.Small" Class="plans__save" StartIcon="@Icons.Material.Rounded.BookmarkAdd"
               Disabled="@(!CanSave)" OnClick="Save">
        @L["Save"]<span class="plans__unsaved@(Unsaved ? "" : " plans__unsaved--saved")" aria-hidden="true"></span>
        @if (Unsaved)
        {
            @(" ")<span class="plans__spoken">@L["UnsavedSpoken"]</span>
        }
    </MudButton>
    <MudButton @ref="_button" Variant="Variant.Outlined" Size="Size.Small" Class="plans__button" StartIcon="@Icons.Material.Rounded.FolderOpen"
               OnClick="Toggle" aria-expanded="@(_open ? "true" : "false")" aria-controls="@_panelId"
               aria-label="@L[PlansPanelText.ButtonLabel(Plans.Plans.Count), Plans.Plans.Count]">
        @L["Button"]
        @if (Plans.Plans.Count > 0)
        {
            <span class="plans__count">@L["Count", Plans.Plans.Count]</span>
        }
    </MudButton>
    @if (_open)
    {
        <div class="plans__backdrop" @onclick="Close"></div>
    }
    <div id="@_panelId" class="plans__panel@(_comparing ? " plans__panel--compare" : "")" role="group" aria-label="@L["PanelLabel"]" tabindex="-1" hidden="@(!_open)" @ref="_panel">
        @if (_open)
        {
            <p class="plans__eyebrow">@L["Title"]</p>
            @if (_comparing)
            {
                <div class="plans__back">
                    <MudButton @ref="_back" Variant="Variant.Text" Size="Size.Small" Class="plans__back-button" StartIcon="@Icons.Material.Rounded.ArrowBack" OnClick="BackToPlans">@L["Back"]</MudButton>
                </div>
                <CompareTab />
            }
            else
            {
            @if (Plans.CouldNotRead)
            {
                <p class="plans__warning" role="note">@L["CouldNotRead"]</p>
            }
            @if (_rows.Count == 0)
            {
                <p class="plans__lede">@L["NoPlan"]</p>
            }
            else
            {
                <p class="plans__lede">@L[Plans.Today is null ? "LedeNoToday" : "Lede"]</p>
                <ul class="plans__list">
                    @foreach (var row in _rows)
                    {
                        <li @key="row.Plan.Id" class="plan @(row.IsOpened ? "plan--opened" : "")">
                            <div class="plan__head">
                                <MudIconButton Size="Size.Small" Class="plan__star"
                                               Icon="@(row.IsToday ? Icons.Material.Rounded.Star : Icons.Material.Rounded.StarBorder)"
                                               OnClick="@(() => Star(row))" aria-pressed="@(row.IsToday ? "true" : "false")"
                                               aria-label="@L["StarLabel", row.Plan.Name]" />
                                <input class="plan__name" value="@row.Plan.Name" aria-label="@L["NameLabel"]"
                                       @onchange="@(change => Rename(row, change.Value as string))" />
                            </div>
                            @if (!row.Plan.Readable)
                            {
                                <p class="plan__unreadable">@L["Unreadable"]</p>
                            }
                            else
                            {
                                <p class="plan__figures">
                                    @if (row.Pocket is { } pocket)
                                    {
                                        <span class="plan__pocket">@L["Pocket", Formats.Euros(pocket)]</span>
                                        @if (row.Reach is { } reach)
                                        {
                                            @(" ")<span class="plan__reach">@Formats.WholeShare(reach)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>@L["NoFigure"]</span>
                                    }
                                </p>
                                <p class="plan__gain @GainClass(row)">@GainText(row)</p>
                            }
                            @if (_confirming is { } confirming && confirming.Id == row.Plan.Id)
                            {
                                <div class="plan__confirm" role="group" aria-label="@L[confirming.Delete ? "ConfirmDelete" : "ConfirmOpen", row.Plan.Name]">
                                    <span>@L[confirming.Delete ? "ConfirmDelete" : "ConfirmOpen", row.Plan.Name]</span>
                                    <MudButton Variant="Variant.Filled" Size="Size.Small" Class="plan__yes"
                                               OnClick="@(() => Confirm(row))">@L[confirming.Delete ? "DeleteYes" : "OpenYes"]</MudButton>
                                    <MudButton @ref="_cancel" Variant="Variant.Text" Size="Size.Small" OnClick="Cancel">@L["Cancel"]</MudButton>
                                </div>
                            }
                            else
                            {
                                <div class="plan__actions">
                                    @if (row.IsOpened && !Unsaved)
                                    {
                                        <span class="plan__in-river">@L["InRiver"]</span>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(!row.Plan.Readable)"
                                                   OnClick="@(() => Open(row))" aria-label="@L["OpenLabel", row.Plan.Name]">@L["Open"]</MudButton>
                                    }
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => AskDelete(row))"
                                               aria-label="@L["DeleteLabel", row.Plan.Name]">@L["Delete"]</MudButton>
                                </div>
                            }
                        </li>
                    }
                </ul>
                @if (Plans.Plans.Count >= 2)
                {
                    <div class="plans__compare">
                        <MudButton @ref="_compare" Variant="Variant.Outlined" Size="Size.Small" Class="plans__compare-button" StartIcon="@Icons.Material.Rounded.CompareArrows" OnClick="Compare">@L["Compare"]</MudButton>
                    </div>
                }
            }
            @if (_imported is { } imported)
            {
                <p class="plans__imported" role="status">@L[PlansPanelText.Imported(imported), imported.Added, imported.Skipped]</p>
            }
            }
            <div class="plans__foot">
                @if (!_comparing)
                {
                    <div class="plans__file">
                        @if (Plans.Plans.Count > 0)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ExportAsync">@L["Export"]</MudButton>
                        }
                        <InputFile id="@_fileId" class="plans__file-input" accept=".json,application/json" OnChange="ImportAsync" />
                        <label for="@_fileId" class="plans__import">@L["Import"]</label>
                    </div>
                }
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="plans__done" OnClick="Close" @onkeydown="OnDoneKeyDown">@L["Done"]</MudButton>
            </div>
        }
    </div>
</div>

@code {
    // The river as last drawn, what the panel shows and compares with the saved plans (Unsaved). « Save this
    // plan » keeps the river after the fields have taken what is typed in them (TypedFields), which this has not
    // seen yet until the page draws again.
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    // Whether the river can be kept: not while the engine refuses an amount.
    [Parameter]
    public bool CanSave { get; set; }

    // A plan opened, for the river to show.
    [Parameter]
    public EventCallback<RiverInputs> OnOpen { get; set; }

    // The plans changed: saved, starred, renamed or deleted.
    [Parameter]
    public EventCallback OnChanged { get; set; }

    // Whether the address asks the panel to open on the comparison, /plan?plans=compare. It opens it once, as
    // the address arrives: while the address keeps asking, closing the panel or going back to the list stays.
    [Parameter]
    public bool OpenOnCompare { get; set; }

    // Whether the river has changes no saved plan holds, which « Save this plan » shows.
    internal bool Unsaved => Plans.HasUnsavedChanges(Inputs);

    // A file of plans is a few kilobytes a plan: a megabyte holds hundreds.
    private const long MaximumFileSize = 1_024 * 1_024;

    private readonly string _panelId = $"plans-{Guid.NewGuid():N}";
    private readonly string _fileId = $"plans-file-{Guid.NewGuid():N}";
    private PlanImport? _imported;
    private IReadOnlyList<PlanRow> _rows = [];
    private MudButton? _button;
    private MudButton? _cancel;
    private MudButton? _compare;
    private MudButton? _back;
    private ElementReference _panel;
    private bool _open;
    private bool _focusPanel;
    private bool _focusButton;
    private bool _focusConfirm;
    private bool _focusCompare;
    private bool _comparing;
    private bool _arrived;

    // The row asking to open over unsaved changes, or to delete.
    private (string Id, bool Delete)? _confirming;

    protected override void OnParametersSet()
    {
        if (OpenOnCompare && !_arrived)
            (_open, _comparing, _confirming, _imported) = (true, true, null, null);
        _arrived = OpenOnCompare;

        if (_open)
            _rows = PlanRow.From(Plans);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPanel)
        {
            _focusPanel = false;
            await _panel.FocusAsync();
        }

        // A question that drops changes or a plan lands on Cancel, so Enter pressed on its way loses nothing.
        if (_focusConfirm)
        {
            _focusConfirm = false;
            if (_cancel is not null)
                await _cancel.FocusAsync();
        }

        // Back from the comparison, the focus returns to the button that opened it (or the panel, when the
        // list has not two plans to compare any more).
        if (_focusCompare)
        {
            _focusCompare = false;
            if (_compare is not null)
                await _compare.FocusAsync();
            else
                await _panel.FocusAsync();
        }

        if (_focusButton)
        {
            _focusButton = false;
            if (_button is not null)
                await _button.FocusAsync();
        }
    }

    // A click right after typing comes before the field takes the amount: the fields take what is typed first,
    // then the river is read as the page holds it, and kept only if the engine accepts it, as the button disabled
    // says for an amount already taken.
    private async Task Save()
    {
        await Fields.CommitAsync();
        var river = State.Inputs;
        if (!BaselineGain.CanMark(river.Run()))
            return;

        Plans.Save(river, number => L["DefaultName", number]);
        Refresh();
        await OnChanged.InvokeAsync();
    }

    private void Toggle()
    {
        _open = !_open;
        _comparing = false;
        _focusPanel = _open;
        _confirming = null;
        _imported = null;
        Refresh();
    }

    // Every plan with the star, named by the browser's date.
    private async Task ExportAsync() =>
        await JS.InvokeVoidAsync("nettoPlanFile.save", $"netto-plans-{DateOnly.FromDateTime(Clock.GetLocalNow().DateTime):yyyy-MM-dd}.json", Plans.Export());

    // The file's plans join the panel; one too large to be a file of plans is not read.
    private async Task ImportAsync(InputFileChangeEventArgs change)
    {
        string text;
        try
        {
            await using var stream = change.File.OpenReadStream(MaximumFileSize);
            using var reader = new StreamReader(stream);
            text = await reader.ReadToEndAsync();
        }
        catch (IOException)
        {
            _imported = PlanImport.Unreadable;
            return;
        }

        _imported = Plans.Import(text);
        Refresh();
        await OnChanged.InvokeAsync();
    }

    // The comparison takes the list's place in the panel; its title takes the focus (CompareTab).
    private void Compare()
    {
        _comparing = true;
        _confirming = null;
        _imported = null;
    }

    // Back to the list, the focus on the button that opened the comparison.
    private void BackToPlans()
    {
        _comparing = false;
        _focusCompare = true;
        Refresh();
    }

    private void Close()
    {
        _open = false;
        _comparing = false;
        _confirming = null;
        _focusButton = true;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (_open && e.Key == "Escape")
            Close();
    }

    // Tab from Done leaves the panel forwards: it closes, and the focus goes on where the browser takes it.
    private void OnDoneKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Tab", ShiftKey: false })
            (_open, _comparing) = (false, false);
    }

    private async Task Star(PlanRow row)
    {
        Plans.Star(row.Plan.Id);
        Refresh();
        await OnChanged.InvokeAsync();
    }

    private async Task Rename(PlanRow row, string? name)
    {
        Plans.Rename(row.Plan.Id, name ?? "");
        Refresh();
        await OnChanged.InvokeAsync();
    }

    // Over unsaved changes, the row asks first.
    private async Task Open(PlanRow row)
    {
        if (Unsaved)
        {
            _confirming = (row.Plan.Id, false);
            _focusConfirm = true;
            return;
        }

        await OpenNow(row);
    }

    private void AskDelete(PlanRow row)
    {
        _confirming = (row.Plan.Id, true);
        _focusConfirm = true;
    }

    private async Task Confirm(PlanRow row)
    {
        var delete = _confirming?.Delete ?? false;
        _confirming = null;
        if (!delete)
        {
            await OpenNow(row);
            return;
        }

        Plans.Delete(row.Plan.Id);
        Refresh();
        _focusPanel = true;
        await OnChanged.InvokeAsync();
    }

    private void Cancel()
    {
        _confirming = null;
        _focusPanel = true;
    }

    // The river takes the plan, and the panel closes on it.
    private async Task OpenNow(PlanRow row)
    {
        if (Plans.Open(row.Plan.Id) is not { } inputs)
            return;

        Close();
        await OnOpen.InvokeAsync(inputs);
    }

    private void Refresh() => _rows = PlanRow.From(Plans);

    private string GainText(PlanRow row) => row switch
    {
        { IsToday: true } => L["IsToday"],
        { Gain: { Kind: GainKind.More or GainKind.Less } gain } => L[PlansPanelText.Gain(gain.Kind), Formats.Euros(gain.Amount)],
        { Gain: { } gain } => L[PlansPanelText.Gain(gain.Kind)],
        _ => "",
    };

    private static string GainClass(PlanRow row) => row is { Gain.Kind: GainKind.More } ? "plan__gain--more" : "";
}
