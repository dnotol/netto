@implements IAsyncDisposable
@inject IStringLocalizer<BucketBar> L
@inject IJSRuntime JS

@* The river's summary, always in view under the site header: where the money ends up, out of what
   the river starts from, and, at its right, what the page gives it (the Composition menu). Every
   amount is the engine's, regrouped by BucketsView. Each bucket's name is followed by its icon
   (BucketIcons), which a screen reader skips and which goes where the column has no room for it beside
   the name, and opens an info bubble saying
   what it holds, and its amount says its share of the start; under them, what reaches the pocket out
   of what leaves the company (BucketsView.Reach), its bubble saying so, and, once the user has marked
   their current setup, the plan starred « Today », what the river leaves in the pocket against it
   (BaselineGain), with an (i) bubble beside a gain that is a figure, saying what it is measured by and
   what it leaves out (ObjectiveNote, the sentence the Optimisation tab says under its figures): a bubble
   and not a line in sight, since a sentence that long would grow a bar that sticks on every tab; and
   whether the river has changes no plan holds. A polite live
   region says what reaches the pocket, and that gain, once the river has settled
   (BucketBarAnnouncement), not at every step of a slider dragged, or, while the engine refuses an
   amount, that there is no figure until it is corrected; the other buckets are read in the bar
   itself. The region is one of its own, out of sight, since a bubble opening inside the figures
   would be read out as a change of the bar, and a menu inside it at every change. It is empty as the
   page opens. Its last row, across its width, is what the page puts there (TabRow): the plan page's
   tabs, which stick with it. Its height is measured once it is drawn and whenever it changes
   (bucket-bar.js), for the line under it that cards are jumped to and controls scrolled to. *@
<div class="bucket-bar @(TabRow is null ? null : "bucket-bar--tabs")" @ref="_bar">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="bucket-bar__figures">
            <dl class="bucket-bar__buckets">
                @foreach (var key in View?.Buckets.Select(bucket => bucket.Key) ?? BucketsView.Keys)
                {
                    <div class="bucket bucket--@key">
                        <dt class="bucket__label">
                            <span class="bucket__swatch" aria-hidden="true"></span>
                            <InfoBubble Term="@L[BucketBarText.Bucket(key, IncludesRent)]">@L[BucketBarText.Holds(key, IncludesRent, IncludesRoyalty)]</InfoBubble>
                            <span class="bucket__icon" aria-hidden="true"><span>@BucketIcons.For(key)</span></span>
                        </dt>
                        <dd class="bucket__amount">
                            @Amount(key)
                            @if (ShareOf(key) is { } share)
                            {
                                @(" ")<span class="bucket__share">@Formats.WholeShare(share)</span>
                            }
                        </dd>
                    </div>
                }
            </dl>
            @if (View is { } view && view.Buckets.All(bucket => bucket.Share is not null))
            {
                <div class="bucket-bar__stack" aria-hidden="true">
                    @foreach (var bucket in view.Buckets)
                    {
                        <span class="bucket-bar__segment bucket--@bucket.Key" style="@SegmentStyle(bucket)"></span>
                    }
                </div>
            }
            <p class="bucket-bar__from">
                @From
                @if (View is { Reach: { } reach } reached)
                {
                    @(" ")<TermSentence Text="@L[BucketBarText.Reach(reached), Formats.WholeShare(reach), Formats.WholeShare(reached.TaxesShare ?? 0m)]"
                                        Meaning="@L[BucketBarText.ReachMeaning]" />
                }
                @if (View is { StartsAtPay: true })
                {
                    @(" ")@L[BucketBarText.EnterCompany]
                }
            </p>
            @if (Gain is not null || Unsaved)
            {
                <p class="bucket-bar__gain">
                    @if (Gain is { } gain)
                    {
                        <span class="bucket-bar__gain--@gain.Kind.ToString().ToLowerInvariant()">@GainText(gain)</span>
                        @if (gain.Kind != GainKind.NotComparable)
                        {
                            <InfoBubble Label="@L["GainLabel"]"><ObjectiveNote /></InfoBubble>
                        }
                    }
                    @if (Unsaved)
                    {
                        @(Gain is null ? "" : " ")<span class="bucket-bar__unsaved">@L[BucketBarText.Unsaved]</span>
                    }
                </p>
            }
            <p class="bucket-bar__live" aria-live="polite">@_announced</p>
        </div>
        @if (ChildContent is not null)
        {
            <div class="bucket-bar__actions">@ChildContent</div>
        }
        @if (TabRow is not null)
        {
            <div class="bucket-bar__tabs">@TabRow</div>
        }
    </MudContainer>
</div>

@code {
    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The run of the plan starred « Today », the user's current setup, or null while none is.
    [Parameter]
    public RiverRun? Setup { get; set; }

    // Whether the river has changes no saved plan holds.
    [Parameter]
    public bool Unsaved { get; set; }

    // What sits right of the figures.
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // The bar's last row, under the figures and what sits right of them: the plan page's tabs.
    [Parameter]
    public RenderFragment? TabRow { get; set; }

    private BucketsView? View { get; set; }

    private BaselineGain? Gain { get; set; }

    // What the live region says, and what it will say once the river settles; null before the first
    // run, which is not announced.
    private string _announced = "";
    private string? _pocket;

    // Counts the changes of what reaches the pocket, so that only the last one, once settled, is
    // announced.
    private int _changes;
    private bool _disposed;

    private bool IncludesRent => View?.TaxesOnPayIncludeRent ?? false;

    private bool IncludesRoyalty => View?.TaxesOnPayIncludeRoyalty ?? false;

    protected override void OnParametersSet()
    {
        View = BucketsView.From(Run);
        Gain = BaselineGain.From(Run, Setup);
        var pocket = BucketBarAnnouncement.Pocket(View) is { } amount ? L[BucketBarText.PocketAnnounced, amount].Value : L[BucketBarText.Refused].Value;
        if (Gain is { } gain)
            pocket = $"{pocket} {GainText(gain)}";
        if (_pocket is null)
        {
            _pocket = pocket;
            return;
        }

        if (pocket == _pocket)
            return;

        _pocket = pocket;
        _ = AnnounceOnceSettledAsync(++_changes);
    }

    private async Task AnnounceOnceSettledAsync(int change)
    {
        await Task.Delay(BucketBarAnnouncement.Settle);
        if (change != _changes || _disposed)
            return;

        _announced = _pocket ?? "";
        StateHasChanged();
    }

    private ElementReference _bar;

    // Whether the script measures the bar, to stop it as the bar goes.
    private bool _watching;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _watching = true;
        await JS.InvokeVoidAsync("nettoBucketBar.watch", _bar);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_watching)
            await JS.InvokeVoidAsync("nettoBucketBar.stop");
    }

    // Out of what the river starts from, after INASTI's company contribution and a car's costs, or why
    // there is no figure.
    private string From => View is { } view
        ? L[BucketBarText.From(view), Formats.Euros(view.Start - view.EarlierProfits), Formats.Euros(view.EarlierProfits), Formats.Euros(view.CarCosts)].Value
        : L[BucketBarText.Refused].Value;

    // What the river leaves in the pocket against the setup, or that the two cannot be compared.
    private string GainText(BaselineGain gain) => gain.Kind is GainKind.More or GainKind.Less
        ? L[BucketBarText.Gain(gain.Kind), Formats.Euros(gain.Amount)]
        : L[BucketBarText.Gain(gain.Kind)];

    // A bucket's share of what the river starts from, where the bar draws shares.
    private decimal? ShareOf(string key) => View?.Buckets.Single(bucket => bucket.Key == key).Share;

    private string Amount(string key) =>
        View?.Buckets.Single(bucket => bucket.Key == key).Amount is { } amount ? Formats.Euros(amount) : L["NoFigure"];

    // CSS wants a dot as decimal separator whatever the culture.
    private static string SegmentStyle(Bucket bucket) =>
        FormattableString.Invariant($"flex-basis: {(bucket.Share ?? 0m) * 100m:0.###}%");
}
