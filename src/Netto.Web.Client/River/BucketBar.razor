@implements IAsyncDisposable
@inject IStringLocalizer<BucketBar> L
@inject IJSRuntime JS

@* The river's summary and the plan page's header in one band at the top of the window, in the site
   header's place (Layout/MainLayout draws none on the plan): its top row the wordmark, the page's tabs
   (Tabs), the plan's actions (ChildContent: Save this plan, Plans, the Composition menu) and the theme
   switch; under it where the money ends up, five buckets in a row, each told by its swatch and its name,
   which opens a bubble saying what it holds, then its amount. Every amount is the engine's, regrouped by
   BucketsView. Beside the pocket's amount, the one share the band shows: what reaches the pocket out of
   what leaves the company (BucketsView.Reach), its (i) saying what that is out of, the river's start
   (« Out of … »), and what it means. On the pocket's name line, once the user has starred their current
   setup « Today », what the river leaves in the pocket against it (BaselineGain), short, its (i) saying
   what it is measured by and what it leaves out (ObjectiveNote, the sentence the Optimisation tab says
   under its figures). Under the buckets, their shares drawn as one stack, or, where a share would mean
   nothing or the engine refuses an amount, the sentence saying so in its place: the band has the same
   rows whatever the plan says, so its height never depends on it. A polite live region says what reaches
   the pocket, and that gain, once the river has settled (BucketBarAnnouncement), not at every step of a
   slider dragged, or, while the engine refuses an amount, that there is no figure until it is corrected;
   the other buckets are read in the band itself. The region is one of its own, out of sight, since a
   bubble opening inside the figures would be read out as a change of the band, and a menu inside it at
   every change. It is empty as the page opens. Its height is measured once it is drawn and whenever it
   changes (bucket-bar.js), for the line under it that cards are jumped to and controls scrolled to. *@
<div class="bucket-bar" @ref="_bar">
    <MudContainer MaxWidth="MaxWidth.False" Class="netto-column bucket-bar__inner">
        <div class="bucket-bar__top">
            @* To the plan, never to /, as the site header's: a link to / leaves the plan page, which is rebuilt
               and forgets what it had found (PlanEntry). *@
            <a href="/plan" class="wordmark bucket-bar__wordmark">Netto</a>
            @if (Tabs is not null)
            {
                <div class="bucket-bar__tabs">@Tabs</div>
            }
            @if (ChildContent is not null)
            {
                <div class="bucket-bar__actions">@ChildContent</div>
            }
            <ThemeSwitch />
        </div>
        <div class="bucket-bar__figures">
            <dl class="bucket-bar__buckets">
                @foreach (var key in View?.Buckets.Select(bucket => bucket.Key) ?? BucketsView.Keys)
                {
                    <div class="bucket bucket--@key">
                        <dt class="bucket__label">
                            <span class="bucket__swatch" aria-hidden="true"></span>
                            <InfoBubble Term="@L[BucketBarText.Bucket(key, IncludesRent)]" TriggerClass="bucket__name">@L[BucketBarText.Holds(key, IncludesRent, IncludesRoyalty)]</InfoBubble>
                            @if (key == "pocket" && Gain is { } gain)
                            {
                                <span class="bucket__gain bucket__gain--@gain.Kind.ToString().ToLowerInvariant()">@GainShown(gain)</span>
                                <InfoBubble Label="@L["GainLabel"]">
                                    @if (gain.Kind == GainKind.NotComparable)
                                    {
                                        @GainText(gain)
                                    }
                                    else
                                    {
                                        <ObjectiveNote />
                                    }
                                </InfoBubble>
                            }
                        </dt>
                        <dd class="bucket__amount">
                            @Amount(key)
                            @if (key == "pocket")
                            {
                                @if (View?.Reach is { } reach)
                                {
                                    @(" ")<span class="bucket__reach">@L[BucketBarText.ReachShown, Formats.WholeShare(reach)]</span>
                                }
                                <InfoBubble Label="@L[BucketBarText.ReachLabel]">@ReachSaid</InfoBubble>
                            }
                        </dd>
                    </div>
                }
            </dl>
            <div class="bucket-bar__slot">
                @if (View is { } view && view.Buckets.All(bucket => bucket.Share is not null))
                {
                    <div class="bucket-bar__stack" aria-hidden="true">
                        @foreach (var bucket in view.Buckets)
                        {
                            <span class="bucket-bar__segment bucket--@bucket.Key" style="@SegmentStyle(bucket)"></span>
                        }
                    </div>
                }
                else
                {
                    <p class="bucket-bar__from">@From</p>
                }
            </div>
            <p class="bucket-bar__live" aria-live="polite">@_announced</p>
        </div>
    </MudContainer>
</div>

@code {
    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The run of the plan starred « Today », the user's current setup, or null while none is.
    [Parameter]
    public RiverRun? Setup { get; set; }

    // The plan's actions, in the top row after the tabs, before the theme switch.
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // The plan page's tabs, in the top row after the wordmark.
    [Parameter]
    public RenderFragment? Tabs { get; set; }

    private BucketsView? View { get; set; }

    private BaselineGain? Gain { get; set; }

    // What the live region says, and what it will say once the river settles; null before the first
    // run, which is not announced.
    private string _announced = "";
    private string? _pocket;

    // Counts the changes of what reaches the pocket, so that only the last one, once settled, is
    // announced.
    private int _changes;
    private bool _disposed;

    private bool IncludesRent => View?.TaxesOnPayIncludeRent ?? false;

    private bool IncludesRoyalty => View?.TaxesOnPayIncludeRoyalty ?? false;

    protected override void OnParametersSet()
    {
        View = BucketsView.From(Run);
        Gain = BaselineGain.From(Run, Setup);
        var pocket = BucketBarAnnouncement.Pocket(View) is { } amount ? L[BucketBarText.PocketAnnounced, amount].Value : L[BucketBarText.Refused].Value;
        if (Gain is { } gain)
            pocket = $"{pocket} {GainText(gain)}";
        if (_pocket is null)
        {
            _pocket = pocket;
            return;
        }

        if (pocket == _pocket)
            return;

        _pocket = pocket;
        _ = AnnounceOnceSettledAsync(++_changes);
    }

    private async Task AnnounceOnceSettledAsync(int change)
    {
        await Task.Delay(BucketBarAnnouncement.Settle);
        if (change != _changes || _disposed)
            return;

        _announced = _pocket ?? "";
        StateHasChanged();
    }

    private ElementReference _bar;

    // Whether the script measures the bar, to stop it as the bar goes.
    private bool _watching;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _watching = true;
        await JS.InvokeVoidAsync("nettoBucketBar.watch", _bar);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_watching)
            await JS.InvokeVoidAsync("nettoBucketBar.stop");
    }

    // Out of what the river starts from, before INASTI's company contribution and a car's costs, or why
    // there is no figure: in the reach's bubble, and in the stack's place where there is no stack.
    private string From => View is { } view
        ? L[BucketBarText.From(view), Formats.Euros(view.Start - view.EarlierProfits), Formats.Euros(view.EarlierProfits)].Value
        : L[BucketBarText.Refused].Value;

    // What the reach's bubble says: what the band is out of, what the reach means and, with the company
    // skipped, where the rest of the river is.
    private string ReachSaid => string.Join(' ', new[]
    {
        From,
        L[BucketBarText.ReachMeaning].Value,
        View is { StartsAtPay: true } ? L[BucketBarText.EnterCompany].Value : null,
    }.OfType<string>());

    // What the river leaves in the pocket against the setup, or that the two cannot be compared: in full
    // in the live region, and in the bubble of a gain that is not a figure.
    private string GainText(BaselineGain gain) => gain.Kind is GainKind.More or GainKind.Less
        ? L[BucketBarText.Gain(gain.Kind), Formats.Euros(gain.Amount)]
        : L[BucketBarText.Gain(gain.Kind)];

    // The same, short, on the pocket's name line, its sign before it.
    private string GainShown(BaselineGain gain) => gain.Kind switch
    {
        GainKind.More => L[BucketBarText.GainShown(gain.Kind), Formats.Addition(gain.Amount)],
        GainKind.Less => L[BucketBarText.GainShown(gain.Kind), Formats.Deduction(gain.Amount)],
        _ => L[BucketBarText.GainShown(gain.Kind)],
    };

    private string Amount(string key) =>
        View?.Buckets.Single(bucket => bucket.Key == key).Amount is { } amount ? Formats.Euros(amount) : L["NoFigure"];

    // CSS wants a dot as decimal separator whatever the culture.
    private static string SegmentStyle(Bucket bucket) =>
        FormattableString.Invariant($"flex-basis: {(bucket.Share ?? 0m) * 100m:0.###}%");
}
