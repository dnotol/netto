@inject IStringLocalizer<BucketBar> L

@* The river's summary, always in view under the site header: where the money ends up, out of what
   the river starts from, and, at its right, what the page gives it (the Composition menu). Every
   amount is the engine's, regrouped by BucketsView. Each bucket's name opens an info bubble saying
   what it holds. A live region reads the figures out as they change: one of its own, out of sight,
   holding only them, since a bubble opening inside it would be read out as a change of the bar, and
   a menu inside it at every change. *@
<div class="bucket-bar">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="bucket-bar__figures">
            <dl class="bucket-bar__buckets">
                @foreach (var key in BucketsView.Keys)
                {
                    <div class="bucket bucket--@key">
                        <dt class="bucket__label">
                            <span class="bucket__swatch" aria-hidden="true"></span>
                            <InfoBubble Term="@L[BucketBarText.Bucket(key, IncludesRent)]">@L[BucketBarText.Holds(key, IncludesRent)]</InfoBubble>
                        </dt>
                        <dd class="bucket__amount">@Amount(key)</dd>
                    </div>
                }
            </dl>
            @if (View is { } view && view.Buckets.All(bucket => bucket.Share is not null))
            {
                <div class="bucket-bar__stack" aria-hidden="true">
                    @foreach (var bucket in view.Buckets)
                    {
                        <span class="bucket-bar__segment bucket--@bucket.Key" style="@SegmentStyle(bucket)"></span>
                    }
                </div>
            }
            <p class="bucket-bar__from">@From</p>
            <p class="bucket-bar__live" aria-live="polite">@Announced</p>
        </div>
        @if (ChildContent is not null)
        {
            <div class="bucket-bar__actions">@ChildContent</div>
        }
    </MudContainer>
</div>

@code {
    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // What sits right of the figures.
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private BucketsView? View { get; set; }

    private bool IncludesRent => View?.TaxesOnPayIncludeRent ?? false;

    protected override void OnParametersSet() => View = BucketsView.From(Run);

    // Out of what the river starts from, or why there is no figure.
    private string From => View switch
    {
        null => L["Refused"].Value,
        { StartsAtPay: true } view => L[view.CompanyPaysContributions ? "FromPayCost" : "FromPay", Formats.Euros(view.Start)].Value,
        { EarlierProfits: > 0m } view => L["FromProfitAndEarlier", Formats.Euros(view.Start - view.EarlierProfits), Formats.Euros(view.EarlierProfits)].Value,
        { } view => L["FromProfit", Formats.Euros(view.Start)].Value,
    };

    // Each bucket with its amount, then out of what.
    private string Announced => string.Join(" ", BucketsView.Keys
        .Select(key => L[BucketBarText.Announced, L[BucketBarText.Bucket(key, IncludesRent)].Value, Amount(key)].Value)
        .Append(From));

    private string Amount(string key) =>
        View?.Buckets.Single(bucket => bucket.Key == key).Amount is { } amount ? Formats.Euros(amount) : L["NoFigure"];

    // CSS wants a dot as decimal separator whatever the culture.
    private static string SegmentStyle(Bucket bucket) =>
        FormattableString.Invariant($"flex-basis: {(bucket.Share ?? 0m) * 100m:0.###}%");
}
