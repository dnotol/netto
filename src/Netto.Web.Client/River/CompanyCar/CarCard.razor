@using Netto.Core.CompanyCar
@using Netto.Core.Rules
@using Netto.Web.Client.River
@inject IStringLocalizer<CarCard> L

@* The last lever before the split: a car the company puts at the director's disposal for private use.
   The user gives its catalogue value, the month and year of its first registration, what drives it,
   for a car that burns fuel its CO2 or that none is registered, the month and year it was ordered or
   leased, for a plug-in hybrid whether it is a fake one with its matching car's CO2, for natural gas
   whether it is under 12 fiscal horsepower, its yearly costs to the company, whether the company pays
   the private energy, and their own contribution; a field that does not apply to what drives the car
   is not shown, its value kept. What the car is, as its papers say, sits behind one disclosure,
   « Your car », folded to a line that states it and opening by itself each time the card is drawn
   while no catalogue value is given, since no car counts without it; its yearly costs, the
   contribution and the private energy the company pays stay in sight. Which cars it counts is said in
   the bubble of the order date. Its figures come first, as lines (CarFigures): the benefit in kind, its
   CO2 percentage, period by period, the contribution and the benefit taxed as pay, what the company
   deducts of the costs, cannot deduct and adds back of the benefit, with a sentence only for what a
   figure cannot say, a benefit held to the minimum or a percentage held to a bound; then the plan with
   the car weighed in cash against the same plan without it, both at the pay the plan with the car runs at,
   which a note names once the pay set is held below (CarComparison.PayHeld), and, once the user gives what the same car
   would cost them privately, the company car against it, until then that this comparison waits; then
   the costs paid into the company's expenses, with INASTI's company contribution, and the contribution
   coming back from the pocket, a sentence above them saying so when the costs are more than the card
   receives, their share then stopping at 100% and the rate at 0%. What the CO2 percentage counts and the administration's reading of
   « fuel » are in its details, above the sources. An optional module: it shows only while in the plan,
   and the word at its bottom takes it out, its values kept. The amounts are taken while typing and carry
   no Min or Max: the engine refuses what the rules do not allow, and the card a negative private cost,
   which the engine never sees. Skipped with the company. *@
<ModuleCard Name="@ModuleFolds.Name(OptionalModule.Car)" Title="@L["Title"]" Summary="@Summary" PassesOn="@_view?.PassesOn" Help="@L["Hint"]" Waiting="Inputs.Company is null"
            Refused="@Refused" Details="@Details" Sources="@(_view?.Details ?? [])" IncomeYear="Inputs.IncomeYear" RemoveLabel="@L["Remove"]" OnRemove="Remove">
    <Disclosure Title="@L["CarTitle"]" Values="@SettingWords.Of(L, _settings.Car)" Refused="@CarSettingsView.CarHolds(Refused)"
                OpenByDefault="@_settings.NeedsFacts">
        <div class="car__fields">
            <RiverField Label="@L["CatalogueLabel"]" For="river-car-catalogue" Origin="Inputs.Car.CatalogueValue.Origin" Help="@L["CatalogueHint"]">
                <RiverNumericField T="decimal" InputId="river-car-catalogue" Value="Inputs.Car.CatalogueValue.Value" ValueChanged="OnCatalogueValueChanged"
                                   Euros="true"
                                   Error="@(Refused?.Input == RefusedInput.CarCatalogueValue)" Refusal="@Refused" />
            </RiverField>
            <RiverField Label="@L["RegistrationLabel"]" Origin="Inputs.Car.FirstRegistration.Origin" Help="@L["RegistrationHint"]">
                <div class="car__month-year">
                    <MudSelect T="int" Value="Inputs.Car.FirstRegistration.Value.Month" ValueChanged="OnRegistrationMonthChanged" Label="@L["MonthLabel"]"
                               ToStringFunc="@MonthName" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="car__month">
                        @foreach (var month in Enumerable.Range(1, 12))
                        {
                            <MudSelectItem T="int" Value="month">@MonthName(month)</MudSelectItem>
                        }
                    </MudSelect>
                    <RiverNumericField T="int" Value="Inputs.Car.FirstRegistration.Value.Year" ValueChanged="OnRegistrationYearChanged" Label="@L["YearLabel"]"
                                       Min="FirstYear" Max="LastYear" Format="0" TakenOnLeaving="true" Class="car__year" />
                </div>
            </RiverField>
            <RiverField Label="@L["EngineLabel"]" For="river-car-engine" Origin="Inputs.Car.Engine.Origin" Help="@L["EngineHint"]">
                <MudSelect T="CarEngine" InputId="river-car-engine" Value="Inputs.Car.Engine.Value" ValueChanged="OnEngineChanged"
                           ToStringFunc="@EngineName" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    @foreach (var engine in Enum.GetValues<CarEngine>())
                    {
                        <MudSelectItem T="CarEngine" Value="engine">@EngineName(engine)</MudSelectItem>
                    }
                </MudSelect>
            </RiverField>
            @if (Inputs.Car.Engine.Value.EmitsCo2())
            {
                <RiverField Label="@L["Co2Label"]" For="river-car-co2" Origin="Inputs.Car.Co2.Origin" Help="@L["Co2Hint"]">
                    <RiverNumericField T="int" InputId="river-car-co2" Value="Inputs.Car.Co2.Value" ValueChanged="OnCo2Changed"
                                       Format="0" Adornment="Adornment.End" AdornmentText="g/km" Disabled="Inputs.Car.NoCo2Data.Value"
                                       Error="@(Refused?.Input == RefusedInput.CarCo2)" Refusal="@Refused" />
                </RiverField>
            }
            <RiverField Label="@L["AcquiredLabel"]" Origin="Inputs.Car.Acquired.Origin" Help="@AcquiredHelp">
                <div class="car__month-year">
                    <MudSelect T="int" Value="Inputs.Car.Acquired.Value.Month" ValueChanged="OnAcquiredMonthChanged" Label="@L["MonthLabel"]"
                               ToStringFunc="@MonthName" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="car__month"
                               Error="@(Refused?.Input == RefusedInput.CarAcquired)">
                        @foreach (var month in Enumerable.Range(1, 12))
                        {
                            <MudSelectItem T="int" Value="month">@MonthName(month)</MudSelectItem>
                        }
                    </MudSelect>
                    <RiverNumericField T="int" Value="Inputs.Car.Acquired.Value.Year" ValueChanged="OnAcquiredYearChanged" Label="@L["YearLabel"]"
                                       Min="FirstYear" Max="LastYear" Format="0" TakenOnLeaving="true" Class="car__year"
                                       Error="@(Refused?.Input == RefusedInput.CarAcquired)" Refusal="@Refused" />
                </div>
            </RiverField>
            @if (Inputs.Car.Engine.Value.IsPlugInHybrid() && Inputs.Car.FakeHybrid.Value)
            {
                <RiverField Label="@L["MatchingCo2Label"]" For="river-car-matching-co2" Origin="Inputs.Car.MatchingCarCo2.Origin" Help="@L["MatchingCo2Hint"]">
                    <RiverNumericField T="int" InputId="river-car-matching-co2" Value="Inputs.Car.MatchingCarCo2.Value" ValueChanged="OnMatchingCo2Changed"
                                       Format="0" Adornment="Adornment.End" AdornmentText="g/km" Disabled="Inputs.Car.NoMatchingCar.Value"
                                       Error="@(Refused?.Input == RefusedInput.CarMatchingCo2)" Refusal="@Refused" />
                </RiverField>
            }
        </div>
        @if (Inputs.Car.Engine.Value.EmitsCo2())
        {
            <div class="car__tick">
                <MudCheckBox T="bool" Value="Inputs.Car.NoCo2Data.Value" ValueChanged="OnNoCo2DataChanged" Color="Color.Primary" Label="@L["NoCo2Label"]" />
                <OriginChip Origin="Inputs.Car.NoCo2Data.Origin" />
            </div>
        }
        @if (Inputs.Car.Engine.Value.IsPlugInHybrid())
        {
            <div class="car__tick">
                <MudCheckBox T="bool" Value="Inputs.Car.FakeHybrid.Value" ValueChanged="OnFakeHybridChanged" Color="Color.Primary" Label="@L["FakeHybridLabel"]" />
                <OriginChip Origin="Inputs.Car.FakeHybrid.Origin" />
                <InfoBubble Label="@L["FakeHybridLabel"]">@L["FakeHybridHint"]</InfoBubble>
            </div>
            @if (Inputs.Car.FakeHybrid.Value)
            {
                <div class="car__tick">
                    <MudCheckBox T="bool" Value="Inputs.Car.NoMatchingCar.Value" ValueChanged="OnNoMatchingCarChanged" Color="Color.Primary" Label="@L["NoMatchingLabel"]" />
                    <OriginChip Origin="Inputs.Car.NoMatchingCar.Origin" />
                </div>
            }
        }
        @if (Inputs.Car.Engine.Value == CarEngine.NaturalGas)
        {
            <div class="car__tick">
                <MudCheckBox T="bool" Value="Inputs.Car.SmallNaturalGas.Value" ValueChanged="OnSmallNaturalGasChanged" Color="Color.Primary" Label="@L["SmallGasLabel"]" />
                <OriginChip Origin="Inputs.Car.SmallNaturalGas.Origin" />
            </div>
        }
    </Disclosure>
    <div class="car__fields">
        <RiverField Label="@L["CostsLabel"]" For="river-car-costs" Origin="Inputs.Car.YearlyCosts.Origin" Help="@L["CostsHint"]">
            <RiverNumericField T="decimal" InputId="river-car-costs" Value="Inputs.Car.YearlyCosts.Value" ValueChanged="OnCostsChanged"
                               Euros="true"
                               Error="@(Refused?.Input == RefusedInput.CarYearlyCosts)" Refusal="@Refused" />
        </RiverField>
        <RiverField Label="@L["ContributionLabel"]" For="river-car-contribution" Origin="Inputs.Car.PersonalContribution.Origin" Help="@L["ContributionHint"]">
            <RiverNumericField T="decimal" InputId="river-car-contribution" Value="Inputs.Car.PersonalContribution.Value" ValueChanged="OnContributionChanged"
                               Euros="true"
                               Error="@(Refused?.Input == RefusedInput.CarContribution)" Refusal="@Refused" />
        </RiverField>
    </div>
    <div class="car__tick">
        <MudCheckBox T="bool" Value="Inputs.Car.CompanyPaysPrivateEnergy.Value" ValueChanged="OnPrivateEnergyChanged" Color="Color.Primary"
                     Label="@L[CarCardText.PrivateEnergy(Inputs.Car.Engine.Value)]" />
        <OriginChip Origin="Inputs.Car.CompanyPaysPrivateEnergy.Origin" />
        <InfoBubble Label="@L[CarCardText.PrivateEnergy(Inputs.Car.Engine.Value)]">@L[CarCardText.PrivateEnergyHint(Inputs.Car.Engine.Value)]</InfoBubble>
    </div>
    <RefusedMessage Error="@Refused" />
    @if (_view is { HasCar: true } shown)
    {
        var result = shown.Result;
        <FigureList Figures="@FigureWords.Of(L, CarFigures.Benefit(result))" />
        @if (result.AtTheMinimum)
        {
            <p class="car__note">@L["AtTheMinimum"]</p>
        }
        @if (_rules is not null && CarCardText.Co2Held(result, _rules) is { } held)
        {
            <p class="car__note">@L[held]</p>
        }
        @if (_comparison is { } comparison)
        {
            <div class="car__comparison">
                @if (comparison.PayHeld is { } pay)
                {
                    <p class="car__note">@L["PayHeld", Formats.Euros(pay)]</p>
                }
                <FigureList Figures="@FigureWords.Of(L, CarFigures.Cash(comparison))" />
                <div class="car__fields">
                    <RiverField Label="@L["PrivateCostLabel"]" For="river-car-private-cost"
                                Origin="@(Inputs.Car.PrivateCost.Value is null ? null : Inputs.Car.PrivateCost.Origin)" Help="@L["PrivateCostHint"]">
                        <RiverNumericField T="decimal?" InputId="river-car-private-cost" Value="Inputs.Car.PrivateCost.Value" ValueChanged="OnPrivateCostChanged"
                                           Euros="true"
                                           Error="@(comparison.Refused is not null)" Refusal="@comparison.Refused" />
                    </RiverField>
                </div>
                <RefusedMessage Error="@comparison.Refused" />
                <p class="car__gap">@L[CarCardText.Private(comparison), Formats.Euros(Math.Abs(comparison.AgainstPrivate ?? 0m)), Formats.Euros(comparison.PrivateCost ?? 0m)]</p>
            </div>
        }
    }
    else if (Refused is null)
    {
        <p class="car__note">@L["NoCarYet"]</p>
    }
    @if (_view is not null)
    {
        @if (_view.CostsAboveWhatItReceives)
        {
            <p class="car__note">@L["CostsAboveReceived"]</p>
        }
        <DrainList Drains="_view.Drains" />
    }
    @if (_rules is not null)
    {
        <ConditionList Name="car-conditions" Conditions="CarView.Conditions(_rules, Inputs.Car.Engine.Value)" />
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's refusal of an amount of the car.
    [Parameter]
    public Refusal? Refused { get; set; }

    // The years a first registration or an order can be typed in: any car old enough is at its
    // lowest share and its oldest deduction.
    private const int FirstYear = 1950;
    private const int LastYear = 2099;

    private CarView? _view;
    private CarComparison? _comparison;
    private CarRules? _rules;
    private CarSettingsView _settings = default!;

    protected override void OnParametersSet()
    {
        _view = Run.Year is { } year ? CarView.From(year, Inputs.Composition) : null;
        _comparison = CarComparison.From(Inputs, Run);
        _rules = CarRules.For(Inputs.IncomeYear);
        _settings = CarSettingsView.From(Inputs);
    }

    private string MonthName(int month) => Formats.Month(Inputs.IncomeYear, month);

    private string EngineName(CarEngine engine) => L[CarCardText.Engine(engine)];

    // It ends on what the split shares, the royalty in it while it is in the plan. A contribution that
    // more than covers the costs states what it brings beyond them between the two: the card passes on
    // that much more than it received, which no share of what it received can say (CarView.PassesOn).
    private string? Summary => _view switch
    {
        null => null,
        { HasCar: false } view => L[CarCardText.Summary(false, Royalty, false), Formats.Euros(view.SplitShares)].Value,
        { ContributionBeyondCosts: { } beyond } view =>
            L[CarCardText.Summary(true, Royalty, true), Formats.Euros(view.Result.Costs), Formats.Euros(beyond), Formats.Euros(view.SplitShares)].Value,
        var view => L[CarCardText.Summary(true, Royalty, false), Formats.Euros(view.Result.Costs), Formats.Euros(view.SplitShares)].Value,
    };

    private bool Royalty => Inputs.InPlan(OptionalModule.Copyright);


    // When the car was ordered or leased, and which cars the card counts: those ordered or leased by the
    // end of the year.
    private string AcquiredHelp => $"{L["AcquiredHint"]} {L["Scope"]}";

    // The rules the figures rest on beyond their steps' own: what the CO2 percentage counts and, for a car
    // the company charges, the administration's reading of « fuel », word for word above the sources.
    private RenderFragment? Details => _view is { Details.Count: > 0 } view
        ? @<text>
              <p class="car__rule">@L[CarCardText.Co2(view.Result), Formats.Grams(view.Result.Co2Counted), Formats.Grams(view.Result.Co2Reference?.Value ?? 0m),
                                      Formats.Percentage(view.Result.Co2Percentage), Inputs.IncomeYear]</p>
              @if (view.ChargingReading && CarCardText.Reading(Inputs.Car.Engine.Value) is { } reading)
              {
                  <p class="car__rule">@L[reading]</p>
              }
          </text>
        : null;

    private Task OnCatalogueValueChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithCatalogueValue(amount));

    // A month begun counts whole, so the day of the first registration does not matter: the first.
    private Task OnRegistrationMonthChanged(int month) =>
        InputsChanged.InvokeAsync(Inputs.WithFirstRegistration(new DateOnly(Inputs.Car.FirstRegistration.Value.Year, month, 1)));

    private Task OnRegistrationYearChanged(int year) =>
        InputsChanged.InvokeAsync(Inputs.WithFirstRegistration(new DateOnly(Math.Clamp(year, FirstYear, LastYear), Inputs.Car.FirstRegistration.Value.Month, 1)));

    private Task OnEngineChanged(CarEngine engine) => InputsChanged.InvokeAsync(Inputs.WithCarEngine(engine));

    private Task OnCo2Changed(int grams) => InputsChanged.InvokeAsync(Inputs.WithCarCo2(grams));

    private Task OnNoCo2DataChanged(bool none) => InputsChanged.InvokeAsync(Inputs.WithNoCo2Data(none));

    // Every date the deduction rests on falls on the first of a month (1 July 2023, 1 January 2026),
    // and the half-year a plug-in hybrid is refused for ends on its last: the first of the month
    // tells them apart.
    private Task OnAcquiredMonthChanged(int month) =>
        InputsChanged.InvokeAsync(Inputs.WithCarAcquired(new DateOnly(Inputs.Car.Acquired.Value.Year, month, 1)));

    private Task OnAcquiredYearChanged(int year) =>
        InputsChanged.InvokeAsync(Inputs.WithCarAcquired(new DateOnly(Math.Clamp(year, FirstYear, LastYear), Inputs.Car.Acquired.Value.Month, 1)));

    private Task OnFakeHybridChanged(bool fake) => InputsChanged.InvokeAsync(Inputs.WithFakeHybrid(fake));

    private Task OnMatchingCo2Changed(int grams) => InputsChanged.InvokeAsync(Inputs.WithMatchingCarCo2(grams));

    private Task OnNoMatchingCarChanged(bool none) => InputsChanged.InvokeAsync(Inputs.WithNoMatchingCar(none));

    private Task OnSmallNaturalGasChanged(bool small) => InputsChanged.InvokeAsync(Inputs.WithSmallNaturalGas(small));

    private Task OnCostsChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithCarCosts(amount));

    private Task OnContributionChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithCarContribution(amount));

    private Task OnPrivateEnergyChanged(bool paid) => InputsChanged.InvokeAsync(Inputs.WithPrivateEnergyPaid(paid));

    // Cleared, the private cost is none again.
    private Task OnPrivateCostChanged(decimal? amount) => InputsChanged.InvokeAsync(Inputs.WithCarPrivateCost(amount));

    private Task Remove() => InputsChanged.InvokeAsync(Inputs.TakeOutOfPlan(OptionalModule.Car));
}
