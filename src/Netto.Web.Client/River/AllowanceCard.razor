@using Netto.Core.Allowances
@using Netto.Core.Rules
@inject IStringLocalizer<AllowanceCard> L

@* What the company pays the director besides pay after the vouchers, before the split: flat-rate
   allowances for an office, internet and a computer at home, each for the year, and the phone costs it
   reimburses on invoices. A reimbursement of the company's own costs is not pay: they reach the pocket
   untaxed and outside INASTI, and the company deducts them in full, like its own running costs, with
   nothing added back to its taxable income: the card's bubble says so. The office, internet and
   computer fields keep their maximum for the year under them, the office allowance's monthly maxima in
   the bubble after its label; the phone costs have none. Under the fields, where the allowances go,
   each to the pocket, and what they leave, on to the home office rent when it is in the plan, or the
   split. An optional module: it shows only while in
   the plan, and the word at its bottom takes it out, its values kept. The circular's flat amounts
   are not written for directors and Netto cannot see the costs, so the card lists the conditions with
   their texts, the director's own case first. The amounts are taken while typing, like revenue, and
   carry no Min or Max: the engine refuses what the rules do not allow, and its message is what the
   user has to see. Skipped with the company. *@
<ModuleCard Name="@ModuleFolds.Name(OptionalModule.Allowances)" Title="@L["Title"]" Summary="@Summary" ToYou="@_view?.ToYou" Help="@L["Hint"]" Waiting="Inputs.Company is null"
            Refused="@Refused" Sources="@(_view?.Details ?? [])" IncomeYear="Inputs.IncomeYear" RemoveLabel="@L["Remove"]" OnRemove="Remove">
    <div class="allowances__fields">
        <RiverField Label="@L["OfficeLabel"]" For="river-office-allowance" Origin="Inputs.Allowances.Office.Origin" Help="@OfficeHelp">
            <RiverNumericField T="decimal" InputId="river-office-allowance" Value="Inputs.Allowances.Office.Value" ValueChanged="OnOfficeChanged"
                               Euros="true"
                               Error="@(Refused?.Input == RefusedInput.OfficeAllowance)" Refusal="@Refused" />
            @if (_rules is not null)
            {
                <p class="allowances__note">@L["OfficeMaximum", Formats.Euros(AllowanceCalculator.OfficeAllowanceMaximum(_rules))]</p>
            }
        </RiverField>
        <RiverField Label="@L["InternetLabel"]" For="river-internet-allowance" Origin="Inputs.Allowances.Internet.Origin">
            <RiverNumericField T="decimal" InputId="river-internet-allowance" Value="Inputs.Allowances.Internet.Value" ValueChanged="OnInternetChanged"
                               Euros="true"
                               Error="@(Refused?.Input == RefusedInput.InternetAllowance)" Refusal="@Refused" />
            @if (_rules is not null)
            {
                <p class="allowances__note">@L["MonthlyMaximum", Formats.RuleAmount(_rules.InternetAllowanceMonthlyMaximum), Formats.Euros(AllowanceCalculator.InternetAllowanceMaximum(_rules))]</p>
            }
        </RiverField>
        <RiverField Label="@L["ComputerLabel"]" For="river-computer-allowance" Origin="Inputs.Allowances.Computer.Origin">
            <RiverNumericField T="decimal" InputId="river-computer-allowance" Value="Inputs.Allowances.Computer.Value" ValueChanged="OnComputerChanged"
                               Euros="true"
                               Error="@(Refused?.Input == RefusedInput.ComputerAllowance)" Refusal="@Refused" />
            @if (_rules is not null)
            {
                <p class="allowances__note">@L["MonthlyMaximum", Formats.RuleAmount(_rules.ComputerAllowanceMonthlyMaximum), Formats.Euros(AllowanceCalculator.ComputerAllowanceMaximum(_rules))]</p>
            }
        </RiverField>
        <RiverField Label="@L["PhoneLabel"]" For="river-phone-costs" Origin="Inputs.Allowances.Phone.Origin">
            <RiverNumericField T="decimal" InputId="river-phone-costs" Value="Inputs.Allowances.Phone.Value" ValueChanged="OnPhoneChanged"
                               Euros="true"
                               Error="@(Refused?.Input == RefusedInput.PhoneCosts)" Refusal="@Refused" />
        </RiverField>
    </div>
    <RefusedMessage Error="@Refused" />
    @if (_view is not null)
    {
        <DrainList Drains="_view.Drains" />
    }
    @if (_rules is not null)
    {
        <ConditionList Name="allowances-conditions" Conditions="_rules.Conditions" />
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's refusal of an allowance.
    [Parameter]
    public Refusal? Refused { get; set; }

    private AllowanceView? _view;
    private AllowanceRules? _rules;

    protected override void OnParametersSet()
    {
        _view = Run.Year is { } year ? AllowanceView.From(year, Inputs.Composition) : null;
        _rules = AllowanceRules.For(Inputs.IncomeYear);
    }

    private string? Summary => _view is { } view
        ? L["Summary", Formats.Euros(view.Total), Formats.Euros(view.Left)].Value
        : null;


    // The monthly maxima the office allowance's yearly one adds up, in the bubble after its label.
    private string? OfficeHelp => _rules is { } rules ? L["OfficeHelp", OfficeMonths(rules)].Value : null;

    // Each maximum of the year with the month it holds from: €157.83 a month from January, …
    private string OfficeMonths(AllowanceRules rules) =>
        string.Join(L["ListSeparator"].Value, rules.OfficeAllowanceMaxima.Select(maximum =>
            L["MonthlyFrom", Formats.RuleAmount(maximum.Amount), Formats.Month(rules.IncomeYear, maximum.FromMonth)].Value));

    private Task OnOfficeChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithOfficeAllowance(amount));

    private Task OnInternetChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithInternetAllowance(amount));

    private Task OnComputerChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithComputerAllowance(amount));

    private Task OnPhoneChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithPhoneCosts(amount));

    private Task Remove() => InputsChanged.InvokeAsync(Inputs.TakeOutOfPlan(OptionalModule.Allowances));
}
