@implements IAsyncDisposable
@inject IStringLocalizer<RiverOutline> L
@inject IJSRuntime JS
@inject Folds Folds

@* The river's outline: navigation, not a module, beside the cards on a wide screen and hidden below
   one (RiverOutline.razor.css), stuck under the bar of buckets while the river scrolls. It lists every
   card on the page in the order a reader meets it, as the cards report themselves (OutlineRows), each
   with its title and one figure of its summary (its glance), after the icon of the bucket that figure
   lands in; it computes nothing of its own. Choosing a card opens it if folded, as the viewer's fold,
   scrolls it under the bar and puts the focus on its heading (river-outline.js). The card the river
   has in view is marked (aria-current), measured by the script and decided here (OutlineRows.InView):
   the script calls only when a card crosses the line under the bar, and only the outline is drawn
   again, never the river. At the top of the page, the first card is the one in view. Its head offers
   to open every card listed, or to fold them all once all are open, as the viewer's word on each. It
   is a nav named by its visible title, before the river in the page, so the keyboard meets it once,
   after the bar; no live region, and its title is no heading, so the page's headings stay the
   cards'. *@
<nav class="river-outline" aria-labelledby="@TitleId" @ref="_nav">
    <div class="river-outline__head">
        <p id="@TitleId" class="river-outline__title">@L[RiverOutlineText.Label]</p>
        <button type="button" class="river-outline__all" aria-label="@L[RiverOutlineText.AllName(_allOpen)]" @onclick="ToggleAll">@L[RiverOutlineText.All(_allOpen)]</button>
    </div>
    <ol class="river-outline__rows">
        @foreach (var row in Outline.Rows)
        {
            <li @key="row.Name">
                <button type="button" class="river-outline__row" aria-current="@(row.Name == Current ? "location" : null)" @onclick="() => Jump(row.Name)">
                    <span class="river-outline__card">@row.Title</span>
                    @if (row.Glance is { } glance)
                    {
                        @* Razor drops the whitespace between elements: without it, a screen reader reads the
                           title run into the glance. *@
                        @(" ")
                        <span class="river-outline__glance">
                            @if (glance.Bucket is { } bucket)
                            {
                                <span class="river-outline__icon" aria-hidden="true">@BucketIcons.For(bucket)</span>
                            }
                            @L[RiverOutlineText.Glance(glance.Kind), glance.Figure]
                        </span>
                    }
                </button>
            </li>
        }
    </ol>
</nav>

@code {
    private const string TitleId = "river-outline-title";

    // The page's cards, handed down by the page with its river (Plan).
    [CascadingParameter]
    private OutlineRows Outline { get; set; } = default!;

    private ElementReference _nav;
    private DotNetObjectReference<RiverOutline>? _self;
    private bool _allOpen;

    // The card in view as the script last measured it; none before it has, when the first card is.
    private string? _inView;

    // The card chosen, to jump to once it is drawn open.
    private string? _jumpTo;

    // The cards the script watches, to tell it again only when they change.
    private string[] _watched = [];

    private string? Current => _inView ?? Outline.Rows.FirstOrDefault()?.Name;

    protected override void OnInitialized()
    {
        Outline.Changed += OnRowsChanged;
        Folds.Changed += OnFoldsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var names = Outline.Rows.Select(row => row.Name).ToArray();
        if (!names.SequenceEqual(_watched))
        {
            _self ??= DotNetObjectReference.Create(this);
            _watched = names;
            await JS.InvokeVoidAsync("nettoOutline.watch", _self, _nav, names);
        }

        if (_jumpTo is { } name)
        {
            _jumpTo = null;
            await JS.InvokeVoidAsync("nettoOutline.jump", name);
        }
    }

    // The script measured the cards as they stand in the window; the outline is drawn again only when
    // the card in view is another.
    [JSInvokable]
    public void InView(string[] names, double[] tops, double[] bottoms, double line, bool atEnd)
    {
        var inView = OutlineRows.InView([.. names.Select((name, index) => new CardBox(name, tops[index], bottoms[index]))], line, atEnd);
        if (inView is null || inView == _inView)
            return;

        _inView = inView;
        StateHasChanged();
    }

    // A card came or went, or shows another title or figure.
    private void OnRowsChanged() => _ = InvokeAsync(() =>
    {
        _allOpen = Outline.AllOpen;
        StateHasChanged();
    });

    // A fold opened or closed, by the viewer from its card or by the page: drawn again only when the
    // toggle's word changes.
    private void OnFoldsChanged() => _ = InvokeAsync(() =>
    {
        if (Outline.AllOpen == _allOpen)
            return;

        _allOpen = Outline.AllOpen;
        StateHasChanged();
    });

    // The card opens first, drawn open with the outline, then the script scrolls to it. It is the one in
    // view until the river is scrolled again.
    private void Jump(string name)
    {
        Outline.Open(name);
        _inView = name;
        _jumpTo = name;
    }

    private void ToggleAll()
    {
        Outline.SetAll(!Outline.AllOpen);
        _allOpen = Outline.AllOpen;
    }

    public async ValueTask DisposeAsync()
    {
        Outline.Changed -= OnRowsChanged;
        Folds.Changed -= OnFoldsChanged;
        if (_self is not null)
        {
            await JS.InvokeVoidAsync("nettoOutline.stop");
            _self.Dispose();
        }
    }
}
