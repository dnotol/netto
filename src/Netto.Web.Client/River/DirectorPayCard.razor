@using Netto.Core.DirectorPay
@using Netto.Core.Simulation
@using Netto.Core.SocialContributions
@using Netto.Web.Client.DirectorPay
@using Netto.Web.Client.Steps
@inject IStringLocalizer<DirectorPayCard> L

@* The director's gross pay through INASTI's contributions, the income tax and the municipal
   surcharge to the net. The pay comes from the split, or has a slider of its own once the company
   is skipped. The user says who pays the contributions; when the company does, they are pay too
   and the card says what the pay costs it. What was withheld on the pay is the pay slip's amount,
   derived, until the user types the amount actually withheld, with a way back; it and what the
   director paid in advance are taken while typing, since nothing bounds them, and the card says
   what they leave on the tax, the bonus they earn and what more by the last deadline leaves no
   surcharge due. The pay slip and the rules behind each figure are its detail view. *@
<ModuleCard Title="@L["Title"]" Summary="@Summary" Details="@Details" DetailsLabel="@L["DetailsLabel"]">
    @if (Inputs.Company is null)
    {
        <RiverField Label="@L["OwnPayLabel"]" For="river-pay" Origin="Inputs.DirectorPay.Origin">
            <MudSlider T="decimal" Value="@Math.Clamp(Inputs.DirectorPay.Value, 0m, OwnPayMaximum)" ValueChanged="OnPayChanged"
                       Min="0m" Max="OwnPayMaximum" Step="100m" Immediate="true" Color="Color.Primary" Culture="Formats.Culture"
                       aria-labelledby="river-pay-label" />
            <MudNumericField T="decimal" InputId="river-pay" Value="Inputs.DirectorPay.Value" ValueChanged="OnPayChanged"
                             Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="400"
                             Error="@(Refused == GrossToNet.GrossPayNegative)" />
        </RiverField>
    }
    else if (Run.Pay is { } pay)
    {
        <p class="director-pay__pay">
            @L["PayFromSplit"] <b>@Formats.Euros(pay.GrossPay)</b>
            <OriginChip Origin="InputOrigin.Derived" />
        </p>
    }
    <RiverField Label="@L["PaidByLabel"]" Origin="Inputs.ContributionsPaidBy.Origin">
        <div class="director-pay__payers">
            <MudChipSet T="ContributionsPaidBy" SelectedValue="Inputs.ContributionsPaidBy.Value" SelectedValueChanged="OnPaidByChanged"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                        Size="Size.Small">
                @foreach (var payer in Enum.GetValues<ContributionsPaidBy>())
                {
                    <MudChip T="ContributionsPaidBy" Value="payer" Text="@L[DirectorPayCardText.PaidBy(payer)]" />
                }
            </MudChipSet>
        </div>
        <p class="director-pay__note">@L["PaidByHint"]</p>
        @if (_view is { CompanyPaysContributions: true } costing)
        {
            <p class="director-pay__cost">@L["CompanyCost", Formats.Euros(costing.CompanyCost)]</p>
        }
    </RiverField>
    <RiverField Label="@L["MunicipalityHead"]" Origin="Inputs.Municipality.Origin">
        <MunicipalityField Choice="Inputs.Municipality" ChoiceChanged="OnMunicipalityChanged"
                           Refused="@(Refused == GrossToNet.MunicipalRateOutOfRange)" />
    </RiverField>
    <div class="director-pay__prepayments">
        <h3 class="director-pay__prepayments-title">@L["PrepaymentsTitle"]</h3>
        <p class="director-pay__note">@L["PrepaymentsHint"]</p>
        <RiverField Label="@L["WithheldLabel", Inputs.IncomeYear]" For="river-tax-withheld" Origin="_withheld.Origin">
            <MudNumericField T="decimal" InputId="river-tax-withheld" Value="_withheld.Amount" ValueChanged="OnWithheldChanged"
                             Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="400"
                             Error="@(Refused == GrossToNet.TaxWithheldNegative)" />
            <p class="director-pay__note">
                @(_withheld.IsYours ? L["WithheldYours"] : L["WithheldDerived"])
                @if (_withheld.IsYours)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="OnWithheldAsPaySlip"
                               Class="director-pay__pay-slip-amount">@L["WithheldAsPaySlip"]</MudButton>
                }
            </p>
        </RiverField>
        <div class="director-pay__deadlines">
            @foreach (var field in TaxAdvancePaymentFields.From(Inputs))
            {
                <RiverField Label="@L["PaymentLabel", Formats.Day(field.Date)]" For="@($"river-tax-advance-payment-{field.Deadline}")" Origin="field.Paid.Origin">
                    <MudNumericField T="decimal" InputId="@($"river-tax-advance-payment-{field.Deadline}")" Value="field.Paid.Value"
                                     ValueChanged="@(amount => OnAdvancePaymentChanged(field.Deadline, amount))"
                                     Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="400"
                                     Error="@(Refused == GrossToNet.TaxAdvancePaymentNegative && field.Paid.Value < 0m)" />
                </RiverField>
            }
        </div>
        <div class="director-pay__status">
            <MudCheckBox T="bool" Value="Inputs.TaxPrepayments.Starter.Value" ValueChanged="OnStarterChanged" Color="Color.Primary"
                         Label="@L["StarterLabel", Inputs.IncomeYear - 2]" />
            <OriginChip Origin="Inputs.TaxPrepayments.Starter.Origin" />
        </div>
        @if (_view is not null)
        {
            <p class="director-pay__condition">
                @L[DirectorPayCardText.Surcharge(_view.Surcharge), Formats.Euros(_view.SurchargeAmount), Formats.Euros(_view.TopUp), Formats.Day(_view.LastDeadline)]
                @if (_view.Bonus > 0m)
                {
                    @(" ")@L["Bonus", Formats.Euros(_view.Bonus)]
                }
            </p>
        }
    </div>
    <RefusedMessage Error="@Refused" />
    @if (_view is not null)
    {
        <DrainList Drains="_view.Drains" />
    }
</ModuleCard>

@code {
    // As far as the pay page's slider went; the exact amount field takes any amount.
    private const decimal OwnPayMaximum = 200_000m;

    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's error key when it refuses the rate, what was withheld or paid in advance on the
    // pay, or the pay once the company is skipped.
    [Parameter]
    public string? Refused { get; set; }

    private DirectorPayView? _view;
    private WithheldFieldView _withheld = default!;

    protected override void OnParametersSet()
    {
        _view = Run.Pay is { } pay ? DirectorPayView.From(Inputs, pay) : null;
        _withheld = WithheldFieldView.From(Inputs, Run);
    }

    // What flows in is what the pay costs the company: the gross, plus the contributions it pays.
    private string? Summary => Run.Pay is { } pay
        ? L["Summary", Formats.Euros(pay.CompanyCost), Formats.Euros(pay.NetInPocket)].Value
        : null;

    private RenderFragment? Details => Run.Pay is { } pay && _view is { } view
        ? @<text>
              <PaySlip Pay="pay" />
              <h3 class="director-pay__sources">@L["SourcesTitle", pay.IncomeYear]</h3>
              <StepDetails Details="view.Details" />
          </text>
        : null;

    private Task OnPayChanged(decimal pay) => InputsChanged.InvokeAsync(Inputs.WithDirectorPay(pay));

    private Task OnMunicipalityChanged(MunicipalityChoice choice) => InputsChanged.InvokeAsync(Inputs.WithMunicipality(choice));

    private Task OnPaidByChanged(ContributionsPaidBy paidBy) => InputsChanged.InvokeAsync(Inputs.WithContributionsPaidBy(paidBy));

    private Task OnWithheldChanged(decimal withheld) => InputsChanged.InvokeAsync(Inputs.WithTaxWithheld(withheld));

    private Task OnWithheldAsPaySlip() => InputsChanged.InvokeAsync(Inputs.WithTaxWithheldAsThePaySlip());

    private Task OnAdvancePaymentChanged(int deadline, decimal amount) => InputsChanged.InvokeAsync(Inputs.WithTaxAdvancePayment(deadline, amount));

    private Task OnStarterChanged(bool starter) => InputsChanged.InvokeAsync(Inputs.WithStarter(starter));
}
