@using Netto.Core.DirectorPay
@using Netto.Core.Simulation
@using Netto.Core.SocialContributions
@using Netto.Web.Client.DirectorPay
@inject IStringLocalizer<DirectorPayCard> L

@* The director's gross pay through INASTI's contributions, the income tax and the municipal
   surcharge to the net. The pay comes from the split, or has a slider of its own once the company
   is skipped. Its figures come first, as one list: the gross from the split, what the pay is taxed
   on besides it (DirectorPayFigures), then where the pay goes (DrainList); then what the withholding
   and the advance payments leave on the tax, a line of what more by the last deadline leaves no
   surcharge due, or a sentence saying why none is. What the user rarely changes sits behind two
   disclosures after them, each folded to a line that states it: their situation, and the tax paid
   during the year. The user says who pays the contributions; when the company does, they are pay
   too, and what flows in says what the pay costs it. What was withheld on the pay is the pay slip's
   amount, derived, until the user types the amount actually withheld, with a way back; how it is
   derived is the field's bubble. It and what the director paid in advance are taken while typing,
   since nothing bounds them. The pay slip and the rules behind each figure are its detail view. *@
<ModuleCard Name="director-pay" Title="@L["Title"]" Summary="@Summary" Glance="@Glance" ToYou="@_view?.ToYou" Refused="@Refused" Details="@Details"
            Sources="@(_view?.Details ?? [])" IncomeYear="Inputs.IncomeYear" DetailsLabel="@L["DetailsLabel"]" SourcesTitle="@L["SourcesTitle", Inputs.IncomeYear]">
    @if (Inputs.Company is null)
    {
        <RiverField Label="@L["OwnPayLabel"]" For="river-pay" Origin="Inputs.DirectorPay.Origin">
            <MudSlider T="decimal" Value="@OwnPay" ValueChanged="OnPayChanged"
                       Min="0m" Max="OwnPayMaximum" Step="100m" Immediate="true" Color="Color.Primary" Culture="Formats.Culture"
                       aria-labelledby="river-pay-label" aria-valuetext="@Formats.Euros(OwnPay)" />
            <RiverNumericField T="decimal" InputId="river-pay" Value="Inputs.DirectorPay.Value" ValueChanged="OnPayChanged"
                               Euros="true"
                               Error="@(Refused == GrossToNet.GrossPayNegative)" Refusal="@Refused" />
        </RiverField>
    }
    <RefusedMessage Error="@Refused" />
    @if (_view is not null && Run.Pay is { } pay)
    {
        <div class="director-pay__lines">
            @if (Inputs.Company is not null)
            {
                <p class="director-pay__pay">
                    <span class="director-pay__pay-label">@L["PayFromSplit"] <OriginChip Origin="InputOrigin.Derived" /></span>
                    <span class="director-pay__pay-amount">@Formats.Euros(pay.GrossPay)</span>
                </p>
            }
            <FigureList Figures="@FigureWords.Of(L, DirectorPayFigures.Taxed(pay))" />
            <DrainList Drains="_view.Drains" />
        </div>
        @if (DirectorPayFigures.Surcharge(_view) is { Count: > 0 } topUp)
        {
            <FigureList Figures="@FigureWords.Of(L, topUp)" />
        }
        else
        {
            <p class="director-pay__condition">@L[DirectorPayCardText.Surcharge(_view.Surcharge)]</p>
        }
    }
    <Disclosure Title="@L["SituationTitle"]" Values="@SettingWords.Of(L, _settings.Situation)" Refused="@DirectorPaySettingsView.SituationHolds(Refused)">
        <RiverField Label="@L["PaidByLabel"]" Origin="Inputs.ContributionsPaidBy.Origin" Help="@L["PaidByHint"]">
            <div class="director-pay__payers">
                <MudChipSet T="ContributionsPaidBy" SelectedValue="Inputs.ContributionsPaidBy.Value" SelectedValueChanged="OnPaidByChanged"
                            SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                            Size="Size.Small">
                    @foreach (var payer in Enum.GetValues<ContributionsPaidBy>())
                    {
                        <MudChip T="ContributionsPaidBy" Value="payer" Text="@L[DirectorPayCardText.PaidBy(payer)]" />
                    }
                </MudChipSet>
            </div>
        </RiverField>
        <RiverField Label="@L["MunicipalityHead"]" Origin="Inputs.Municipality.Origin">
            <MunicipalityField Choice="Inputs.Municipality" ChoiceChanged="OnMunicipalityChanged"
                               Refused="@(Refused == GrossToNet.MunicipalRateOutOfRange)" />
        </RiverField>
        <div class="director-pay__status">
            <MudCheckBox T="bool" Value="Inputs.TaxPrepayments.Starter.Value" ValueChanged="OnStarterChanged" Color="Color.Primary"
                         Label="@L["StarterLabel", Inputs.IncomeYear - 2]" />
            <OriginChip Origin="Inputs.TaxPrepayments.Starter.Origin" />
        </div>
    </Disclosure>
    <Disclosure Title="@L["PrepaymentsTitle"]" Values="@SettingWords.Of(L, _settings.Prepaid)" Refused="@DirectorPaySettingsView.PrepaidHolds(Refused)"
                Help="@L["PrepaymentsHint"]">
        <RiverField Label="@L["WithheldLabel", Inputs.IncomeYear]" For="river-tax-withheld" Origin="_withheld.Origin" Help="@L["WithheldHint"]">
            <RiverNumericField T="decimal" InputId="river-tax-withheld" Value="_withheld.Amount" ValueChanged="OnWithheldChanged"
                               Euros="true"
                               Error="@(Refused == GrossToNet.TaxWithheldNegative)" Refusal="@Refused" />
            @if (_withheld.IsYours)
            {
                <div class="director-pay__note">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="OnWithheldAsPaySlip"
                               Class="director-pay__pay-slip-amount">@L["WithheldAsPaySlip"]</MudButton>
                </div>
            }
        </RiverField>
        <div class="director-pay__deadlines">
            @foreach (var field in TaxAdvancePaymentFields.From(Inputs))
            {
                <RiverField Label="@L["PaymentLabel", Formats.Day(field.Date)]" For="@($"river-tax-advance-payment-{field.Deadline}")" Origin="field.Paid.Origin">
                    <RiverNumericField T="decimal" InputId="@($"river-tax-advance-payment-{field.Deadline}")" Value="field.Paid.Value"
                                       ValueChanged="@(amount => OnAdvancePaymentChanged(field.Deadline, amount))"
                                       Euros="true"
                                       Error="@(Refused == GrossToNet.TaxAdvancePaymentNegative && field.Paid.Value < 0m)" Refusal="@Refused" />
                </RiverField>
            }
        </div>
    </Disclosure>
</ModuleCard>

@code {
    // As far as the pay page's slider went; the exact amount field takes any amount.
    private const decimal OwnPayMaximum = 200_000m;

    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's error key when it refuses the rate, what was withheld or paid in advance on the
    // pay, or the pay once the company is skipped.
    [Parameter]
    public string? Refused { get; set; }

    private DirectorPayView? _view;
    private WithheldFieldView _withheld = default!;
    private DirectorPaySettingsView _settings = default!;

    protected override void OnParametersSet()
    {
        _view = Run.Pay is { } pay ? DirectorPayView.From(Inputs, pay) : null;
        _withheld = WithheldFieldView.From(Inputs, Run);
        _settings = DirectorPaySettingsView.From(Inputs, Run);
    }

    // Where the slider of a pay of its own stands: the pay, within the slider's ends.
    private decimal OwnPay => Math.Clamp(Inputs.DirectorPay.Value, 0m, OwnPayMaximum);

    // What flows in is what the pay costs the company, the gross plus the contributions it pays, and a
    // copyright royalty's part taxed as pay.
    private string? Summary => Run.Pay is { } pay
        ? L["Summary", Formats.Euros(pay.CompanyCost + pay.RequalifiedPay), Formats.Euros(pay.NetInPocket)].Value
        : null;

    // What reaches the pocket, for the card's row in the river's outline.
    private CardGlance? Glance => Run.Pay is { } pay ? new(GlanceKind.ToYou, Formats.Euros(pay.NetInPocket)) : null;

    // The pay slip, above where each of its figures comes from.
    private RenderFragment? Details => Run.Pay is { } pay && _view is not null
        ? @<text>
              <PaySlip Pay="pay" RoyaltyFollowsPay="@DirectorPayView.NextHoldsAFollowingRoyalty(Run)" />
          </text>
        : null;

    private Task OnPayChanged(decimal pay) => InputsChanged.InvokeAsync(Inputs.WithDirectorPay(pay));

    private Task OnMunicipalityChanged(MunicipalityChoice choice) => InputsChanged.InvokeAsync(Inputs.WithMunicipality(choice));

    private Task OnPaidByChanged(ContributionsPaidBy paidBy) => InputsChanged.InvokeAsync(Inputs.WithContributionsPaidBy(paidBy));

    private Task OnWithheldChanged(decimal withheld) => InputsChanged.InvokeAsync(Inputs.WithTaxWithheld(withheld));

    private Task OnWithheldAsPaySlip() => InputsChanged.InvokeAsync(Inputs.WithTaxWithheldAsThePaySlip());

    private Task OnAdvancePaymentChanged(int deadline, decimal amount) => InputsChanged.InvokeAsync(Inputs.WithTaxAdvancePayment(deadline, amount));

    private Task OnStarterChanged(bool starter) => InputsChanged.InvokeAsync(Inputs.WithStarter(starter));
}
