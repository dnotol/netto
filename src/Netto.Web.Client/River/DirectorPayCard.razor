@using Netto.Core.Rules
@using Netto.Core.SocialContributions
@using Netto.Web.Client.DirectorPay
@inject IStringLocalizer<DirectorPayCard> L

@* The director's gross pay through INASTI's contributions, the income tax and the municipal
   surcharge to the net. The pay is typed here, with the company's year or without it: one slider over the
   profit before pay (the company's year decides how far it goes, why in its bubble, the bound staying in
   sight under the field) and the exact amount below it, taken when the field is left rather than while
   typing, since SplitView keeps the pay within the profit and MudBlazor redraws a field's text from its
   value only once it has lost focus; with a royalty that follows the pay the slider says both as it
   moves. The best pay and the curve of the pocket at every pay are Optimise's. Its figures come first,
   as one list: what the pay is taxed on besides it (DirectorPayFigures), then where the pay goes
   (DrainList); then what the withholding
   and the advance payments leave on the tax: a sentence saying why a surcharge is due or why none is,
   never what to pay to cancel it (that is Optimise's advance-payment move and its When to pay section). What the user rarely changes sits behind two
   disclosures after them, each folded to a line that states it: their situation, and the tax paid
   during the year. The user says who pays the contributions; when the company does, they are pay
   too, and what flows in says what the pay costs it. The rate of their fund's management fee is the
   user's, none until given, a percentage typed while the fee is a fraction; once given, the card's
   details say how Netto reads it, where no text names it as deductible. What was withheld on the pay
   is the pay slip's amount, derived, until the user types the amount actually withheld, with a way
   back; how it is derived is the field's bubble. It and what the director paid in advance are taken
   while typing, since nothing bounds them. The pay slip and the rules behind each figure are its detail view. *@
<ModuleCard Name="director-pay" Title="@L["Title"]" Summary="@Summary" ToYou="@_view?.ToYou" Refused="@Refused" Details="@Details"
            Sources="@(_view?.Details ?? [])" IncomeYear="Inputs.IncomeYear" DetailsLabel="@L["DetailsLabel"]" SourcesTitle="@L["SourcesTitle", Inputs.IncomeYear]">
    <RiverField Label="@L["OwnPayLabel"]" For="river-pay" Origin="Inputs.DirectorPay.Origin" Help="@(Inputs.Company is null ? null : Ceiling)">
        <MudSlider T="decimal" Value="@SliderPay" ValueChanged="OnPayChanged"
                   Min="0m" Max="SliderMaximum" Step="100m" Immediate="true" Color="Color.Primary" Culture="Formats.Culture"
                   Disabled="@(SliderMaximum == 0m)" aria-labelledby="river-pay-label" aria-valuetext="@SliderValue" />
        <RiverNumericField T="decimal" InputId="river-pay" Value="FieldPay" ValueChanged="OnPayChanged"
                           Euros="true" TakenOnLeaving="@(Inputs.Company is not null)"
                           Error="@(Refused?.Input == RefusedInput.DirectorPay)" Refusal="@Refused" />
        @if (Inputs.Company is not null)
        {
            <p class="director-pay__ceiling">@L["Ceiling", Formats.Euros(_split.Ceiling)]</p>
        }
    </RiverField>
    <RefusedMessage Error="@Refused" />
    @if (_view is not null && Run.Pay is { } pay)
    {
        <div class="director-pay__lines">
            <FigureList Figures="@FigureWords.Of(L, DirectorPayFigures.Taxed(pay))" />
            <DrainList Drains="_view.Drains" />
        </div>
        <p class="director-pay__condition">@L[DirectorPayCardText.Note(_view.Surcharge)]</p>
    }
    <Disclosure Title="@L["SituationTitle"]" Values="@SettingWords.Of(L, _settings.Situation)" Refused="@DirectorPaySettingsView.SituationHolds(Refused)">
        <RiverField Label="@L["PaidByLabel"]" Origin="Inputs.ContributionsPaidBy.Origin" Help="@L["PaidByHint"]">
            <div class="director-pay__payers">
                <MudChipSet T="ContributionsPaidBy" SelectedValue="Inputs.ContributionsPaidBy.Value" SelectedValueChanged="OnPaidByChanged"
                            SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                            Size="Size.Small">
                    @foreach (var payer in Enum.GetValues<ContributionsPaidBy>())
                    {
                        <MudChip T="ContributionsPaidBy" Value="payer" Text="@L[DirectorPayCardText.PaidBy(payer)]" />
                    }
                </MudChipSet>
            </div>
        </RiverField>
        <RiverField Label="@L["FundFeeLabel"]" For="river-fund-fee" Origin="@(Inputs.FundFeeRate.Value is null ? null : Inputs.FundFeeRate.Origin)"
                    Help="@L["FundFeeHint"]">
            <RiverNumericField T="decimal?" InputId="river-fund-fee" Value="FundFeePercent" ValueChanged="OnFundFeePercentChanged"
                               Format="0.##" Adornment="Adornment.End" AdornmentText="%"
                               Error="@(Refused?.Input == RefusedInput.FundFeeRate)" Refusal="@Refused" />
        </RiverField>
        <RiverField Label="@L["MunicipalityHead"]" Origin="Inputs.Municipality.Origin">
            <MunicipalityField Choice="Inputs.Municipality" ChoiceChanged="OnMunicipalityChanged"
                               Refused="@(Refused?.Input == RefusedInput.MunicipalRate)" />
        </RiverField>
        <div class="director-pay__status">
            <MudCheckBox T="bool" Value="Inputs.TaxPrepayments.Starter.Value" ValueChanged="OnStarterChanged" Color="Color.Primary" UncheckedColor="Color.Default"
                         Label="@L["StarterLabel", Inputs.IncomeYear - 2]" />
            <OriginChip Origin="Inputs.TaxPrepayments.Starter.Origin" />
        </div>
    </Disclosure>
    <Disclosure Title="@L["PrepaymentsTitle"]" Values="@SettingWords.Of(L, _settings.Prepaid)" Refused="@DirectorPaySettingsView.PrepaidHolds(Refused)"
                Help="@L["PrepaymentsHint"]">
        <RiverField Label="@L["WithheldLabel", Inputs.IncomeYear]" For="river-tax-withheld" Origin="_withheld.Origin" Help="@L["WithheldHint"]">
            <RiverNumericField T="decimal" InputId="river-tax-withheld" Value="_withheld.Amount" ValueChanged="OnWithheldChanged"
                               Euros="true"
                               Error="@(Refused?.Input == RefusedInput.TaxWithheld)" Refusal="@Refused" />
            @if (_withheld.IsYours)
            {
                <div class="director-pay__note">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="OnWithheldAsPaySlip"
                               Class="director-pay__pay-slip-amount">@L["WithheldAsPaySlip"]</MudButton>
                </div>
            }
        </RiverField>
        <div class="director-pay__deadlines">
            @foreach (var field in TaxAdvancePaymentFields.From(Inputs))
            {
                <RiverField Label="@L["PaymentLabel", Formats.Day(field.Date)]" For="@($"river-tax-advance-payment-{field.Deadline}")" Origin="field.Paid.Origin">
                    <RiverNumericField T="decimal" InputId="@($"river-tax-advance-payment-{field.Deadline}")" Value="field.Paid.Value"
                                       ValueChanged="@(amount => OnAdvancePaymentChanged(field.Deadline, amount))"
                                       Euros="true"
                                       Error="@(Refused?.Input == RefusedInput.DirectorAdvancePayments && field.Paid.Value < 0m)" Refusal="@Refused" />
                </RiverField>
            }
        </div>
    </Disclosure>
</ModuleCard>

@code {
    // As far as the pay page's slider went; the exact amount field takes any amount.
    private const decimal OwnPayMaximum = 200_000m;

    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's refusal of the rate, what was withheld or paid in advance on the
    // pay, or the pay once the company is skipped.
    [Parameter]
    public Refusal? Refused { get; set; }

    private DirectorPayView? _view;
    private SplitView _split = default!;
    private WithheldFieldView _withheld = default!;
    private DirectorPaySettingsView _settings = default!;

    protected override void OnParametersSet()
    {
        _view = Run.Pay is { } pay ? DirectorPayView.From(Inputs, pay) : null;
        _split = SplitView.From(Inputs, Run);
        _withheld = WithheldFieldView.From(Inputs, Run);
        _settings = DirectorPaySettingsView.From(Inputs, Run);
    }

    // With the company's year the slider runs over the profit before pay and stands on the pay the year gives;
    // without it, as far as the pay page's slider went, the pay within its ends.
    private decimal SliderMaximum => Inputs.Company is null ? OwnPayMaximum : _split.Ceiling;

    private decimal SliderPay => Inputs.Company is null ? Math.Clamp(Inputs.DirectorPay.Value, 0m, OwnPayMaximum) : _split.Pay;

    // The exact amount shows the pay the year gives, or what was typed while that is refused.
    private decimal FieldPay => Inputs.Company is null ? Inputs.DirectorPay.Value : _split.FieldPay;

    // Why the pay goes no further, in the field's bubble, its bound staying in sight under it.
    private string Ceiling => L[DirectorPayCardText.CeilingHint(_split.Royalty)].Value;

    // The pay, and the royalty beside it while it follows the pay, so the slider says both as it moves.
    private string SliderValue => _split.Royalty is { FollowsPay.Value: true, Amount: { } royalty } && Inputs.Company is not null
        ? L[DirectorPayCardText.SliderValueWithRoyalty, Formats.Euros(SliderPay), Formats.Euros(royalty)].Value
        : Formats.Euros(SliderPay);

    // What flows in is what the pay costs the company, the gross plus the contributions it pays, and a
    // copyright royalty's part taxed as pay.
    private string? Summary => Run.Pay is { } pay
        ? L["Summary", Formats.Euros(pay.CompanyCost + pay.RequalifiedPay), Formats.Euros(pay.NetInPocket)].Value
        : null;


    // The pay slip, above where each of its figures comes from, and, while a fund fee is given, the
    // reading Netto takes of it where no text names it as deductible, word for word, first.
    private RenderFragment? Details => Run.Pay is { } pay && _view is not null
        ? @<text>
              @if (Inputs.FundFeeRate.Value is not null)
              {
                  <p class="director-pay__reading">@L["FundFeeReading"]</p>
              }
              <PaySlip Pay="pay" RoyaltyFollowsPay="@DirectorPayView.NextHoldsAFollowingRoyalty(Run)" />
          </text>
        : null;

    // The fee's rate as the field shows it, a percentage: 3.05 for 0.0305; none until given.
    private decimal? FundFeePercent => Inputs.FundFeeRate.Value * 100m;

    private Task OnPayChanged(decimal pay) => InputsChanged.InvokeAsync(Inputs.WithDirectorPay(pay));

    private Task OnMunicipalityChanged(MunicipalityChoice choice) => InputsChanged.InvokeAsync(Inputs.WithMunicipality(choice));

    private Task OnPaidByChanged(ContributionsPaidBy paidBy) => InputsChanged.InvokeAsync(Inputs.WithContributionsPaidBy(paidBy));

    // Cleared, the rate is none again.
    private Task OnFundFeePercentChanged(decimal? percent) => InputsChanged.InvokeAsync(Inputs.WithFundFeeRate(percent / 100m));

    private Task OnWithheldChanged(decimal withheld) => InputsChanged.InvokeAsync(Inputs.WithTaxWithheld(withheld));

    private Task OnWithheldAsPaySlip() => InputsChanged.InvokeAsync(Inputs.WithTaxWithheldAsThePaySlip());

    private Task OnAdvancePaymentChanged(int deadline, decimal amount) => InputsChanged.InvokeAsync(Inputs.WithTaxAdvancePayment(deadline, amount));

    private Task OnStarterChanged(bool starter) => InputsChanged.InvokeAsync(Inputs.WithStarter(starter));
}
