@implements IDisposable
@using Netto.Core.Rules
@using Netto.Web.Client.Steps
@inject IStringLocalizer<ModuleCard> L

@* The frame every module of the river shares: its title and what flows through it, on the one line it
   folds to (Fold), where it starts until opened, and which a refusal inside opens (Refused), with what
   the module is in a bubble at its end (Help), then its controls and its detail view, folded under them
   to one line of its own (Fold, level 3) and opened on demand: what the card gives there (Details),
   then the rules its steps cite (Sources) with the income year's amounts, worded here for every card
   unless the card words its own (DetailsLabel, SourcesTitle); and last, for an optional module, the
   word that takes it out of the plan. A skipped module is drawn dashed: Company year with its own
   word, any other waiting for the company's year (Waiting), which it says instead of its content. The
   summary ends on one share, worded here for every card: what reaches the pocket of what the module
   receives (ToYou), or, for Corporate tax, what it passes on (PassesOn); none while no money flows
   through it.
   Every time it is drawn, it tells the river's outline (OutlineRows) its title, one figure of its
   summary (Glance) and its fold, and leaves the outline as it goes; the outline finds it by its id. *@
<section id="@($"card-{Name}")" class="module-card @(Skipped || Waiting ? "module-card--skipped" : null)" aria-labelledby="@_titleId">
    <Fold @ref="_fold" Name="@Name" Title="@Title" TitleId="@_titleId" Summary="@Summary" Rate="@Rate" Help="@Help" Refused="@(Refused is not null)" Pinned="@(Seat is not null)">
        <div class="module-card__body">
            @if (Waiting)
            {
                <p class="module-card__waiting">@L[ModuleCardText.Waiting]</p>
            }
            else
            {
                @ChildContent
                @if (Details is not null || Sources.Count > 0)
                {
                    <Fold Name="@($"{Name}-details")" Title="@(DetailsLabel ?? L[ModuleCardText.DetailsLabel].Value)" Level="3">
                        <div class="module-card__detail">
                            @Details
                            @if (Sources.Count > 0)
                            {
                                <h4 class="module-card__sources">@(SourcesTitle ?? L[ModuleCardText.SourcesTitle, IncomeYear].Value)</h4>
                                <StepDetails Details="Sources" />
                            }
                        </div>
                    </Fold>
                }
            }
            @if (RemoveLabel is not null)
            {
                <div class="module-card__remove">
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="OnRemove">@RemoveLabel</MudButton>
                </div>
            }
        </div>
    </Fold>
</section>

@code {
    // Where the card's fold is remembered, and its detail view's under the same name.
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    // What flows in and out, in a few words beside the title.
    [Parameter]
    public string? Summary { get; set; }

    // One figure of the summary, as the summary formats it, for the card's row in the river's outline;
    // none while the summary has no figure.
    [Parameter]
    public CardGlance? Glance { get; set; }

    // What reaches the pocket of what the module receives.
    [Parameter]
    public decimal? ToYou { get; set; }

    // What the module passes on of what it receives, for one that reaches no pocket itself.
    [Parameter]
    public decimal? PassesOn { get; set; }

    // What the module is, in a bubble at the end of the heading's row.
    [Parameter]
    public string? Help { get; set; }

    // Company year once its figures are cleared: drawn dashed, its content saying so.
    [Parameter]
    public bool Skipped { get; set; }

    // A module waiting for the company's year: drawn dashed, saying so instead of its content.
    [Parameter]
    public bool Waiting { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // What the card gives in its detail view before the rules: the pay slip, a rule its figures rest on
    // beyond their steps' own.
    [Parameter]
    public RenderFragment? Details { get; set; }

    // The engine's steps the card's figures come from, each with the texts and amounts it cites, under
    // the rules of the income year: none for a card with no figures yet.
    [Parameter]
    public IReadOnlyList<StepDetail> Sources { get; set; } = [];

    [Parameter]
    public int IncomeYear { get; set; }

    // The engine's refusal of a field of this card: the card opens, and stays open, so a refusal is never
    // hidden.
    [Parameter]
    public Refusal? Refused { get; set; }

    // The detail view's line, folded or open, and the title over its rules, for a card that words its
    // own; « Where these figures come from » and « The rules, with the income year … amounts » otherwise.
    [Parameter]
    public string? DetailsLabel { get; set; }

    [Parameter]
    public string? SourcesTitle { get; set; }

    // An optional module's « Remove … from your plan », a word at the bottom of the open card; none
    // for a core module.
    [Parameter]
    public string? RemoveLabel { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    // The page's outline, where there is one (Plan).
    [CascadingParameter]
    private OutlineRows? Outline { get; set; }

    // The seat the Map tab's panel gives the card of the module chosen, beside its map, where there is one:
    // the card is then pinned open and takes the focus on its first draw if the seat says so.
    [CascadingParameter]
    private PinnedCard? Seat { get; set; }

    private readonly string _titleId = $"module-{Guid.NewGuid():N}";
    private Fold? _fold;

    // The outline draws the card again once it opens it, since a fold reads its state when drawn.
    protected override void OnParametersSet() => Outline?.Report(new OutlineRow(Name, Title, Glance), StateHasChanged);

    // A module the viewer has just chosen on the map: its card, drawn now beside it, takes the focus.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Seat is { TakesFocus: true } && _fold is not null)
            await _fold.FocusAsync();
    }

    public void Dispose() => Outline?.Leave(Name);

    private string? Rate => (ToYou, PassesOn) switch
    {
        ({ } share, _) => L[ModuleCardText.ToYou, Formats.WholeShare(share)].Value,
        (_, { } share) => L[ModuleCardText.PassesOn, Formats.WholeShare(share)].Value,
        _ => null,
    };
}
