@* The frame every module of the river shares: its title and what flows through it, on the one line it
   folds to (Fold), with what the module is in a bubble at its end (Help), then its controls and its detail view, folded under them to one line of its own
   (Fold, level 3) and opened on demand, and last, for an optional module, the word that takes it out
   of the plan. A skipped module is drawn dashed, waiting for the amounts it needs. *@
<section class="module-card @(Skipped ? "module-card--skipped" : null)" aria-labelledby="@_titleId">
    <Fold Name="@Name" Title="@Title" TitleId="@_titleId" Summary="@Summary" Help="@Help">
        <div class="module-card__body">
            @ChildContent
            @if (Details is not null)
            {
                <Fold Name="@($"{Name}-details")" Title="@DetailsLabel" Level="3" OpenByDefault="false">
                    <div class="module-card__detail">@Details</div>
                </Fold>
            }
            @if (RemoveLabel is not null)
            {
                <div class="module-card__remove">
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="OnRemove">@RemoveLabel</MudButton>
                </div>
            }
        </div>
    </Fold>
</section>

@code {
    // Where the card's fold is remembered, and its detail view's under the same name.
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    // What flows in and out, in a few words beside the title.
    [Parameter]
    public string? Summary { get; set; }

    // What the module is, in a bubble at the end of the heading's row.
    [Parameter]
    public string? Help { get; set; }

    [Parameter]
    public bool Skipped { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // The depth behind the module's figures: the pay slip, the rules and their sources.
    [Parameter]
    public RenderFragment? Details { get; set; }

    // The detail view's line, folded or open.
    [Parameter]
    public string DetailsLabel { get; set; } = "";

    // An optional module's « Remove … from your plan », a word at the bottom of the open card; none
    // for a core module.
    [Parameter]
    public string? RemoveLabel { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private readonly string _titleId = $"module-{Guid.NewGuid():N}";
}
