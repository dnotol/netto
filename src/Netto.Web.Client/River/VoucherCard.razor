@using Netto.Core.Vouchers
@using Netto.Web.Client.Steps
@inject IStringLocalizer<VoucherCard> L

@* What the company pays the director besides pay, before the split: meal vouchers, one per day
   worked, with the most the company may pay into each, and the year's eco and sport/culture
   vouchers. They reach the pocket untaxed and outside INASTI, and the company pays them out of its
   profit before pay; what it cannot deduct of them is added back to its taxable income. What they
   leave goes on to the next module in the plan, or the split. An optional module: it shows only while
   in the plan, and the word at its bottom takes it out, its values kept. Netto cannot see the
   agreement or the days worked, so the card lists the conditions with their texts. The amounts are
   taken while typing, like revenue, and carry no Min or Max: the engine refuses what the rules do not
   allow, and its message is what the user has to see. Skipped with the company. *@
<ModuleCard Name="vouchers" Title="@L["Title"]" Summary="@Summary" ToYou="@_view?.ToYou" Help="@L["Hint"]" Skipped="Inputs.Company is null" Details="@Details"
            DetailsLabel="@L["DetailsLabel"]" RemoveLabel="@L["Remove"]" OnRemove="Remove">
    @if (Inputs.Company is null)
    {
        <p class="vouchers__waiting">@L["Waiting"]</p>
    }
    else
    {
        <div class="vouchers__fields">
            <RiverField Label="@L["MealDaysLabel"]" For="river-meal-voucher-days" Origin="Inputs.Vouchers.MealVoucherDays.Origin">
                <RiverNumericField T="int" InputId="river-meal-voucher-days" Value="Inputs.Vouchers.MealVoucherDays.Value" ValueChanged="OnMealVoucherDaysChanged"
                                   Culture="Formats.Culture" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                   DebounceInterval="400"
                                   Error="@(Refused is VoucherCalculator.MealVoucherDaysNegative or VoucherCalculator.MealVoucherDaysAboveYear)" Refusal="@Refused" />
                @if (_rules is not null)
                {
                    <p class="vouchers__note">@L["MealDaysHint", Formats.RuleAmount(_rules.MealVoucherCompanyShare), Formats.RuleAmount(_rules.MealVoucherHolderShare)]</p>
                }
            </RiverField>
            <RiverField Label="@L["EcoLabel"]" For="river-eco-vouchers" Origin="Inputs.Vouchers.EcoVouchers.Origin">
                <RiverNumericField T="decimal" InputId="river-eco-vouchers" Value="Inputs.Vouchers.EcoVouchers.Value" ValueChanged="OnEcoVouchersChanged"
                                   Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="400"
                                   Error="@(Refused is VoucherCalculator.EcoVouchersNegative or VoucherCalculator.EcoVouchersAboveMaximum)" Refusal="@Refused" />
                @if (_rules is not null)
                {
                    <p class="vouchers__note">@L["YearlyMaximum", Formats.RuleAmount(_rules.EcoVouchersMaximum)]</p>
                }
            </RiverField>
            <RiverField Label="@L["SportCultureLabel"]" For="river-sport-culture-vouchers" Origin="Inputs.Vouchers.SportCultureVouchers.Origin">
                <RiverNumericField T="decimal" InputId="river-sport-culture-vouchers" Value="Inputs.Vouchers.SportCultureVouchers.Value"
                                   ValueChanged="OnSportCultureVouchersChanged"
                                   Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="400"
                                   Error="@(Refused is VoucherCalculator.SportCultureVouchersNegative or VoucherCalculator.SportCultureVouchersAboveMaximum)" Refusal="@Refused" />
                @if (_rules is not null)
                {
                    <p class="vouchers__note">@L["YearlyMaximum", Formats.RuleAmount(_rules.SportCultureVouchersMaximum)]</p>
                }
            </RiverField>
        </div>
        <RefusedMessage Error="@Refused" />
        @if (_view is { Total: > 0m } shown)
        {
            <p class="vouchers__disallowed">@L["Disallowed", Formats.Euros(shown.Total), Formats.Euros(shown.Deductible), Formats.Euros(shown.Disallowed)]</p>
        }
        @if (_view is not null)
        {
            <DrainList Drains="_view.Drains" />
        }
        @if (_rules is not null)
        {
            <ConditionList Name="vouchers-conditions" Conditions="_rules.Conditions" />
        }
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's error key when it refuses a voucher.
    [Parameter]
    public string? Refused { get; set; }

    private VoucherView? _view;
    private VoucherRules? _rules;

    protected override void OnParametersSet()
    {
        _view = Run.Year is { } year ? VoucherView.From(year, Inputs.Composition) : null;
        _rules = VoucherRules.For(Inputs.IncomeYear);
    }

    private string? Summary => _view is { } view
        ? L["Summary", Formats.Euros(view.Total), Formats.Euros(view.Left)].Value
        : null;

    private RenderFragment? Details => _view is { Details.Count: > 0 } view && Run.Year is { } year
        ? @<text>
              <h4 class="vouchers__sources">@L["SourcesTitle", year.Scenario.IncomeYear]</h4>
              <StepDetails Details="view.Details" />
          </text>
        : null;

    private Task OnMealVoucherDaysChanged(int days) => InputsChanged.InvokeAsync(Inputs.WithMealVoucherDays(days));

    private Task OnEcoVouchersChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithEcoVouchers(amount));

    private Task OnSportCultureVouchersChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithSportCultureVouchers(amount));

    private Task Remove() => InputsChanged.InvokeAsync(Inputs.TakeOutOfPlan(OptionalModule.Vouchers));
}
