@* An input of the river under its label, with its origin beside the label and, after the label, an
   info bubble with what helps to fill it in (Help), outside the label so that it is never part of
   what a click on the label does. The input is the child content: a field takes the label through
   InputId (For), a slider through aria-labelledby ({For}-label). Without For, the label names a group
   of controls that carry their own names, such as a set of chips, and the field is that group. *@
<div class="river-field" role="@(For is null ? "group" : null)" aria-labelledby="@(For is null ? _groupLabelId : null)">
    <div class="river-field__head">
        <span class="river-field__name">
            @if (For is not null)
            {
                <label id="@($"{For}-label")" class="river-field__label" for="@For">@Label</label>
            }
            else
            {
                <span id="@_groupLabelId" class="river-field__label">@Label</span>
            }
            @if (Help is not null)
            {
                <InfoBubble Label="@Label">@Help</InfoBubble>
            }
        </span>
        @if (Origin is { } origin)
        {
            <OriginChip Origin="origin" />
        }
    </div>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? For { get; set; }

    // Null for an input with no value yet and no default to show, such as the creative share. An amount
    // the example holds none of (InputOrigin.None) draws no chip either.
    [Parameter, EditorRequired]
    public InputOrigin? Origin { get; set; }

    // What helps to fill the input in, in a bubble after the label.
    [Parameter]
    public string? Help { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private readonly string _groupLabelId = $"river-group-{Guid.NewGuid():N}";
}
