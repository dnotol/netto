@using Netto.Core.Rules
@inject IStringLocalizer<ConditionList> L

@* The conditions of a lever that Netto cannot check, the same list on every lever card: folded to one
   line that counts them (Fold, level 3), opened on demand. Each condition reads in its own words with
   the amounts they name, and cites the texts it comes from by their short labels, each a link to its
   document carrying the text's full title. *@
<div class="conditions">
    <Fold Name="@Name" Title="@Heading" Level="3">
        <ul class="conditions__list">
            @foreach (var condition in Conditions)
            {
                <li class="conditions__item">
                    <span>@L[ConditionListText.Condition(condition.Key), [.. condition.Amounts.Select(Formats.RuleAmount)]]</span>
                    <span class="conditions__sources">
                        @foreach (var source in condition.Sources)
                        {
                            <a href="@source.Url" target="_blank" rel="noopener noreferrer" title="@source.Title" class="conditions__source">
                                @source.Label<MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" aria-hidden="true" />
                            </a>
                        }
                    </span>
                </li>
            }
        </ul>
    </Fold>
</div>

@code {
    // Where the list's fold is remembered.
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<LeverCondition> Conditions { get; set; } = [];

    private string Heading => L[ConditionListText.Heading(Conditions.Count), Conditions.Count].Value;
}
