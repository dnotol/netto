@using System.Globalization
@using Netto.Core.Rules
@using Netto.Core.Simulation
@inject IStringLocalizer<SplitCard> L

@* One pay slider over the profit before pay: every euro taken as pay is a euro less of company
   profit. Above it, the engine's search draws the net in pocket at every pay, with the pay set and
   the best pay marked; pointing at the curve reads a pay, in a line that keeps its room while the
   pointer is away, and a click moves the pay there. What the pointer reads is no live region: it
   changes at every step of the slider, and the bar of buckets says what reaches the pocket once the
   pay settles. The exact amount can be typed below, taken when the field is left rather than while
   typing: SplitView keeps the pay within the profit, and MudBlazor redraws a field's text from its
   value only once it has lost focus. How far the pay goes stays in sight under the field, why in its
   bubble.

   Then the card's figures, as lines (SplitFigures): what the split shares, each side out of what it
   receives, and the best pay with what it leaves against the pay set, a sentence saying only how it
   stands against the reduced corporate rate, or that no pay keeps the reserve.

   With Copyright royalty in the plan, the split also pays the royalty beside the pay, and shares what
   the levers leave three ways (operator, 2026-10-23): the royalty follows the pay, what an advance
   ruling accepts at each pay, so moving the pay moves it and the curve weighs both, or it is a fixed
   amount, typed here, taken while typing. Following, its figure is among the split's sides, or the
   card says why it is none;
   the creative share it reads is set on the Copyright royalty card below, with the royalty's other
   facts. A refusal of the royalty marks its field, of the pay the pay's.

   The plot stretches to the card's width (preserveAspectRatio="none"), so its lines keep their
   width through vector-effect, and what must keep its shape (the best pay's dot, the axes' labels) is
   HTML placed over it in percentages. *@
<ModuleCard Name="split" Title="@L["Title"]" Summary="@Summary" Glance="@Glance" Help="@L[SplitCardText.Hint(_view.Royalty)]" Refused="@Refused">
    <RiverField Label="@L["PayLabel"]" For="river-split-pay" Origin="Inputs.DirectorPay.Origin" Help="@PayHelp">
        <div class="pay-curve @(_search is null ? "pay-curve--bare" : null)">
            @if (_search is { } search)
            {
                var curve = search.Curve;
                <div class="pay-curve__net-axis" aria-hidden="true">
                    @foreach (var tick in curve.NetTicks)
                    {
                        <span class="pay-curve__net-tick" style="bottom: @Percent(tick.At)">@Formats.ThousandsOfEuros(tick.Amount)</span>
                    }
                </div>
                <div class="pay-curve__plot" @onmouseleave="ClearPointer">
                    <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" role="img" aria-label="@ChartLabel">
                        @foreach (var tick in curve.NetTicks)
                        {
                            <line class="pay-curve__grid" x1="0" x2="1000" y1="@Y(tick.At)" y2="@Y(tick.At)" />
                        }
                        @if (curve.ThresholdAt is { } threshold)
                        {
                            <line class="pay-curve__threshold" x1="@X(threshold)" x2="@X(threshold)" y1="0" y2="1000" />
                        }
                        @foreach (var run in curve.Runs)
                        {
                            <polyline class="pay-curve__net @(run.KeepsReserve ? null : "pay-curve__net--misses")" points="@Points(run.Points)" />
                        }
                        <line class="pay-curve__yours" x1="@X(curve.PayAt)" x2="@X(curve.PayAt)" y1="0" y2="1000" />
                        @if (_pointer is { } pointed)
                        {
                            <line class="pay-curve__pointer" x1="@X(pointed.Pay / _top)" x2="@X(pointed.Pay / _top)" y1="0" y2="1000" />
                        }
                        @foreach (var band in curve.Bands)
                        {
                            <rect class="pay-curve__band" x="@X(band.From)" width="@Length(band.To - band.From)" y="0" height="1000"
                                  @onmouseover="() => Point(band.Level)" @onclick="() => MoveTo(band.Level.Pay)" />
                        }
                    </svg>
                    @if (curve.BestAt is { } best)
                    {
                        <span class="pay-curve__best" style="left: @Percent(best.X); bottom: @Percent(best.Y)"></span>
                    }
                </div>
                <div class="pay-curve__pay-axis" aria-hidden="true">
                    @foreach (var tick in curve.PayTicks)
                    {
                        <span class="pay-curve__pay-tick" style="left: @Percent(tick.At)">@Formats.ThousandsOfEuros(tick.Amount)</span>
                    }
                </div>
            }
            <div class="pay-curve__slider">
                <MudSlider T="decimal" Value="_view.Pay" ValueChanged="OnPayChanged" Min="0m" Max="_view.Ceiling" Step="100m"
                           Immediate="true" Color="Color.Primary" Culture="Formats.Culture" Disabled="@(_view.Ceiling == 0m)"
                           aria-labelledby="river-split-pay-label" aria-valuetext="@SliderValue" />
            </div>
        </div>
        <RiverNumericField T="decimal" InputId="river-split-pay" Value="_view.FieldPay" ValueChanged="OnPayChanged"
                           Euros="true" TakenOnLeaving="true"
                           Error="@(Refused?.Input == RefusedInput.DirectorPay)" Refusal="@Refused" />
        <p class="split__ceiling">@L["Ceiling", Formats.Euros(_view.Ceiling)]</p>
    </RiverField>
    @if (_search is { } shown)
    {
        <ul class="pay-curve__key">
            <li><span class="pay-curve__key-mark pay-curve__key-mark--yours"></span>@L["KeyYourPay"]</li>
            @if (shown.Best is not null)
            {
                <li><span class="pay-curve__key-mark pay-curve__key-mark--best"></span>@L["KeyBest"]</li>
            }
            @if (Search?.SmallestPayKeepingReducedRate is { } smallest)
            {
                <li><span class="pay-curve__key-mark pay-curve__key-mark--threshold"></span>@L["KeyThreshold", Formats.Euros(smallest)]</li>
            }
            @if (shown.Curve.SomeMissReserve)
            {
                <li><span class="pay-curve__key-mark pay-curve__key-mark--misses"></span>@L["KeyMissesReserve", Formats.Euros(Inputs.Reserve.Value)]</li>
            }
        </ul>
    }
    @if (_view.Royalty is { } royalty)
    {
        <RiverField Label="@L["RoyaltyLabel"]" Origin="royalty.FollowsPay.Origin" Help="@L["RoyaltyHint"]">
            <div class="split__policies">
                <MudChipSet T="bool" SelectedValue="royalty.FollowsPay.Value" SelectedValueChanged="OnPolicyChanged"
                            SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                            Size="Size.Small">
                    <MudChip T="bool" Value="true" Text="@L[SplitCardText.Policy(true)]" />
                    <MudChip T="bool" Value="false" Text="@L[SplitCardText.Policy(false)]" />
                </MudChipSet>
            </div>
            @if (royalty is { FollowsPay.Value: true, Following: { } following } && SplitCardText.Following(following) is { } none)
            {
                <p class="split__following">@L[none, Inputs.IncomeYear]</p>
            }
        </RiverField>
        @if (!royalty.FollowsPay.Value)
        {
            <RiverField Label="@L["FixedRoyaltyLabel"]" For="river-split-royalty" Origin="royalty.Fixed.Origin" Help="@L["FixedRoyaltyHint"]">
                <RiverNumericField T="decimal" InputId="river-split-royalty" Value="royalty.Fixed.Value" ValueChanged="OnRoyaltyChanged"
                                   Euros="true"
                                   Error="@RoyaltyRefused" Refusal="@Refused" />
            </RiverField>
        }
    }
    <RefusedMessage Error="@Refused" />
    <FigureList Figures="@FigureWords.Of(L, SplitFigures.Sides(_view, Run.Year))" />
    @if (_search is { } weighed && Run.Year is { } year)
    {
        <p class="split__pointer">@PointerText</p>
        @if (weighed.Best is not null)
        {
            <FigureList Figures="@FigureWords.Of(L, SplitFigures.Best(weighed, year, _view.Royalty, Inputs.Reserve.Value))" />
            @if (weighed.Rate is { } rate)
            {
                <p class="split__rate"><TermSentence Text="@RateText(rate)" Meaning="@L[SplitCardText.ReducedRateTerm]" /></p>
            }
        }
        else
        {
            <p class="split__best">@L["NoBest", Formats.Euros(Inputs.Reserve.Value), Formats.Euros(weighed.MostKept)]</p>
        }
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's search across every pay, which the page runs again only when an input other than
    // the pay changes.
    [Parameter]
    public SplitSearchResult? Search { get; set; }

    // The engine's refusal of the pay or the royalty.
    [Parameter]
    public Refusal? Refused { get; set; }

    private SplitView _view = default!;
    private SplitSearchView? _search;
    private decimal _top;
    private PayLevel? _pointer;

    protected override void OnParametersSet()
    {
        _view = SplitView.From(Inputs, Run);
        _search = SplitSearchView.From(Inputs, Run, Search);
        _top = Search?.Curve[^1].Pay ?? 0m;
        if (_search is null)
            _pointer = null;
    }

    // The best pay is in the summary too, so the split folded still says where the pay could go; the
    // royalty too, once it is in the plan.
    private string? Summary => _view.CompanyProfit is { } profit
        ? L[SplitCardText.Summary(_view.Royalty, _search?.Best is not null), Formats.WholeEuros(_view.Pay), Formats.WholeEuros(profit),
            _search?.Best is { } best ? Formats.WholeEuros(best.Level.Pay) : "", Formats.WholeEuros(_view.Royalty?.Amount ?? 0m)].Value
        : null;

    // What the split gives the pay, for the card's row in the river's outline.
    private CardGlance? Glance => _view.CompanyProfit is not null ? new(GlanceKind.ToYourPay, Formats.WholeEuros(_view.Pay)) : null;

    private string ChartLabel => L["ChartLabel", Formats.Euros(0m), Formats.Euros(_top)].Value;

    // Why the pay goes no further, its bound staying in sight under the field, and, with the curve
    // drawn, how to read it.
    private string PayHelp => _search is null ? Ceiling : $"{Ceiling} {L["CurveHint"]}";

    private string Ceiling => L[SplitCardText.CeilingHint(_view.Royalty)].Value;

    // The pay, and the royalty beside it while it follows the pay, so the slider says both as it moves.
    private string SliderValue => _view.Royalty is { FollowsPay.Value: true, Amount: { } royalty }
        ? L[SplitCardText.SliderValueWithRoyalty, Formats.Euros(_view.Pay), Formats.Euros(royalty)].Value
        : Formats.Euros(_view.Pay);

    // What the pointer reads of the pay it is on; nothing while it is away from the curve.
    private string PointerText => SplitFigures.Pointer(_pointer, _view.Royalty) is { } reading ? L[reading.Key, [.. reading.Args]].Value : "";

    private bool RoyaltyRefused => Refused?.Input == RefusedInput.Royalty;

    // What giving the rate up, or keeping it, leaves less, where the sentence weighs it.
    private string RateText(RateWeighing rate) => L[SplitCardText.Rate(rate, _view.Pay), rate.Difference is { } difference ? Formats.Euros(difference) : ""].Value;

    private void Point(PayLevel level) => _pointer = level;

    private void ClearPointer() => _pointer = null;

    private Task MoveTo(decimal pay) => InputsChanged.InvokeAsync(Inputs.WithDirectorPay(pay));

    private Task OnPayChanged(decimal pay) => InputsChanged.InvokeAsync(Inputs.WithDirectorPay(pay));

    // Fixed from following, the royalty stays what it came to at the pay.
    private Task OnPolicyChanged(bool followsPay) =>
        InputsChanged.InvokeAsync(followsPay ? Inputs.WithRoyaltyFollowingPay() : Inputs.WithRoyaltyFixed());

    private Task OnRoyaltyChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithRoyalty(amount));

    // The plot's coordinates run from 0 to 1,000 both ways, the net in pocket upwards.
    private static string X(decimal at) => Coordinate(at * 1_000m);

    private static string Y(decimal at) => Coordinate((1m - at) * 1_000m);

    private static string Length(decimal fraction) => Coordinate(fraction * 1_000m);

    private static string Points(IReadOnlyList<ChartPoint> points) => string.Join(' ', points.Select(point => $"{X(point.X)},{Y(point.Y)}"));

    private static string Percent(decimal at) => $"{Coordinate(at * 100m)}%";

    private static string Coordinate(decimal value) => Math.Round(value, 2).ToString("0.##", CultureInfo.InvariantCulture);
}
