@using Netto.Core.Copyright
@using Netto.Core.CorporateTax
@using Netto.Core.Rules
@using Netto.Web.Client.River
@inject IStringLocalizer<CopyrightCard> L

@* At the top of the director's stream, after the split, which pays it beside the pay: a copyright
   royalty the company pays the director for the rights on works they created, which the card receives
   and drains. The split decides it, following the pay or fixed (operator, 2026-10-23); here the user
   says whether their copyright income of the four previous years averaged at most the year's cap, met
   unless they say otherwise, whether they hold an attestation du travail des arts for these works, none
   unless they say so, and the share of their working time spent creating, which a royalty that
   follows the pay and the moves read, none until given; the three sit behind one disclosure, « Your
   copyright situation », folded to a line that states them. Its figures come first, as lines
   (CopyrightFigures): the royalty, the part within the limits and the part beyond them, taxed as pay,
   the flat-rate costs the attestation takes off the first part and what the company withholds on each,
   with a sentence for which limit set the part within; then the plan with the royalty and the same plan
   without it, each by what reaches the pocket and what goes to the taxes on pay and on profit, and the
   difference, both at the pay the plan with the royalty runs at, which a note names once the pay set is
   held below (CopyrightComparison.PayHeld); then where its money goes: its tax apart, what of the part within reaches the pocket and
   the part beyond going on to Director pay. Where no text settles a point, the reading Netto takes is in
   its details, above the sources. An optional module: it shows only while in the plan, and the word at
   its bottom takes it out, its values kept. Skipped with the company. *@
<ModuleCard Name="@ModuleFolds.Name(OptionalModule.Copyright)" Title="@L["Title"]" Summary="@Summary" Glance="@Glance" ToYou="@_view?.ToYou" Help="@L["Hint"]" Waiting="Inputs.Company is null"
            Refused="@Refused" Details="@Details" Sources="@(_view?.Details ?? [])" IncomeYear="Inputs.IncomeYear" RemoveLabel="@L["Remove"]" OnRemove="Remove">
    <Disclosure Title="@L["SituationTitle"]" Values="@SettingWords.Of(L, _settings.Situation)" Refused="@CopyrightSettingsView.SituationHolds(Refused)"
                OpenByDefault="@_settings.NeedsFacts">
        <RiverField Label="@L["CreativeShareLabel"]" For="river-copyright-creative-share"
                    Origin="@(Inputs.Copyright.CreativeShare.Value is null ? null : Inputs.Copyright.CreativeShare.Origin)" Help="@L["CreativeShareHint"]">
            <RiverNumericField T="decimal?" InputId="river-copyright-creative-share" Value="CreativeSharePercent" ValueChanged="OnCreativeSharePercentChanged"
                               Format="0.##" Adornment="Adornment.End" AdornmentText="%"
                               Error="@(Refused?.Input == RefusedInput.CreativeShare)" Refusal="@Refused" />
        </RiverField>
        <div class="copyright__tick">
            <MudCheckBox T="bool" Value="Inputs.Copyright.AverageWithinCap.Value" ValueChanged="OnAverageChanged" Color="Color.Primary"
                         Label="@L["AverageLabel", Formats.Euros(_rules?.Cap.Value ?? 0m)]" />
            <OriginChip Origin="Inputs.Copyright.AverageWithinCap.Origin" />
            <InfoBubble Label="@L["AverageLabel", Formats.Euros(_rules?.Cap.Value ?? 0m)]">@L["AverageHint"]</InfoBubble>
        </div>
        <div class="copyright__tick">
            <MudCheckBox T="bool" Value="Inputs.Copyright.HoldsAttestation.Value" ValueChanged="OnAttestationChanged" Color="Color.Primary"
                         Label="@L["AttestationLabel"]" />
            <OriginChip Origin="Inputs.Copyright.HoldsAttestation.Origin" />
            <InfoBubble Label="@L["AttestationLabel"]">@L["AttestationHint"]</InfoBubble>
        </div>
    </Disclosure>
    <RefusedMessage Error="@Refused" />
    @if (_view is { HasRoyalty: true } shown && _rules is not null)
    {
        var result = shown.Result;
        <FigureList Figures="@FigureWords.Of(L, CopyrightFigures.Royalty(result, _rules))" />
        <p class="copyright__note">@L[CopyrightCardText.Limits(result), Formats.Euros(result.Royalty), Formats.Euros(result.WithinLimits),
                                      Formats.Euros(result.RelativeLimit), Formats.Euros(result.Cap), Formats.Euros(result.TaxedAsPay), Inputs.IncomeYear,
                                      Formats.RuleAmount(_rules.RelativeLimit)]</p>
        @if (_comparison is { } comparison)
        {
            <div class="copyright__comparison">
                @if (comparison.PayHeld is { } pay)
                {
                    <p class="copyright__note">@L["PayHeld", Formats.Euros(pay)]</p>
                }
                <h3 class="copyright__comparison-title">@L["WithTitle"]</h3>
                <FigureList Figures="@FigureWords.Of(L, CopyrightFigures.With(comparison))" />
                <h3 class="copyright__comparison-title">@L["WithoutTitle"]</h3>
                <FigureList Figures="@FigureWords.Of(L, CopyrightFigures.Without(comparison))" />
                <div class="copyright__difference">
                    <FigureList Figures="@FigureWords.Of(L, CopyrightFigures.Difference(comparison))" />
                </div>
            </div>
        }
    }
    else if (Refused is null)
    {
        <p class="copyright__note">@L["NoRoyaltyYet"]</p>
    }
    @if (_view is not null)
    {
        <DrainList Drains="_view.Drains" />
    }
    @if (_rules is not null)
    {
        <ConditionList Name="copyright-conditions" Conditions="_rules.Conditions" />
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's refusal of the royalty's creative share.
    [Parameter]
    public Refusal? Refused { get; set; }

    private CopyrightView? _view;
    private CopyrightComparison? _comparison;
    private CopyrightRules? _rules;
    private CopyrightSettingsView _settings = default!;

    protected override void OnParametersSet()
    {
        _view = Run.Year is { } year ? CopyrightView.From(year) : null;
        _comparison = CopyrightComparison.From(Inputs, Run);
        _rules = CopyrightRules.For(Inputs.IncomeYear);
        _settings = CopyrightSettingsView.From(Inputs, Run);
    }

    private string? Summary => _view is { } view
        ? L[CopyrightCardText.Summary(view), Formats.Euros(view.AfterTax), Formats.Euros(view.Result.TaxedAsPay)].Value
        : null;

    // The summary's first figure, for the card's row in the river's outline.
    private CardGlance? Glance => _view is { } view ? CopyrightCardText.Glance(view) : null;

    // Where no text settles a point, the reading Netto takes, word for word above the sources.
    private RenderFragment? Details => _view is { Details.Count: > 0 }
        ? @<text>
              <p class="copyright__reading">@L["Readings", Formats.Euros(CorporateTaxRules.For(Inputs.IncomeYear)?.MinimumDirectorPay.Value ?? 0m)]</p>
          </text>
        : null;

    private Task OnAverageChanged(bool within) => InputsChanged.InvokeAsync(Inputs.WithAverageWithinCap(within));

    private Task OnAttestationChanged(bool holds) => InputsChanged.InvokeAsync(Inputs.WithAttestation(holds));

    private decimal? CreativeSharePercent => Inputs.Copyright.CreativeShare.Value * 100m;

    private Task OnCreativeSharePercentChanged(decimal? percent) => InputsChanged.InvokeAsync(Inputs.WithCreativeShare(percent / 100m));

    private Task Remove() => InputsChanged.InvokeAsync(Inputs.TakeOutOfPlan(OptionalModule.Copyright));
}
