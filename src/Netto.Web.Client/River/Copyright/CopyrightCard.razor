@using Netto.Core.Copyright
@using Netto.Core.CorporateTax
@using Netto.Core.Rules
@using Netto.Web.Client.River
@inject IStringLocalizer<CopyrightCard> L

@* A copyright royalty the company pays the director for the rights on works they created, which the
   card receives and drains and the split pays beside the pay. The card decides it: first whether it
   follows the pay, what an advance ruling accepts
   at each pay, or is a fixed amount, typed here, with why a royalty that follows the pay is none; a
   refusal of the amount marks its field. Then the user
   says whether their copyright income of the four previous years averaged at most the year's cap, met
   unless they say otherwise, whether they hold an attestation du travail des arts for these works, none
   unless they say so, and the share of their working time spent creating, which a royalty that
   follows the pay and the moves read, none until given; the three sit behind one disclosure, « Your
   copyright situation », folded to a line that states them. Its figures come first, as lines
   (CopyrightFigures): the royalty, the part within the limits and the part beyond them, taxed as pay,
   the flat-rate costs the attestation takes off the first part and what the company withholds on the part
   beyond, which the tax on pay credits; what it withholds on the part within is the tax apart itself, its
   drain line. A sentence says which limit set the part within, and one that no pay keeps the reduced
   corporate rate beside the royalty, or without it, where that is so (RoyaltyRateView, the engine's
   condition: the royalty's, which this card holds); the smallest pays keeping it are Corporate tax's to
   say. Then the plan with the royalty and the same plan without it, each by what reaches the pocket and
   what goes to the taxes on pay and on profit, both at the pay the plan with the royalty runs at, which a
   note names once the pay set is held below (CopyrightComparison.PayHeld), the difference being the
   summary's; then where its money goes: its tax apart, what of the part within reaches the pocket and
   the part beyond going on to Director pay. The summary says what the royalty adds to the pocket, the
   plan with it less the plan without (LeverGain), and that over the royalty the company pays out. Where no text settles a point, the reading Netto takes is in
   its details, above the sources. An optional module: it shows only while in the plan, and the word at
   its bottom takes it out, its values kept. Skipped with the company. *@
<ModuleCard Name="@ModuleFolds.Name(OptionalModule.Copyright)" Title="@L["Title"]" Summary="@Summary" OfThePayout="@LeverGainText.OfThePayout(_gain, _view?.Result.Royalty ?? 0m)" Help="@L["Hint", CopyrightCardText.Rate(L, _rules?.WithholdingRate), CopyrightCardText.Rate(L, _rules?.TaxedApartRate)]" Waiting="Inputs.Company is null"
            Refused="@Refused" Details="@Details" Sources="@(_view?.Details ?? [])" IncomeYear="Inputs.IncomeYear" RemoveLabel="@L["Remove"]" OnRemove="Remove">
    <RiverField Label="@L["PolicyLabel"]" Origin="_policy.FollowsPay.Origin" Help="@L["PolicyHint", CopyrightCardText.Rate(L, _rules?.EnvelopeRate)]">
        <div class="copyright__policies">
            <MudChipSet T="bool" SelectedValue="_policy.FollowsPay.Value" SelectedValueChanged="OnPolicyChanged"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                        Size="Size.Small">
                <MudChip T="bool" Value="true" Text="@L[CopyrightCardText.Policy(true)]" />
                <MudChip T="bool" Value="false" Text="@L[CopyrightCardText.Policy(false)]" />
            </MudChipSet>
        </div>
        @if (_policy.WhyNone is { } none)
        {
            <p class="copyright__note">@L[none, Inputs.IncomeYear]</p>
        }
    </RiverField>
    @if (!_policy.FollowsPay.Value)
    {
        <RiverField Label="@L["FixedRoyaltyLabel"]" For="river-copyright-royalty" Origin="_policy.Fixed.Origin" Help="@L["FixedRoyaltyHint", CopyrightCardText.Rate(L, _rules?.WithholdingRate)]">
            <RiverNumericField T="decimal" InputId="river-copyright-royalty" Value="_policy.Fixed.Value" ValueChanged="OnRoyaltyChanged"
                               Euros="true"
                               Error="@(Refused?.Input == RefusedInput.Royalty)" Refusal="@Refused" />
        </RiverField>
    }
    <Disclosure Title="@L["SituationTitle"]" Values="@SettingWords.Of(L, _settings.Situation)" Refused="@CopyrightSettingsView.SituationHolds(Refused)"
                OpenByDefault="@_settings.NeedsFacts">
        <RiverField Label="@L["CreativeShareLabel"]" For="river-copyright-creative-share"
                    Origin="@(Inputs.Copyright.CreativeShare.Value is null ? null : Inputs.Copyright.CreativeShare.Origin)" Help="@L["CreativeShareHint", CopyrightCardText.Rate(L, _rules?.EnvelopeRate)]">
            <RiverNumericField T="decimal?" InputId="river-copyright-creative-share" Value="CreativeSharePercent" ValueChanged="OnCreativeSharePercentChanged"
                               Format="0.##" Adornment="Adornment.End" AdornmentText="%"
                               Error="@(Refused?.Input == RefusedInput.CreativeShare)" Refusal="@Refused" />
        </RiverField>
        <div class="copyright__tick">
            <MudCheckBox T="bool" Value="Inputs.Copyright.AverageWithinCap.Value" ValueChanged="OnAverageChanged" Color="Color.Primary" UncheckedColor="Color.Default"
                         Label="@L["AverageLabel", Formats.Euros(_rules?.Cap.Value ?? 0m)]" />
            <OriginChip Origin="Inputs.Copyright.AverageWithinCap.Origin" />
            <InfoBubble Label="@L["AverageLabel", Formats.Euros(_rules?.Cap.Value ?? 0m)]">@L["AverageHint"]</InfoBubble>
        </div>
        <div class="copyright__tick">
            <MudCheckBox T="bool" Value="Inputs.Copyright.HoldsAttestation.Value" ValueChanged="OnAttestationChanged" Color="Color.Primary" UncheckedColor="Color.Default"
                         Label="@L["AttestationLabel"]" />
            <OriginChip Origin="Inputs.Copyright.HoldsAttestation.Origin" />
            <InfoBubble Label="@L["AttestationLabel"]">@L["AttestationHint"]</InfoBubble>
        </div>
    </Disclosure>
    <RefusedMessage Error="@Refused" />
    @if (_view is { HasRoyalty: true } shown && _rules is not null)
    {
        var result = shown.Result;
        <FigureList Figures="@FigureWords.Of(L, CopyrightFigures.Royalty(result, _rules))" />
        <p class="copyright__note">@L[CopyrightCardText.Limits(result), Formats.Euros(result.Royalty), Formats.Euros(result.WithinLimits),
                                      Formats.Euros(result.RelativeLimit), Formats.Euros(result.Cap), Formats.Euros(result.TaxedAsPay), Inputs.IncomeYear,
                                      Formats.RuleAmount(_rules.RelativeLimit)]</p>
        @if (_rate is { } rate && CopyrightCardText.RoyaltyRateNote(rate) is { } rateNote)
        {
            <p class="copyright__note"><TermSentence Text="@L[rateNote]" Meaning="@L[ReducedRateText.Term, ReducedRateText.Arguments(Inputs.IncomeYear)]" /></p>
        }
        @if (_comparison is { } comparison)
        {
            <div class="copyright__comparison">
                @if (comparison.PayHeld is { } pay)
                {
                    <p class="copyright__note">@L["PayHeld", Formats.Euros(pay)]</p>
                }
                <h3 class="copyright__comparison-title">@L["WithTitle"]</h3>
                <FigureList Figures="@FigureWords.Of(L, CopyrightFigures.With(comparison))" />
                <h3 class="copyright__comparison-title">@L["WithoutTitle"]</h3>
                <FigureList Figures="@FigureWords.Of(L, CopyrightFigures.Without(comparison))" />
            </div>
        }
    }
    else if (Refused is null)
    {
        <p class="copyright__note">@L["NoRoyaltyYet"]</p>
    }
    @if (_view is not null)
    {
        <DrainList Drains="_view.Drains" />
    }
    @if (_rules is not null)
    {
        <ConditionList Name="copyright-conditions" Conditions="_rules.Conditions" />
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's refusal of the royalty or of its creative share.
    [Parameter]
    public Refusal? Refused { get; set; }

    private CopyrightPolicyView _policy = default!;
    private CopyrightView? _view;
    private CopyrightComparison? _comparison;
    private RoyaltyRateView? _rate;
    private CopyrightRules? _rules;
    private CopyrightSettingsView _settings = default!;
    private readonly KeptLeverGain _kept = new(OptionalModule.Copyright);
    private LeverGain? _gain;

    protected override void OnParametersSet()
    {
        _policy = CopyrightPolicyView.From(Inputs, Run);
        _view = Run.Year is { } year ? CopyrightView.From(year) : null;
        _gain = _kept.For(Inputs, Run);
        _comparison = CopyrightComparison.From(Run, _gain);
        _rate = _view is { HasRoyalty: true } ? RoyaltyRateView.From(Run.Year) : null;
        _rules = CopyrightRules.For(Inputs.IncomeYear);
        _settings = CopyrightSettingsView.From(Inputs, Run);
    }

    private string? Summary => _view is { } view && _gain is { } gain
        ? L[CopyrightCardText.Summary(view, gain.Gain), LeverGainText.Amount(gain.Gain)].Value
        : null;


    // Where no text settles a point, the reading Netto takes, word for word above the sources.
    private RenderFragment? Details => _view is { Details.Count: > 0 }
        ? @<text>
              <p class="copyright__reading">@L["Readings", Formats.Euros(CorporateTaxRules.For(Inputs.IncomeYear)?.MinimumDirectorPay.Value ?? 0m),
                                                CopyrightCardText.Rate(L, _rules?.RelativeLimit), CopyrightCardText.Rate(L, _rules?.WithholdingRate)]</p>
          </text>
        : null;

    // Fixed from following, the royalty stays what it came to at the pay.
    private Task OnPolicyChanged(bool followsPay) =>
        InputsChanged.InvokeAsync(followsPay ? Inputs.WithRoyaltyFollowingPay() : Inputs.WithRoyaltyFixed());

    private Task OnRoyaltyChanged(decimal amount) => InputsChanged.InvokeAsync(Inputs.WithRoyalty(amount));

    private Task OnAverageChanged(bool within) => InputsChanged.InvokeAsync(Inputs.WithAverageWithinCap(within));

    private Task OnAttestationChanged(bool holds) => InputsChanged.InvokeAsync(Inputs.WithAttestation(holds));

    private decimal? CreativeSharePercent => Inputs.Copyright.CreativeShare.Value * 100m;

    private Task OnCreativeSharePercentChanged(decimal? percent) => InputsChanged.InvokeAsync(Inputs.WithCreativeShare(percent / 100m));

    private Task Remove() => InputsChanged.InvokeAsync(Inputs.TakeOutOfPlan(OptionalModule.Copyright));
}
