@using Netto.Core.Rules
@inject IStringLocalizer<CorporateTaxCard> L

@* Corporate tax on the company's profit after pay, at 25% or 20% on its first slice, and the
   surcharge the advance payments leave on it. Its figures come first, as one list: what its taxable
   income adds back to that profit (CorporateTaxFigures), then where the profit goes (DrainList).
   The user declares what Netto cannot see, the company's financial year among it; the engine tests
   the minimum pay, set on the split, and a sentence after the lines says which condition decided
   the rate, with the minimum pay and the share of it the benefits may reach, which no line shows,
   the benefits only when they are what gives up the rate, and the pay it tested, a term whose bubble
   says what that pay holds and, beside a royalty taxed as pay, what of Director pay's taxable pay it
   leaves out. With no taxable profit, it says so, naming the dividend earlier profits still pay. What the user rarely changes sits
   behind two disclosures after it, each folded to a line that states it: the company, and its
   advance payments with the surcharge they leave. The payments are taken while typing, like
   revenue, since nothing bounds them; the card says why a surcharge is due or why none is, never what
   to pay to cancel it (Optimise's advance-payment move and My plan by date). *@
<ModuleCard Name="corporate-tax" Title="@L["Title"]" Summary="@Summary" PassesOn="@_view?.PassesOn" Waiting="Inputs.Company is null" Refused="@Refused"
            Sources="@(_view?.Details ?? [])" IncomeYear="Inputs.IncomeYear" DetailsLabel="@L["DetailsLabel"]" SourcesTitle="@L["SourcesTitle", Inputs.IncomeYear]">
    <RefusedMessage Error="@Refused" />
    @if (_view is not null)
    {
        <div class="corporate-tax__lines">
            <FigureList Figures="@FigureWords.Of(L, CorporateTaxFigures.Of(_view))" />
            <DrainList Drains="_view.Drains" />
        </div>
        <p class="corporate-tax__condition"><TermSentence Text="@ConditionText(_view)" Meaning="@L[_testedPayTerm.Key, Formats.Euros(_testedPayTerm.LeftOut)]" /></p>
    }
    <Disclosure Title="@L["CompanyTitle"]" Values="@SettingWords.Of(L, _settings.Company)">
        <div class="corporate-tax__status">
            <span class="corporate-tax__choice">
                <MudCheckBox T="bool" Value="Inputs.SmallCompany.Value" ValueChanged="OnSmallCompanyChanged" Color="Color.Primary" UncheckedColor="Color.Default"
                             Label="@L["SmallCompanyLabel"]" />
                <InfoBubble Label="@L["SmallCompanyLabel"]">@L["SmallCompanyHint"]</InfoBubble>
            </span>
            <OriginChip Origin="Inputs.SmallCompany.Origin" />
        </div>
        <RiverField Label="@L["FinancialYearLabel", Inputs.IncomeYear]" Origin="Inputs.FinancialYear.Origin" Help="@L["FinancialYearHint"]">
            <div class="corporate-tax__years">
                <MudChipSet T="FinancialYear" SelectedValue="Inputs.FinancialYear.Value" SelectedValueChanged="OnFinancialYearChanged"
                            SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                            Size="Size.Small" Disabled="!Inputs.SmallCompany.Value">
                    @foreach (var year in Enum.GetValues<FinancialYear>())
                    {
                        <MudChip T="FinancialYear" Value="year" Text="@L[CorporateTaxCardText.FinancialYear(year)]" />
                    }
                </MudChipSet>
            </div>
        </RiverField>
    </Disclosure>
    <Disclosure Title="@L["PaymentsTitle"]" Values="@SettingWords.Of(L, _settings.Payments)" Refused="@CorporateTaxSettingsView.PaymentsHold(Refused)"
                Help="@L["PaymentsHint"]">
        <div class="corporate-tax__deadlines">
            @foreach (var field in AdvancePaymentFields.From(Inputs))
            {
                <RiverField Label="@L["PaymentLabel", Formats.Day(field.Date)]" For="@($"river-advance-payment-{field.Deadline}")" Origin="field.Paid.Origin">
                    <RiverNumericField T="decimal" InputId="@($"river-advance-payment-{field.Deadline}")" Value="field.Paid.Value"
                                       ValueChanged="@(amount => OnAdvancePaymentChanged(field.Deadline, amount))"
                                       Euros="true"
                                       Error="@(Refused?.Input == RefusedInput.CompanyAdvancePayments && field.Paid.Value < 0m)" Refusal="@Refused" />
                </RiverField>
            }
        </div>
        @if (_view is not null)
        {
            <p class="corporate-tax__condition">
                @L[CorporateTaxCardText.Surcharge(_view.Surcharge)]
            </p>
        }
    </Disclosure>
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's refusal of an advance payment.
    [Parameter]
    public Refusal? Refused { get; set; }

    private CorporateTaxView? _view;
    private decimal _dividend;
    private (string Key, decimal LeftOut) _testedPayTerm;
    private CorporateTaxSettingsView _settings = default!;

    protected override void OnParametersSet()
    {
        _view = Run.Year is { } year ? CorporateTaxView.From(year) : null;
        _dividend = Run.Year?.Dividend.Dividend ?? 0m;
        _testedPayTerm = Run.Year is { } ran ? CorporateTaxCardText.TestedPayTerm(ran.DirectorPay) : default;
        _settings = CorporateTaxSettingsView.From(Inputs, Run);
    }

    // The profit the split leaves the company, before its tax, and what the tax and its surcharge
    // leave of it for the dividend.
    private string? Summary => Run.Year is { } year
        ? L["Summary", Formats.Euros(year.ProfitAfterPay), Formats.Euros(year.ProfitAfterTax)].Value
        : null;


    // Which condition decided the rate, against the minimum pay, the benefits' share of the pay and the pay
    // tested; or, with no taxable profit, the dividend the earlier profits still pay.
    private string ConditionText(CorporateTaxView view) => view.NoTaxableProfit
        ? L[CorporateTaxCardText.NoTaxableProfit(_dividend), Formats.Euros(_dividend)].Value
        : L[CorporateTaxCardText.Condition(view.Condition, view.FlatRateBenefits > 0m), Formats.Euros(view.MinimumDirectorPay), Formats.Euros(view.FlatRateBenefits),
            Formats.WholeShare(view.ExcessBenefitsShare), Formats.Euros(view.DirectorPay)].Value;

    private Task OnSmallCompanyChanged(bool smallCompany) => InputsChanged.InvokeAsync(Inputs.WithSmallCompany(smallCompany));

    private Task OnFinancialYearChanged(FinancialYear year) => InputsChanged.InvokeAsync(Inputs.WithFinancialYear(year));

    private Task OnAdvancePaymentChanged(int deadline, decimal amount) => InputsChanged.InvokeAsync(Inputs.WithAdvancePayment(deadline, amount));
}
