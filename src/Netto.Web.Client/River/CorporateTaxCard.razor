@using Netto.Core.Simulation
@using Netto.Web.Client.Steps
@inject IStringLocalizer<CorporateTaxCard> L

@* Corporate tax on the company's profit after pay, with what it cannot deduct of the vouchers added
   back, at 25% or 20% on its first slice, and the surcharge the advance payments leave on it. The
   user declares what Netto cannot see, the company's financial year among it; the engine tests the
   minimum pay, set on the split, and the card says which condition decided the rate. The payments
   are taken while typing, like revenue, since nothing bounds them, and the card says what more by
   the last deadline cancels the surcharge. *@
<ModuleCard Title="@L["Title"]" Summary="@Summary" Skipped="Inputs.Company is null" Details="@Details" DetailsLabel="@L["DetailsLabel"]">
    @if (Inputs.Company is null)
    {
        <p class="corporate-tax__waiting">@L["Waiting"]</p>
    }
    else
    {
        <div class="corporate-tax__statuses">
            <div class="corporate-tax__status">
                <MudCheckBox T="bool" Value="Inputs.SmallCompany.Value" ValueChanged="OnSmallCompanyChanged" Color="Color.Primary"
                             Label="@L["SmallCompanyLabel"]" />
                <OriginChip Origin="Inputs.SmallCompany.Origin" />
            </div>
            <p class="corporate-tax__hint">@L["SmallCompanyHint"]</p>
        </div>
        <RiverField Label="@L["FinancialYearLabel", Inputs.IncomeYear]" Origin="Inputs.FinancialYear.Origin">
            <div class="corporate-tax__years">
                <MudChipSet T="FinancialYear" SelectedValue="Inputs.FinancialYear.Value" SelectedValueChanged="OnFinancialYearChanged"
                            SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                            Size="Size.Small" Disabled="!Inputs.SmallCompany.Value">
                    @foreach (var year in Enum.GetValues<FinancialYear>())
                    {
                        <MudChip T="FinancialYear" Value="year" Text="@L[CorporateTaxCardText.FinancialYear(year)]" />
                    }
                </MudChipSet>
            </div>
            <p class="corporate-tax__note">@L["FinancialYearHint"]</p>
        </RiverField>
        @if (_view is { DisallowedExpenses: > 0m } addedBack)
        {
            <p class="corporate-tax__condition">@L["Disallowed", Formats.Euros(addedBack.TaxableIncome), Formats.Euros(addedBack.DisallowedExpenses)]</p>
        }
        @if (_view is not null)
        {
            <p class="corporate-tax__condition">
                @(_view.NoTaxableProfit
                    ? L["NoTaxableProfit"]
                    : L[CorporateTaxCardText.Condition(_view.Condition), Formats.Euros(_view.MinimumDirectorPay)])
            </p>
        }
        <div class="corporate-tax__payments">
            <h3 class="corporate-tax__payments-title">@L["PaymentsTitle"]</h3>
            <p class="corporate-tax__note">@L["PaymentsHint"]</p>
            <div class="corporate-tax__deadlines">
                @foreach (var field in AdvancePaymentFields.From(Inputs))
                {
                    <RiverField Label="@L["PaymentLabel", Formats.Day(field.Date)]" For="@($"river-advance-payment-{field.Deadline}")" Origin="field.Paid.Origin">
                        <MudNumericField T="decimal" InputId="@($"river-advance-payment-{field.Deadline}")" Value="field.Paid.Value"
                                         ValueChanged="@(amount => OnAdvancePaymentChanged(field.Deadline, amount))"
                                         Format="N2" Culture="Formats.Culture" Adornment="Adornment.Start" AdornmentText="€" HideSpinButtons="true"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="400"
                                         Error="@(Refused == YearSimulation.AdvancePaymentNegative && field.Paid.Value < 0m)" />
                    </RiverField>
                }
            </div>
            @if (_view is not null)
            {
                <p class="corporate-tax__condition">
                    @L[CorporateTaxCardText.Surcharge(_view.Surcharge), Formats.Euros(_view.SurchargeAmount), Formats.Euros(_view.TopUp), Formats.Day(_view.LastDeadline)]
                </p>
            }
            <RefusedMessage Error="@Refused" />
        </div>
        @if (_view is not null)
        {
            <DrainList Drains="_view.Drains" />
        }
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's error key when it refuses an advance payment.
    [Parameter]
    public string? Refused { get; set; }

    private CorporateTaxView? _view;

    protected override void OnParametersSet() => _view = Run.Year is { } year ? CorporateTaxView.From(year) : null;

    private string? Summary => Run.Year is { } year
        ? L["Summary", Formats.Euros(year.ProfitAfterPay), Formats.Euros(year.ProfitAfterTax)].Value
        : null;

    private RenderFragment? Details => _view is { } view && Run.Year is { } year
        ? @<text>
              <h3 class="corporate-tax__sources">@L["SourcesTitle", year.Scenario.IncomeYear]</h3>
              <StepDetails Details="view.Details" />
          </text>
        : null;

    private Task OnSmallCompanyChanged(bool smallCompany) => InputsChanged.InvokeAsync(Inputs.WithSmallCompany(smallCompany));

    private Task OnFinancialYearChanged(FinancialYear year) => InputsChanged.InvokeAsync(Inputs.WithFinancialYear(year));

    private Task OnAdvancePaymentChanged(int deadline, decimal amount) => InputsChanged.InvokeAsync(Inputs.WithAdvancePayment(deadline, amount));
}
