@using Netto.Core.Rules
@using Netto.Core.SocialContributions
@using Netto.Web.Client.Steps
@inject IStringLocalizer<CompanyYearCard> L

@* Where the river starts: the company's revenue and running costs for the year, excluding VAT, then
   what it owes INASTI that year whatever it pays its director, its one figure line (CompanyYearFigures),
   which leave what it earns before it pays its director anything; the vouchers, the expense allowances
   and the rent in the plan come off it next, then the pay. The running costs' bubble says the
   contribution is not among them. Which of the contribution's two bands the company's balance sheet
   puts it in sits behind a disclosure folded to the line that states it, with what the law exempts
   from it as conditions the user confirms, and its source in the details. Its bubble says the river
   starts on an example year, which the user replaces or clears. Cleared, the module is skipped and the
   river starts at the pay. No Min or Max on the amounts: MudBlazor would clamp a value silently, and the
   engine's refusal, with its message, is what the user has to see. *@
<ModuleCard Name="company-year" Title="@L["Title"]" Summary="@Summary" Glance="@Glance" Help="@L["Hint"]" Skipped="Inputs.Company is null" Refused="@Refused"
            Sources="@_sources" IncomeYear="Inputs.IncomeYear">
    @if (Inputs.Company is { } company)
    {
        <div class="company-year__fields">
            <RiverField Label="@L["RevenueLabel"]" For="river-revenue" Origin="company.Revenue.Origin">
                <RiverNumericField T="decimal" InputId="river-revenue" Value="company.Revenue.Value" ValueChanged="OnRevenueChanged"
                                   Euros="true"
                                   Error="@(Refused?.Input == RefusedInput.Revenue)" Refusal="@Refused" />
            </RiverField>
            <RiverField Label="@L["RunningCostsLabel"]" For="river-running-costs" Origin="company.RunningCosts.Origin" Help="@L["RunningCostsHint"]">
                <RiverNumericField T="decimal" InputId="river-running-costs" Value="company.RunningCosts.Value" ValueChanged="OnRunningCostsChanged"
                                   Euros="true"
                                   Error="@(Refused?.Input == RefusedInput.RunningCosts)" Refusal="@Refused" />
            </RiverField>
        </div>
        <RefusedMessage Error="@Refused" />
        @if (_figures.Count > 0)
        {
            <FigureList Figures="@FigureWords.Of(L, _figures)" />
        }
        @if (_rules is { } rules)
        {
            <Disclosure Title="@L["BalanceSheetTitle"]" Values="@SettingWords.Of(L, _settings.BalanceSheet)" Help="@L["BalanceSheetHint", Inputs.IncomeYear]">
                <RiverField Label="@L["BalanceSheetLabel", CompanyYearSettingsView.Year(rules)]" Origin="Inputs.CompanyContributionBand.Origin">
                    <div class="company-year__bands">
                        <MudChipSet T="CompanyContributionBand" SelectedValue="Inputs.CompanyContributionBand.Value" SelectedValueChanged="OnBandChanged"
                                    SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Outlined" SelectedColor="Color.Primary"
                                    Size="Size.Small">
                            @foreach (var band in Enum.GetValues<CompanyContributionBand>())
                            {
                                <MudChip T="CompanyContributionBand" Value="band" Text="@L[CompanyYearCardText.Band(band), Formats.RuleAmount(rules.BalanceSheetThreshold)]" />
                            }
                        </MudChipSet>
                    </div>
                </RiverField>
            </Disclosure>
            <ConditionList Name="company-year-conditions" Conditions="rules.Conditions" />
        }
        <div class="company-year__actions">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SkipCompany">@L["Clear"]</MudButton>
        </div>
    }
    else
    {
        <p class="company-year__skipped">@L["Skipped"]</p>
        <div class="company-year__actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="EnterCompany">@L["Enter"]</MudButton>
        </div>
    }
</ModuleCard>

@code {
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    [Parameter, EditorRequired]
    public RiverRun Run { get; set; } = default!;

    // The engine's refusal of a field of this card.
    [Parameter]
    public Refusal? Refused { get; set; }

    private IReadOnlyList<FigureLine> _figures = [];
    private IReadOnlyList<StepDetail> _sources = [];
    private CompanyYearSettingsView _settings = default!;
    private CompanyContributionRules? _rules;

    protected override void OnParametersSet()
    {
        _figures = Run.Year is { } year ? CompanyYearFigures.Of(year) : [];
        _sources = Run.Year is { } ran ? CompanyYearFigures.Sources(ran) : [];
        _settings = CompanyYearSettingsView.From(Inputs);
        _rules = CompanyContributionRules.For(Inputs.IncomeYear);
    }

    // What the company takes in, and what it earns once its running costs and INASTI's contribution
    // are paid, before it pays its director anything.
    private string? Summary => Run.Year is { } year
        ? L["Summary", Formats.Euros(year.Scenario.Revenue), Formats.Euros(year.ProfitBeforeLevers)].Value
        : null;

    // Where the river starts, for the card's row in the river's outline.
    private CardGlance? Glance => Run.Year is { } year ? new(GlanceKind.In, Formats.Euros(year.Scenario.Revenue)) : null;

    private Task OnRevenueChanged(decimal revenue) => InputsChanged.InvokeAsync(Inputs.WithRevenue(revenue));

    private Task OnRunningCostsChanged(decimal runningCosts) => InputsChanged.InvokeAsync(Inputs.WithRunningCosts(runningCosts));

    private Task OnBandChanged(CompanyContributionBand band) => InputsChanged.InvokeAsync(Inputs.WithCompanyContributionBand(band));

    private Task SkipCompany() => InputsChanged.InvokeAsync(Inputs.SkipCompany());

    private Task EnterCompany() => InputsChanged.InvokeAsync(Inputs.EnterCompany());
}
