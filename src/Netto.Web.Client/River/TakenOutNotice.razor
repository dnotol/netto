@inject IStringLocalizer<TakenOutNotice> L

@* Says a module was just taken out of the plan, from its card or « Add to plan », with Undo to put
   it back. The live region is always in the page, empty while there is nothing to say, so a screen
   reader announces the notice as it appears. It stays until undone, dismissed, or the module is back
   in the plan (RemovalNotice). *@
<div class="taken-out" role="status">
    @if (Module is { } module)
    {
        <div class="taken-out__notice">
            <span class="taken-out__text">@L[TakenOutNoticeText.TakenOut(module)]</span>
            <MudButton @ref="_undo" Variant="Variant.Filled" Size="Size.Small" Class="taken-out__undo" OnClick="OnUndo">@L["Undo"]</MudButton>
            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" Class="taken-out__dismiss" OnClick="OnDismiss" aria-label="@L["Dismiss"]" />
        </div>
    }
</div>

@code {
    // The module taken out, or null for no notice.
    [Parameter]
    public OptionalModule? Module { get; set; }

    [Parameter]
    public EventCallback OnUndo { get; set; }

    [Parameter]
    public EventCallback OnDismiss { get; set; }

    private MudButton? _undo;

    public async Task FocusUndoAsync()
    {
        if (_undo is not null)
            await _undo.FocusAsync();
    }
}
