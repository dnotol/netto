@using Netto.Core.Simulation
@inject IStringLocalizer<MovesCard> L

@* What Netto would change in the plan starred « Today », the user's current setup, to leave more in
   the pocket: the engine's moves (MoveSearch, through MovesView), each adding what it says on top of
   the ones above it, and their total. « Apply » sets the river's values to the move's; Today stays as
   it was saved. The moves are found once per Today, the search running the split at every move; which
   ones the river holds is read at each change. Without a Today, or while Netto cannot run it, the
   card says why. *@
<ModuleCard Name="moves" Title="@L["Title"]" Summary="@Summary" Help="@L["Help"]">
    <p class="moves__state">@L[MovesCardText.State(_view.State)]</p>
    @if (_view.State == MovesState.Moves)
    {
        <ol class="moves__list">
            @foreach (var (move, index) in _view.Moves.Select((move, index) => (move, index)))
            {
                <li class="moves__move">
                    <span class="moves__what">@What(move)</span>
                    <span class="moves__gain">@L["Gain", Formats.Euros(move.Gain)]</span>
                    @if (_view.Applied(move, Inputs))
                    {
                        <span class="moves__applied" tabindex="-1" @ref="_applied[index]">@L["Applied"]</span>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="moves__apply" OnClick="@(() => Apply(move, index))"
                                   aria-label="@L["ApplyLabel", What(move)]">@L["Apply"]</MudButton>
                    }
                </li>
            }
        </ol>
        <p class="moves__total">@L["Total", Formats.Euros(_view.Total)]</p>
    }
</ModuleCard>

@code {
    // The plan starred « Today », or null while none is.
    [Parameter]
    public RiverInputs? Today { get; set; }

    // Today's date, which decides the deadline a payment is proposed by.
    [Parameter]
    public DateOnly Date { get; set; }

    // The river as it is, to tell the moves it holds.
    [Parameter, EditorRequired]
    public RiverInputs Inputs { get; set; } = default!;

    // The river with a move applied.
    [Parameter]
    public EventCallback<RiverInputs> InputsChanged { get; set; }

    private MovesView _view = MovesView.Of(null, default);
    private readonly Dictionary<int, ElementReference> _applied = [];
    private int? _focusApplied;
    private RiverInputs? _foundFor;
    private DateOnly _foundOn;
    private bool _found;

    protected override void OnParametersSet()
    {
        if (_found && Today == _foundFor && Date == _foundOn)
            return;

        _view = MovesView.Of(Today, Date);
        _foundFor = Today;
        _foundOn = Date;
        _found = true;
    }

    private string? Summary => _view.State == MovesState.Moves ? L["Summary", Formats.Euros(_view.Total)].Value : null;

    private string What(PlannedMove move) => move.Move switch
    {
        PayMove pay => L[MovesCardText.Move(pay), Formats.Euros(pay.Pay), Formats.Euros(_view.TodayPay)],
        CompanyAdvancePaymentMove payment => L[MovesCardText.Move(payment), Formats.Euros(payment.Amount), Formats.Day(payment.Date)],
        DirectorAdvancePaymentMove payment => L[MovesCardText.Move(payment), Formats.Euros(payment.Amount), Formats.Day(payment.Date)],
        EcoVouchersMove eco => L[MovesCardText.Move(eco), Formats.Euros(eco.Amount)],
        SportCultureVouchersMove sport => L[MovesCardText.Move(sport), Formats.Euros(sport.Amount)],
        RentMove rent => L[MovesCardText.Move(rent), Formats.Euros(rent.Rent)],
        _ => "",
    };

    // Apply goes with the move applied, so the focus goes to what replaces it, « In the river ».
    private async Task Apply(PlannedMove move, int index)
    {
        _focusApplied = index;
        await InputsChanged.InvokeAsync(_view.Apply(move, Inputs));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusApplied is { } index && _applied.TryGetValue(index, out var applied))
        {
            _focusApplied = null;
            await applied.FocusAsync();
        }
    }
}
