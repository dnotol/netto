@inject Folds Folds

@* One fold of the river, the same everywhere: a module card, the conditions of a lever, a card's
   detail view with the pay slip and the sources. The whole header row is a button inside the heading, so a screen reader announces a heading
   holding a button, expanded or collapsed. The button shows the title and the summary whether
   folded or not, and a chevron at its right, down when folded and up when open. Level 2 is a card's
   own heading; level 3 a fold inside a card, drawn as one quiet line. What is folded is not
   rendered, but its frame stays in the page, hidden, for aria-controls to point to. The fold is the
   viewer's preference, remembered in the browser under its name (Folds). It starts folded, to its
   title and its summary, until the viewer opens it. A refusal inside (Refused) is never hidden: the
   fold opens, as Disclosure does, and its button cannot fold it while the refusal stands; once the
   amount is accepted it stays open, for the field not to vanish under the cursor, until the viewer
   folds it. It has no text of its own: the card gives its title and its summary, and what its module
   is (Help), in an info bubble at the row's end, outside the heading and its button, inside which no
   other control may sit. A pinned fold (Pinned), the card of the module chosen on the map, is always
   open and is no button: its title and summary are the heading's plain text, the heading takes the focus
   when the page asks (FocusAsync), and it neither reads nor writes the viewer's fold, nor reveals one. *@
@if (Level == 3)
{
    <h3 class="fold__heading fold__heading--line">@Toggle</h3>
}
else if (Help is null)
{
    <h2 class="fold__heading fold__heading--card" tabindex="@HeadingTabIndex" @ref="_heading">@Toggle</h2>
}
else
{
    <div class="fold__head">
        <h2 class="fold__heading fold__heading--card" tabindex="@HeadingTabIndex" @ref="_heading">@Toggle</h2>
        <InfoBubble Label="@Title">@Help</InfoBubble>
    </div>
}
<div id="@_bodyId" class="fold__body" hidden="@(!Open)">
    @if (Open)
    {
        @ChildContent
    }
</div>

@code {
    // Where the fold is remembered: one per fold of the page, and kept from one version to the next,
    // or a viewer's folds are forgotten.
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    // The title's id, for a section the fold heads to be named by its title alone.
    [Parameter]
    public string? TitleId { get; set; }

    // What flows in and out, in a few words beside the title, folded or not.
    [Parameter]
    public string? Summary { get; set; }

    // One share at the summary's end, saying what it measures: « 59% to you ».
    [Parameter]
    public string? Rate { get; set; }

    // 2 for a card's own heading, 3 for a fold inside a card.
    [Parameter]
    public int Level { get; set; } = 2;

    // What a card's module is, in a bubble at the end of its heading's row; none for a fold inside a card.
    [Parameter]
    public string? Help { get; set; }

    // The engine refuses a field inside: the fold opens now, and its button cannot fold it until the
    // refusal ends.
    [Parameter]
    public bool Refused { get; set; }

    // Always open and no button, the viewer's folds left alone: the card of the module chosen on My plan's map, beside it
    // (PinnedCard).
    [Parameter]
    public bool Pinned { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private readonly string _bodyId = $"fold-{Guid.NewGuid():N}";
    private ElementReference _heading;

    // Folded until the viewer opens it: a card shows its title and its summary, and what a card holds
    // besides its figures, such as its conditions, opens on demand.
    private bool Open => Pinned || Folds.IsOpen(Name, openByDefault: false);

    // A pinned heading is no tab stop and takes the focus when the page puts it there.
    private string? HeadingTabIndex => Pinned ? "-1" : null;

    // A refusal reveals the fold, so it stays open once the amount is accepted. A pinned fold is open
    // anyway, and revealing it would open the same card in the river.
    protected override void OnParametersSet()
    {
        if (Refused && !Pinned)
            Folds.Reveal(Name);
    }

    // Puts the focus on the heading of a pinned fold, scrolling it into view where the page needs it.
    public ValueTask FocusAsync() => _heading.FocusAsync();

    // The button is disabled while the fold is refused, so it is never pressed then.
    private void Flip() => Folds.Set(Name, !Open);

    private RenderFragment Words =>
        @<text><span id="@TitleId" class="fold__title">@Title</span>
            @if (Summary is not null)
            {
                @* Razor drops the whitespace between elements: without this space, a screen reader
                   reads the title run into the summary. A flex row does not draw it. *@
                @(" ")
                <span class="fold__summary">
                    @Summary
                    @if (Rate is not null)
                    {
                        @(" ")<span class="fold__rate">@Rate</span>
                    }
                </span>
            }
        </text>;

    private RenderFragment Toggle => Pinned
        ? @<div class="fold__toggle fold__toggle--pinned">@Words</div>
        : @<button type="button" class="fold__toggle" aria-expanded="@(Open ? "true" : "false")" aria-controls="@_bodyId" disabled="@Refused" @onclick="Flip">@Words<MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Class="@(Open ? "fold__chevron fold__chevron--open" : "fold__chevron")" aria-hidden="true" /></button>;
}
