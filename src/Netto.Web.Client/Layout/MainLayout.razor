@inherits LayoutComponentBase
@inject IStringLocalizer<MainLayout> L
@inject NavigationManager Navigation
@inject ThemePreference ThemePreference

@* The theme is the viewer's (ThemePreference): MudBlazor must not follow the system on its own, or it
   would undo a pick; the system's changes come through WatchSystemDarkModeAsync instead. *@
<MudThemeProvider @ref="_themeProvider" Theme="NettoTheme.Theme" IsDarkMode="ThemePreference.IsDark" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />

@* .netto-app is also the signal app.css uses to hide the boot splash. *@
<div class="netto-app">
    @* The page's skip link, if it has one, the keyboard's first stop, before the site header. *@
    <SectionOutlet SectionName="@SkipLinkSection" />
    <header class="site-header">
        <MudContainer MaxWidth="MaxWidth.Large" Class="site-header__inner">
            <a href="/" class="wordmark site-header__wordmark">Netto</a>
            <div class="site-header__end">
                @* The section links exist only on the front page, where they are same-page links Blazor
                   scrolls to. Arriving from another page, Blazor resets the scroll to the top once the
                   new page has rendered (blazor.web.js), undoing any scroll towards the section. *@
                @if (OnFrontPage)
                {
                    <nav class="site-nav" aria-label="@L["NavLabel"]">
                        <a href="/#levers">@L["NavLevers"]</a>
                        <a href="/#how-it-works">@L["NavHowItWorks"]</a>
                        <a href="/#principles">@L["NavPrinciples"]</a>
                    </nav>
                }
                <MudButton Href="/plan" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                    @L["NavStart"]
                </MudButton>
                @* Named by what it does, so its name changes with the theme rather than a pressed state. *@
                <MudIconButton Icon="@(ThemePreference.IsDark ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                               Size="Size.Small" Class="site-header__theme" OnClick="ThemePreference.Switch"
                               aria-label="@L[ThemePreference.IsDark ? "ThemeToLight" : "ThemeToDark"]" />
            </div>
        </MudContainer>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <MudContainer MaxWidth="MaxWidth.Large" Class="site-footer__inner">
            <span class="wordmark site-footer__wordmark">Netto</span>
            <p class="site-footer__note">@L["FooterDisclaimer"]</p>
        </MudContainer>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["ErrorUnhandled"]
    <a href="." class="reload">@L["ErrorReload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Where a page puts its skip link (SectionContent).
    public const string SkipLinkSection = "skip-link";

    private bool OnFrontPage => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Length == 0;

    private MudThemeProvider _themeProvider = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _themeProvider.WatchSystemDarkModeAsync(SystemChangedAsync);
    }

    // Followed only while the viewer has picked no theme (ThemePreference).
    private Task SystemChangedAsync(bool systemIsDark) => InvokeAsync(() =>
    {
        ThemePreference.SystemChanged(prefersLight: !systemIsDark);
        StateHasChanged();
    });
}
